---
import TrustBadge from "@/components/site/TrustBadge.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import Pic from "@/components/site/Pic.astro";
import {
  type DirectoryBusiness,
  blendedRating,
  totalReviewCount,
  ratingSourcesLabel,
  isSponsoredPlacement,
  isDemo,
  additionalLicenses,
} from "@/lib/businesses";
import { getCategory } from "@/lib/taxonomy";

interface Props {
  business: DirectoryBusiness;
  /** Rendered inside the labeled featured block (adds the Featured tag). */
  inFeaturedBlock?: boolean;
  /** Town context for the "Serves" line. */
  townName?: string;
  /** Prefix the subtitle with the primary category (used off listing pages). */
  showCategory?: boolean;
  /** Suppress the photo strip (compact contexts like the home showcase tile). */
  noPhoto?: boolean;
}
const { business: b, inFeaturedBlock = false, townName, showCategory = false, noPhoto = false } = Astro.props;

const rating = blendedRating(b);
const reviews = totalReviewCount(b);
const sourcesLabel = ratingSourcesLabel(b);
const isClient = b.isClient === true || b.isClient === "true";
const sponsored = isSponsoredPlacement(b);
const rel = sponsored ? "sponsored" : undefined;
const serviceTowns = (b.serviceTownSlugs ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const categoryName = b.primaryCategorySlug ? getCategory(b.primaryCategorySlug)?.name : undefined;
const extraLicenses = additionalLicenses(b);
const verifiedDate = b.licenseVerifiedAt
  ? new Date(b.licenseVerifiedAt).toLocaleDateString("en-US", { month: "short", year: "numeric" })
  : null;

let photos: string[] = [];
try {
  const parsed = b.photosJson
    ? typeof b.photosJson === "string"
      ? JSON.parse(b.photosJson)
      : b.photosJson
    : [];
  if (Array.isArray(parsed)) photos = parsed.filter((p) => typeof p === "string" && p.startsWith("http"));
} catch { /* no photos */ }
const carouselId = `card-photos-${b.slug}`;
const topRated = rating !== null && rating >= 4.8 && reviews >= 25;
---

<article
  class="card-hover overflow-hidden rounded-card border border-line bg-surface"
  data-biz-card={b.slug}
  data-lat={b.lat ?? ""}
  data-lng={b.lng ?? ""}
  data-rating={rating ?? ""}
  data-reviews={reviews}
  data-license={b.licenseStatus ?? ""}
  data-responds={b.responseTimeHours ?? ""}
  data-insured={b.insuredStatus ?? ""}
  data-services={b.services ?? ""}
  data-featured={inFeaturedBlock ? "1" : ""}
>
  {!noPhoto && (
    <div class="relative aspect-[4/3] w-full overflow-hidden bg-inset" transition:name={`biz-photo-${b.slug}`}>
      {photos.length > 1 ? (
        <>
          <div
            id={carouselId}
            class="flex h-full snap-x snap-mandatory overflow-x-auto scroll-smooth"
            aria-label={`Photos of ${b.name}`}
          >
            {photos.slice(0, 5).map((p, i) => (
              <div id={`${carouselId}-${i}`} class="h-full w-full flex-none snap-center">
                <Pic src={p} alt={i === 0 ? `${b.name} — photo` : ""} aspect={4 / 3} sizes="(min-width: 1024px) 40vw, 100vw" />
              </div>
            ))}
          </div>
          <div class="absolute bottom-2 left-1/2 flex -translate-x-1/2 gap-1.5">
            {photos.slice(0, 5).map((_, i) => (
              <a
                href={`#${carouselId}-${i}`}
                aria-label={`Photo ${i + 1} of ${b.name}`}
                class="h-2 w-2 rounded-chip border border-surface bg-surface/70 hover:bg-surface"
              />
            ))}
          </div>
        </>
      ) : photos.length === 1 ? (
        <Pic src={photos[0]} alt={`${b.name} — photo`} aspect={4 / 3} sizes="(min-width: 1024px) 40vw, 100vw" />
      ) : (
        <CategoryTile slug={b.primaryCategorySlug ?? ""} asFallback />
      )}
      <div class="absolute left-2 top-2 flex flex-wrap gap-1.5">
        {b.licenseStatus === "verified" && (
          <span class="rounded-chip bg-ok px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">Verified</span>
        )}
        {inFeaturedBlock && (
          <span class="rounded-chip bg-brand px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">Featured</span>
        )}
        {topRated && (
          <span class="rounded-chip bg-brand-deep px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">Top rated</span>
        )}
      </div>
    </div>
  )}

  <div class="p-5">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="font-display text-lg font-semibold text-ink">
            <a href={`/business/${b.slug}`} rel={rel} class="hover:text-brand">{b.name}</a>
          </h3>
          {noPhoto && inFeaturedBlock && (
            <span class="rounded-chip bg-brand-wash px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-brand">
              Featured
            </span>
          )}
          {isClient ? (
            <span class="rounded-chip bg-inset px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-faint" title="This business is a client of the agency that operates this directory. Disclosed placements receive no ranking benefit.">
              Sponsored · client of the agency
            </span>
          ) : sponsored && !inFeaturedBlock ? (
            <span class="rounded-chip bg-inset px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-faint">
              Sponsored
            </span>
          ) : null}
          {isDemo(b) && (
            <span class="rounded-chip bg-warn-wash px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-warn">
              Sample
            </span>
          )}
        </div>
        <p class="mt-0.5 text-sm text-muted">
          {showCategory && categoryName && `${categoryName} · `}{b.city}, {b.state}
          {b.yearsInBusiness ? ` · ${b.yearsInBusiness} yrs in business` : ""}
        </p>
      </div>
      <TrustBadge
        licenseStatus={b.licenseStatus}
        licenseSource={b.licenseSource}
        licenseVerifiedAt={b.licenseVerifiedAt}
        size="sm"
      />
    </div>

    {rating !== null ? (
      <p class="mt-2 text-sm text-ink">
        <span class="font-semibold">{rating}★</span>
        <span class="text-muted"> · {reviews} reviews across {sourcesLabel}</span>
      </p>
    ) : (
      <p class="mt-2 text-sm text-faint">Not enough review data yet</p>
    )}

    {b.whyWePicked && (
      <p class="mt-2 text-sm leading-relaxed text-muted">
        <span class="font-medium text-ink">Why we picked them:</span> {b.whyWePicked}
      </p>
    )}

    <div class="ledger mt-3 rounded-[10px] bg-inset px-3 py-1.5">
      <div class="ledger-row">
        <span class="ledger-key">License</span>
        <span class="ledger-val">
          {b.licenseStatus === "verified"
            ? [
                b.licenseNumber,
                ...extraLicenses.map((l) => `${l.number}${l.label ? ` (${l.label})` : ""}`),
              ].filter(Boolean).join(" + ") +
              ` · ${b.licenseSource}${verifiedDate ? ` · checked ${verifiedDate}` : ""}`
            : b.licenseStatus === "not-required"
              ? "Not required for this category"
              : "Not verified — ask before you hire"}
        </span>
      </div>
      <div class="ledger-row">
        <span class="ledger-key">Trust</span>
        <span class="ledger-val">
          {[
            b.responseTimeHours != null
              ? `replies in ~${b.responseTimeHours} ${b.responseTimeHours === 1 ? "hr" : "hrs"}`
              : null,
            serviceTowns.length > 1 ? `serves ${serviceTowns.length} towns` : townName ? `serves ${townName}` : null,
          ].filter(Boolean).join(" · ") || "identity confirmed"}
        </span>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      {b.phone && (
        <a
          href={`tel:${b.phone.replace(/[^+\d]/g, "")}`}
          class="rounded-chip bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
        >
          Call {b.phone}
        </a>
      )}
      <a
        href={`/business/${b.slug}`}
        rel={rel}
        class="rounded-chip border border-line-strong px-4 py-2 text-sm font-semibold text-ink hover:bg-inset"
      >
        View profile
      </a>
      {b.website && (
        <a
          href={b.website}
          rel={sponsored ? "sponsored nofollow" : "nofollow"}
          target="_blank"
          class="rounded-chip border border-line px-4 py-2 text-sm font-medium text-muted hover:bg-inset hover:text-ink"
        >
          Website
        </a>
      )}
    </div>
  </div>
</article>
