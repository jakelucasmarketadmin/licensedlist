---
import TrustBadge from "@/components/site/TrustBadge.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import {
  type DirectoryBusiness,
  blendedRating,
  totalReviewCount,
  ratingSourcesLabel,
  isSponsoredPlacement,
  isDemo,
  isUnclaimed,
  ratingReportedVia,
  additionalLicenses,
} from "@/lib/businesses";
import { getCategory } from "@/lib/taxonomy";
import { heroPhotoFor, focalPosition } from "@/lib/town-photos";
import { imageAt, srcsetFor, lqipStyle } from "@/lib/images";

interface Props {
  business: DirectoryBusiness;
  /** Rendered inside the labeled featured block (adds the Featured tag). */
  inFeaturedBlock?: boolean;
  /** Town context for the "Serves" line. */
  townName?: string;
  /** Prefix the subtitle with the primary category (used off listing pages). */
  showCategory?: boolean;
  /** Suppress the photo strip (compact contexts). */
  noPhoto?: boolean;
  /** "vertical" poster card (home carousels) or "horizontal" dense list card. */
  layout?: "vertical" | "horizontal";
  /** LCP candidate (first cards above the fold): eager + fetchpriority=high. */
  priorityPhoto?: boolean;
}
const {
  business: b,
  inFeaturedBlock = false,
  townName,
  showCategory = false,
  noPhoto = false,
  layout = "vertical",
  priorityPhoto = false,
} = Astro.props;

const rating = blendedRating(b);
const reviews = totalReviewCount(b);
const sourcesLabel = ratingSourcesLabel(b);
const isClient = b.isClient === true || b.isClient === "true";
const sponsored = isSponsoredPlacement(b);
const rel = sponsored ? "sponsored" : undefined;
const serviceTowns = (b.serviceTownSlugs ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const categoryName = b.primaryCategorySlug ? getCategory(b.primaryCategorySlug)?.name : undefined;
const extraLicenses = additionalLicenses(b);
const verifiedDate = b.licenseVerifiedAt
  ? new Date(b.licenseVerifiedAt).toLocaleDateString("en-US", { month: "short", year: "numeric" })
  : null;

let photos: string[] = [];
try {
  const parsed = b.photosJson
    ? typeof b.photosJson === "string"
      ? JSON.parse(b.photosJson)
      : b.photosJson
    : [];
  if (Array.isArray(parsed)) photos = parsed.filter((p) => typeof p === "string" && p.startsWith("http"));
} catch { /* no photos */ }

// Photo fallback ladder: business photo → town/county photo (credited) →
// category tile. The tile is the base layer; the photo rungs sit on top and
// remove themselves on load error, revealing the next rung down.
const townPhoto = b.stateSlug ? heroPhotoFor(b.stateSlug, b.countySlug, b.townSlug) : undefined;
const topRated = rating !== null && rating >= 4.8 && reviews >= 25;
const topServices = (b.services ?? "").split(",").map((s) => s.trim()).filter(Boolean).slice(0, 3);
const horizontal = layout === "horizontal";
const mainPhoto = photos[0];
const thumbs = photos.length >= 4 ? photos.slice(1, 5) : [];
const bizSizes = horizontal ? "(min-width: 768px) 38vw, 100vw" : "(min-width: 1024px) 40vw, 100vw";
---

<article
  class:list={[
    "card-hover overflow-hidden rounded-card border border-line bg-surface",
    horizontal && "md:flex",
  ]}
  data-biz-card={b.slug}
  data-lat={b.lat ?? ""}
  data-lng={b.lng ?? ""}
  data-rating={rating ?? ""}
  data-reviews={reviews}
  data-license={b.licenseStatus ?? ""}
  data-responds={b.responseTimeHours ?? ""}
  data-insured={b.insuredStatus ?? ""}
  data-services={b.services ?? ""}
  data-featured={inFeaturedBlock ? "1" : ""}
>
  {!noPhoto && (
    <div class:list={[horizontal ? "md:w-[38%] md:shrink-0" : ""]}>
      <div
        class:list={[
          "group relative w-full overflow-hidden bg-inset",
          horizontal
            ? "aspect-video max-h-[200px] md:aspect-[4/3] md:max-h-[240px]"
            : "aspect-[4/3]",
        ]}
        data-photo-frame
        transition:name={`biz-photo-${b.slug}`}
      >
        <div class="absolute inset-0">
          <CategoryTile slug={b.primaryCategorySlug ?? ""} asFallback />
        </div>

        {townPhoto && (
          <div class:list={["absolute inset-0", mainPhoto && "hidden"]} data-rung-town>
            <img
              src={imageAt(townPhoto.url, 960)}
              srcset={srcsetFor(townPhoto.url)}
              sizes={bizSizes}
              alt={townPhoto.alt}
              loading={priorityPhoto ? "eager" : "lazy"}
              fetchpriority={priorityPhoto ? "high" : undefined}
              decoding="async"
              class="h-full w-full object-cover"
              style={`object-position:${focalPosition(townPhoto)};`}
              onerror="this.closest('[data-rung-town]').remove()"
            />
            <a
              href="/credits"
              class="absolute bottom-1.5 right-1.5 rounded-chip bg-brand-deep/75 px-2 py-0.5 text-[10px] text-white/90 opacity-0 transition-opacity group-hover:opacity-100"
              title={`${townPhoto.caption} — ${townPhoto.author}, ${townPhoto.license}`}
            >
              area photo · credit
            </a>
          </div>
        )}

        {mainPhoto && (
          <div class="absolute inset-0" data-rung-biz>
            <img
              src={imageAt(mainPhoto, 960)}
              srcset={srcsetFor(mainPhoto)}
              sizes={bizSizes}
              alt={`${b.name} — photo`}
              loading={priorityPhoto ? "eager" : "lazy"}
              fetchpriority={priorityPhoto ? "high" : undefined}
              decoding="async"
              class="h-full w-full object-cover"
              style={lqipStyle(mainPhoto)}
              onerror="var f=this.closest('[data-photo-frame]');if(f){f.querySelectorAll('[data-rung-town]').forEach(function(e){e.classList.remove('hidden')})}var r=this.closest('[data-rung-biz]');if(r){r.remove()}"
            />
          </div>
        )}

        <div class="absolute left-2 top-2 flex flex-wrap gap-1.5">
          {b.licenseStatus === "verified" && (
            <span class="rounded-chip bg-[#177245] px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">Verified</span>
          )}
          {inFeaturedBlock && (
            <span class="rounded-chip bg-[#14456b] px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">Featured</span>
          )}
          {topRated && (
            <span class="rounded-chip bg-[#0b2b45] px-2 py-0.5 text-[11px] font-semibold text-white shadow-sm">Top rated</span>
          )}
        </div>
      </div>

      {horizontal && thumbs.length > 0 && (
        <div class="hidden grid-cols-4 gap-0.5 md:grid">
          {thumbs.map((t) => (
            <img
              src={imageAt(t, 330)}
              alt=""
              loading="lazy"
              decoding="async"
              class="h-12 w-full object-cover"
              onerror="this.remove()"
            />
          ))}
        </div>
      )}
    </div>
  )}

  <div class:list={[horizontal ? "min-w-0 flex-1 p-4" : "p-5"]}>
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="font-display text-lg font-semibold text-ink">
            <a href={`/business/${b.slug}`} rel={rel} class="hover:text-brand">{b.name}</a>
          </h3>
          {noPhoto && inFeaturedBlock && (
            <span class="rounded-chip bg-brand-wash px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-brand">
              Featured
            </span>
          )}
          {isClient ? (
            <span class="rounded-chip bg-inset px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-faint" title="This business is a client of the agency that operates this directory. Disclosed placements receive no ranking benefit.">
              Sponsored · client of the agency
            </span>
          ) : sponsored && !inFeaturedBlock ? (
            <span class="rounded-chip bg-inset px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-faint">
              Sponsored
            </span>
          ) : null}
          {isDemo(b) && (
            <span class="rounded-chip bg-warn-wash px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-warn">
              Sample
            </span>
          )}
          {isUnclaimed(b) && (
            <span class="rounded-chip border border-line bg-inset px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-faint" title="Compiled from public records and the business's own website — not yet claimed by the business.">
              Unclaimed
            </span>
          )}
        </div>
        <p class="mt-0.5 text-sm text-muted">
          {showCategory && categoryName && `${categoryName} · `}{b.city}, {b.state}
          {b.yearsInBusiness ? ` · ${b.yearsInBusiness} yrs in business` : ""}
        </p>
      </div>
      <TrustBadge
        licenseStatus={b.licenseStatus}
        licenseSource={b.licenseSource}
        licenseVerifiedAt={b.licenseVerifiedAt}
        size="sm"
      />
    </div>

    {rating !== null ? (
      <p class="mt-2 text-sm text-ink">
        <span class="font-semibold">{rating}★</span>
        <span class="text-muted"> · {reviews} reviews across {sourcesLabel}{isUnclaimed(b) && `, as reported by ${ratingReportedVia(b)}`}</span>
      </p>
    ) : (
      <p class="mt-2 text-sm text-faint">Not enough review data yet</p>
    )}

    {b.whyWePicked && (
      <p class:list={["mt-2 text-sm leading-relaxed text-muted", horizontal && "line-clamp-2"]}>
        <span class="font-medium text-ink">Why we picked them:</span> {b.whyWePicked}
      </p>
    )}

    {horizontal && topServices.length > 0 && (
      <p class="mt-2 flex flex-wrap items-center gap-1.5">
        {topServices.map((s) => (
          <span class="rounded-chip bg-inset px-2.5 py-0.5 text-xs text-muted">{s}</span>
        ))}
      </p>
    )}

    <div class="ledger mt-3 rounded-[10px] bg-inset px-3 py-1.5">
      <div class="ledger-row">
        <span class="ledger-key">License</span>
        <span class="ledger-val">
          {b.licenseStatus === "verified"
            ? [
                b.licenseNumber,
                ...extraLicenses.map((l) => `${l.number}${l.label ? ` (${l.label})` : ""}`),
              ].filter(Boolean).join(" + ") +
              ` · ${b.licenseSource}${verifiedDate ? ` · checked ${verifiedDate}` : ""}`
            : b.licenseStatus === "not-required"
              ? "Not required for this category"
              : b.licenseStatus === "credential-only"
                ? "Owner's personal credential on file — no facility license"
                : "Not verified — ask before you hire"}
        </span>
      </div>
      {!horizontal && (
        <div class="ledger-row">
          <span class="ledger-key">Trust</span>
          <span class="ledger-val">
            {[
              Number(b.responseTimeHours) > 0
                ? `replies in ~${Number(b.responseTimeHours)} ${Number(b.responseTimeHours) === 1 ? "hr" : "hrs"}`
                : null,
              serviceTowns.length > 1 ? `serves ${serviceTowns.length} towns` : townName ? `serves ${townName}` : null,
            ].filter(Boolean).join(" · ") || "identity confirmed"}
          </span>
        </div>
      )}
    </div>

    <div class="mt-3 flex flex-wrap gap-2">
      {b.phone && (
        <a
          href={`tel:${b.phone.replace(/[^+\d]/g, "")}`}
          class="rounded-chip bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
        >
          Call {b.phone}
        </a>
      )}
      <a
        href={`/business/${b.slug}`}
        rel={rel}
        class="rounded-chip border border-line-strong px-4 py-2 text-sm font-semibold text-ink hover:bg-inset"
      >
        View profile
      </a>
      {!horizontal && b.website && (
        <a
          href={b.website}
          rel={sponsored ? "sponsored nofollow" : "nofollow"}
          target="_blank"
          class="rounded-chip border border-line px-4 py-2 text-sm font-medium text-muted hover:bg-inset hover:text-ink"
        >
          Website
        </a>
      )}
    </div>
  </div>
</article>
