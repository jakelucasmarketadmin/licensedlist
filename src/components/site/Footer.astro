---
import { SITE_NAME, SITE_TAGLINE, STATES } from "@/lib/site";
import Wordmark from "@/components/site/Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="max-w-xs">
        <a href="/" aria-label={`${SITE_NAME} home`}><Wordmark /></a>
        <p class="mt-3 text-sm text-muted">{SITE_TAGLINE}.</p>
        <p class="mt-2 text-sm text-muted">
          A local directory that checks licenses against official state registries before a
          business earns a badge.
        </p>
      </div>

      <nav aria-label="Directory">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-faint">Directory</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-muted hover:text-ink" href="/">Find a pro</a></li>
          <li><a class="text-muted hover:text-ink" href="/categories">All categories</a></li>
          <li><a class="text-muted hover:text-ink" href="/search">Search</a></li>
          <li><a class="text-muted hover:text-ink" href="/how-we-verify">How we verify</a></li>
        </ul>
        <h2 class="mt-6 text-xs font-semibold uppercase tracking-wider text-faint">Coverage</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {STATES.map((s) => (
            <li><a class="text-muted hover:text-ink" href={`/${s.slug}`}>{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="For businesses">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-faint">For businesses</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-muted hover:text-ink" href="/for-businesses">List your business</a></li>
          <li><a class="text-muted hover:text-ink" href="/for-businesses#pricing">Plans &amp; pricing</a></li>
          <li><a class="text-muted hover:text-ink" href="/for-businesses#faq">Owner FAQ</a></li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-faint">Company</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-muted hover:text-ink" href="/about">About</a></li>
          <li><a class="text-muted hover:text-ink" href="/editorial-policy">Editorial policy</a></li>
          <li><a class="text-muted hover:text-ink" href="/privacy">Privacy</a></li>
          <li><a class="text-muted hover:text-ink" href="/terms">Terms</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-line pt-6">
      <p class="text-xs text-faint">
        © {year} {SITE_NAME}. License information is checked against official state and local
        registries at the time shown on each listing. Registration or licensure is not an
        endorsement of a business's competency.
      </p>
    </div>
  </div>
</footer>
