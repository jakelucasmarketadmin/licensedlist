---
import HeroSearchTypeahead from "@/components/site/HeroSearchTypeahead.tsx";
import { getCategory } from "@/lib/taxonomy";

// The "Popular" empty-state list mirrors the home category grid's headliners.
const POPULAR_SLUGS = [
  "roofers", "plumbers", "electricians", "hvac-contractors",
  "landscapers", "house-cleaners", "dentists", "attorneys",
];
const popular = POPULAR_SLUGS
  .map((slug) => getCategory(slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => ({ name: c.name, slug: c.slug }));
---

<HeroSearchTypeahead client:load popular={popular} />
