---
import { SITE_NAME } from "@/lib/site";
import Wordmark from "@/components/site/Wordmark.astro";

const NAV_LINKS = [
  { label: "Find a pro", href: "/" },
  { label: "How we verify", href: "/how-we-verify" },
  { label: "For businesses", href: "/for-businesses" },
  { label: "About", href: "/about" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-surface">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${SITE_NAME} home`}>
      <Wordmark />
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
        <a href="/how-we-verify" class="rounded-chip px-3 py-2 text-sm font-medium text-muted hover:bg-inset hover:text-ink">
          How we verify
        </a>
        <a href="/about" class="rounded-chip px-3 py-2 text-sm font-medium text-muted hover:bg-inset hover:text-ink">
          About
        </a>
      </nav>

      <a
        href="/for-businesses"
        class="rounded-chip bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
      >
        List your business
      </a>

      {/* Mobile menu — CSS-only disclosure, no JS required */}
      <details class="relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-[10px] border border-line text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 top-12 z-50 w-56 rounded-card border border-line bg-surface p-2 shadow-lg"
        >
          {NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="block rounded-[10px] px-4 py-3 text-sm font-medium text-ink hover:bg-inset"
            >
              {link.label}
            </a>
          ))}
          <a
            href="/for-businesses/get-listed"
            class="mt-1 block rounded-[10px] bg-accent px-4 py-3 text-center text-sm font-semibold text-accent-ink"
          >
            Get listed free
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
