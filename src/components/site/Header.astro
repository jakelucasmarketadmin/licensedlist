---
import { SITE_NAME } from "@/lib/site";
import Wordmark from "@/components/site/Wordmark.astro";
---

<header class="sticky top-0 z-50 border-b border-line bg-surface">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2" aria-label={`${SITE_NAME} home`}>
      <Wordmark />
    </a>

    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      <a
        href="/how-we-verify"
        class="hidden rounded-chip px-3 py-2 text-sm font-medium text-muted hover:bg-inset hover:text-ink sm:block"
      >
        How we verify
      </a>
      <a
        href="/about"
        class="hidden rounded-chip px-3 py-2 text-sm font-medium text-muted hover:bg-inset hover:text-ink md:block"
      >
        About
      </a>
      <a
        href="/for-businesses"
        class="rounded-chip bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
      >
        List your business
      </a>
    </nav>
  </div>
</header>
