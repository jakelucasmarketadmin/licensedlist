---
import {
  type SiteReview,
  siteAverage,
  aspectAverages,
  ratingHistogram,
  reviewAspects,
  reviewPhotos,
  isVerifiedHire,
  popularServices,
  ASPECT_LABELS,
} from "@/lib/reviews";
import type { DirectoryBusiness } from "@/lib/businesses";
import { blendedRating, totalReviewCount, ratingSourcesLabel } from "@/lib/businesses";
import { imageAt } from "@/lib/images";
import { REVIEW_REPORT_EMAIL } from "@/lib/site";

/**
 * On-site review display: aspect bars, histogram, keyword chips (filter),
 * cards with photos + verified-hire stamp + owner response, client-side sort,
 * report link. External platform ratings stay a text summary — never mixed
 * into the on-site numbers (docs/REVIEWS.md).
 */
import type { ReviewSummary } from "@/lib/summaries";

interface Props {
  business: DirectoryBusiness;
  reviews: SiteReview[];
  /** AI "What customers say" (D3) — null hides the block entirely. */
  summary?: ReviewSummary | null;
}
const { business: b, reviews, summary = null } = Astro.props;
const SENTIMENT_STYLE: Record<string, string> = {
  positive: "bg-ok-wash text-ok",
  mixed: "bg-warn-wash text-warn",
  negative: "bg-danger-wash text-danger",
};

const avg = siteAverage(reviews);
const aspects = aspectAverages(reviews);
const histogram = ratingHistogram(reviews);
const verifiedCount = reviews.filter(isVerifiedHire).length;
const chips = popularServices(b, reviews, 6).filter((c) => c.mentions > 0);
const externalRating = blendedRating(b);
const externalCount = totalReviewCount(b);
const externalLabel = ratingSourcesLabel(b);
const writeUrl = `/write-review?biz=${encodeURIComponent(b.slug ?? "")}`;
const fmtDate = (d?: string | Date) =>
  d ? new Date(d).toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "";
---

<div>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 class="font-display text-2xl font-semibold text-ink">Reviews</h2>
    <a href={writeUrl} rel="nofollow" class="rounded-chip border border-line-strong px-4 py-2 text-sm font-semibold text-ink hover:bg-inset">
      Write a review
    </a>
  </div>

  {summary && (
    <div class="mt-4 rounded-card border border-line bg-surface p-4">
      <p class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-faint">
        What customers say
        <span class="rounded-chip bg-inset px-2 py-0.5 font-medium normal-case tracking-normal text-faint" title="Generated by AI from the published on-site reviews below; every claim links to the reviews that support it.">AI-generated summary</span>
      </p>
      <p class="mt-2 text-sm leading-relaxed text-muted">{summary.overall}</p>
      {summary.aspects.length > 0 && (
        <ul class="mt-3 space-y-1.5">
          {summary.aspects.map((a) => (
            <li class="flex flex-wrap items-baseline gap-2 text-sm">
              <span class:list={["rounded-chip px-2 py-0.5 text-[11px] font-semibold", SENTIMENT_STYLE[a.sentiment] ?? "bg-inset text-muted"]}>
                {a.aspect}
              </span>
              <span class="text-muted">{a.note}</span>
              {a.reviewIds.length > 0 && (
                <span class="text-xs text-faint">
                  from{" "}
                  {a.reviewIds.slice(0, 3).map((id, i) => (
                    <a href={`#review-${id}`} class="underline underline-offset-2 hover:text-muted">review {i + 1}{i < Math.min(a.reviewIds.length, 3) - 1 ? ", " : ""}</a>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  {reviews.length > 0 ? (
    <div class="mt-4 grid gap-6 md:grid-cols-[240px_1fr]">
      <div>
        <p class="font-display text-5xl font-bold text-ink">{avg}<span class="text-2xl text-muted">★</span></p>
        <p class="mt-1 text-sm text-muted">
          {reviews.length} on-site {reviews.length === 1 ? "review" : "reviews"}
          {verifiedCount > 0 && ` · ${verifiedCount} verified ${verifiedCount === 1 ? "hire" : "hires"}`}
        </p>
        <div class="mt-3 space-y-1" aria-label="Rating distribution">
          {histogram.map((n, i) => (
            <div class="flex items-center gap-2 text-xs text-muted">
              <span class="w-6 text-right">{5 - i}★</span>
              <span class="h-2 flex-1 overflow-hidden rounded-full bg-inset">
                <span class="block h-full rounded-full bg-accent" style={`width:${reviews.length ? Math.round((n / reviews.length) * 100) : 0}%`}></span>
              </span>
              <span class="w-5">{n}</span>
            </div>
          ))}
        </div>
        {aspects.length > 0 && (
          <dl class="mt-4 space-y-2">
            {aspects.map((a) => (
              <div>
                <div class="flex justify-between text-xs">
                  <dt class="font-medium text-ink">{a.label}</dt>
                  <dd class="text-muted">{a.avg}</dd>
                </div>
                <div class="mt-0.5 h-1.5 overflow-hidden rounded-full bg-inset">
                  <span class="block h-full rounded-full bg-brand" style={`width:${Math.round((a.avg / 5) * 100)}%`}></span>
                </div>
              </div>
            ))}
          </dl>
        )}
        {externalRating !== null && (
          <p class="mt-4 border-t border-line pt-3 text-xs leading-relaxed text-faint">
            Elsewhere: {externalRating}★ across {externalCount} reviews on {externalLabel}. Platform
            numbers are shown for context and never counted into the on-site score.
          </p>
        )}
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          {chips.length > 0 && (
            <>
              <span class="text-xs font-semibold uppercase tracking-wider text-faint">Mentioned</span>
              {chips.map((c) => (
                <button
                  type="button"
                  data-review-chip={c.label.toLowerCase()}
                  class="rounded-chip border border-line bg-surface px-3 py-1 text-xs font-medium text-muted transition-colors hover:border-brand hover:text-ink aria-pressed:border-brand aria-pressed:bg-brand-wash aria-pressed:text-brand"
                  aria-pressed="false"
                >
                  {c.label}{c.mentions > 2 ? ` · ${c.mentions - 2}` : ""}
                </button>
              ))}
            </>
          )}
          <label class="ml-auto flex items-center gap-2 text-xs text-muted">
            Sort
            <select data-review-sort class="rounded-[8px] border border-line bg-surface px-2 py-1 text-xs text-ink">
              <option value="recent">Most recent</option>
              <option value="highest">Highest rated</option>
              <option value="lowest">Lowest rated</option>
            </select>
          </label>
        </div>

        <ul data-review-list class="mt-4 space-y-4">
          {reviews.map((r) => {
            const ra = reviewAspects(r);
            const photos = reviewPhotos(r);
            return (
              <li
                id={`review-${r._id}`}
                class="scroll-mt-32 rounded-card border border-line bg-surface p-4"
                data-review-card
                data-rating={r.rating ?? ""}
                data-date={r._createdDate ? new Date(r._createdDate).getTime() : 0}
                data-text={(r.body ?? "").toLowerCase()}
              >
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-semibold text-ink">{r.reviewerName ?? "Customer"}</span>
                  {r.townName && <span class="text-xs text-faint">· {r.townName}</span>}
                  {isVerifiedHire(r) ? (
                    <span class="rounded-chip bg-[#177245] px-2 py-0.5 text-[11px] font-semibold text-white" title="This customer hired the business through a LicensedList quote request; the review link was sent to every customer of a completed job, never only happy ones.">
                      Verified hire via LicensedList
                    </span>
                  ) : (
                    <span class="rounded-chip bg-inset px-2 py-0.5 text-[11px] font-medium text-faint" title="Submitted through the public review form; identity checked, hire not confirmed through LicensedList.">
                      Unverified
                    </span>
                  )}
                  <span class="ml-auto text-xs text-faint">{fmtDate(r._createdDate)}</span>
                </div>
                <p class="mt-1.5 text-sm font-semibold text-ink">{r.rating}★{r.jobType ? ` · ${r.jobType}` : ""}</p>
                {r.body && <p class="mt-1.5 text-sm leading-relaxed text-muted">{r.body}</p>}
                {Object.keys(ra).length > 0 && (
                  <p class="mt-2 text-xs text-faint">
                    {Object.entries(ra).map(([k, v]) => `${(ASPECT_LABELS as any)[k] ?? k} ${v}`).join(" · ")}
                  </p>
                )}
                {photos.length > 0 && (
                  <div class="mt-2 flex gap-1.5">
                    {photos.slice(0, 4).map((p, i) => (
                      <img src={imageAt(p, 250)} alt={`Photo from ${r.reviewerName ?? "customer"} ${i + 1}`} loading="lazy" decoding="async" class="h-16 w-16 rounded-[8px] border border-line object-cover" />
                    ))}
                  </div>
                )}
                {r.ownerResponse && (
                  <div class="mt-3 rounded-[10px] bg-inset p-3">
                    <p class="text-xs font-semibold text-ink">
                      Response from {b.name}
                      {r.ownerRespondedAt && <span class="font-normal text-faint"> · {fmtDate(r.ownerRespondedAt)}</span>}
                    </p>
                    <p class="mt-1 text-sm leading-relaxed text-muted">{r.ownerResponse}</p>
                  </div>
                )}
                <p class="mt-2 text-right">
                  <a
                    href={`mailto:${REVIEW_REPORT_EMAIL}?subject=${encodeURIComponent(`Report review on ${b.name}`)}&body=${encodeURIComponent(`Review id: ${r._id}\nReason: `)}`}
                    class="text-[11px] text-faint underline underline-offset-2 hover:text-muted"
                    rel="nofollow"
                  >
                    Report
                  </a>
                </p>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  ) : (
    <div class="mt-4 rounded-card border border-line bg-surface p-5">
      {externalRating !== null && (
        <p class="text-sm leading-relaxed text-muted">
          {externalRating}★ across {externalCount} reviews on {externalLabel} — we read platform
          reviews for patterns and never edit, filter, or reorder them.
        </p>
      )}
      <p class:list={["text-sm leading-relaxed text-muted", externalRating !== null && "mt-2"]}>
        No on-site reviews yet. Hired through {`LicensedList`}? You'll get a one-time review link
        after the job — it goes to every customer, never only the happy ones. You can also
        <a href={writeUrl} rel="nofollow" class="font-medium text-brand underline underline-offset-2"> write a review</a> now.
      </p>
    </div>
  )}

  <script is:inline data-astro-rerun>
    (function () {
      var list = document.querySelector("[data-review-list]");
      if (!list || list.dataset.wired) return;
      list.dataset.wired = "1";
      var cards = Array.prototype.slice.call(list.querySelectorAll("[data-review-card]"));
      var active = null;
      function apply() {
        cards.forEach(function (c) {
          c.hidden = Boolean(active) && c.getAttribute("data-text").indexOf(active) === -1;
        });
      }
      document.querySelectorAll("[data-review-chip]").forEach(function (chip) {
        chip.addEventListener("click", function () {
          var key = chip.getAttribute("data-review-chip");
          active = active === key ? null : key;
          document.querySelectorAll("[data-review-chip]").forEach(function (c) {
            c.setAttribute("aria-pressed", String(c.getAttribute("data-review-chip") === active));
          });
          apply();
        });
      });
      var sort = document.querySelector("[data-review-sort]");
      if (sort)
        sort.addEventListener("change", function () {
          var mode = sort.value;
          cards
            .slice()
            .sort(function (a, b) {
              if (mode === "highest") return Number(b.dataset.rating) - Number(a.dataset.rating);
              if (mode === "lowest") return Number(a.dataset.rating) - Number(b.dataset.rating);
              return Number(b.dataset.date) - Number(a.dataset.date);
            })
            .forEach(function (c) { list.appendChild(c); });
        });
    })();
  </script>
</div>
