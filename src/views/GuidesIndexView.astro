---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import Pic from "@/components/site/Pic.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import { GUIDE_SEED, type GuideSeed } from "@/data/guides.generated";
import { getState, getCounty } from "@/lib/geo";
import { getCategory } from "@/lib/taxonomy";
import { photosForCounty, focalPosition } from "@/lib/town-photos";
import { SITE_NAME } from "@/lib/site";

/**
 * /guides (C3) — index of every hub-embedded guide with cover art, type/state
 * filters (client-side, #fragment — no new URLs), and the editorial author
 * card. Guides render on their host hub pages; cards deep-link there.
 */
const TYPE_LABELS: Record<string, string> = {
  licensing: "Licensing",
  cost: "Cost context",
  hiring: "Hiring",
};

interface Card {
  guide: GuideSeed;
  type: string;
  stateSlug: string;
  href: string;
  hostLabel: string;
  cover?: { url: string; position?: string };
  categorySlug?: string;
}

const cards: Card[] = GUIDE_SEED.map((g) => {
  const type = g.slug.startsWith("licensing") ? "licensing" : g.slug.startsWith("cost") ? "cost" : "hiring";
  if (g.scope === "state") {
    const state = getState(g.scopeKey);
    return {
      guide: g, type,
      stateSlug: g.scopeKey,
      href: `/${g.scopeKey}`,
      hostLabel: state?.name ?? g.scopeKey,
    };
  }
  if (g.scope === "county") {
    const [stateSlug, countySlug] = g.scopeKey.split("/");
    const county = getCounty(stateSlug, countySlug);
    const photo = photosForCounty(stateSlug, countySlug)[0];
    return {
      guide: g, type,
      stateSlug,
      href: `/${g.scopeKey}`,
      hostLabel: county?.name ?? g.scopeKey,
      cover: photo ? { url: photo.url, position: focalPosition(photo) } : undefined,
    };
  }
  // category scope — key is the category slug
  const category = getCategory(g.scopeKey);
  return {
    guide: g, type,
    stateSlug: "",
    href: `/${g.scopeKey}`,
    hostLabel: category?.name ?? g.scopeKey,
    categorySlug: g.scopeKey,
  };
}).sort((a, b) => (b.guide.updatedAt || "").localeCompare(a.guide.updatedAt || ""));

const stateChips = [
  { key: "nj", label: "New Jersey" },
  { key: "ny", label: "New York" },
  { key: "pa", label: "Pennsylvania" },
];
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={[{ name: "Home", path: "/" }, { name: "Guides", path: "/guides" }]} />

  <header class="mt-4 max-w-prose">
    <h1 class="font-display text-4xl font-bold text-ink">Hiring &amp; licensing guides</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted">
      {cards.length} sourced guides on how licensing, permits, costs, and hiring work across the
      tri-state — every claim cited, no invented numbers.
    </p>
  </header>

  <div class="mt-6 flex flex-wrap items-center gap-2" data-guide-filters>
    <span class="text-xs font-semibold uppercase tracking-wider text-faint">Type</span>
    {Object.entries(TYPE_LABELS).map(([key, label]) => (
      <button type="button" data-gf-type={key} aria-pressed="false" class="rounded-chip border border-line bg-surface px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:text-ink aria-pressed:border-brand aria-pressed:bg-brand-wash aria-pressed:text-brand">
        {label}
      </button>
    ))}
    <span class="ml-3 text-xs font-semibold uppercase tracking-wider text-faint">State</span>
    {stateChips.map((s) => (
      <button type="button" data-gf-state={s.key} aria-pressed="false" class="rounded-chip border border-line bg-surface px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:text-ink aria-pressed:border-brand aria-pressed:bg-brand-wash aria-pressed:text-brand">
        {s.label}
      </button>
    ))}
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-guide-grid>
    {cards.map((c) => (
      <a
        href={c.href}
        class="card-hover group flex flex-col overflow-hidden rounded-card border border-line bg-surface"
        data-guide-card
        data-type={c.type}
        data-state={c.stateSlug}
      >
        <div class="relative aspect-[16/9] overflow-hidden bg-inset">
          {c.cover ? (
            <Pic src={c.cover.url} alt="" aspect={16 / 9} sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw" position={c.cover.position} />
          ) : c.categorySlug ? (
            <CategoryTile slug={c.categorySlug} asFallback />
          ) : (
            <div class="flex h-full items-center justify-center bg-brand-deep">
              <span class="font-display text-3xl font-bold uppercase text-white/80">{c.stateSlug}</span>
            </div>
          )}
          <span class="absolute left-2 top-2 rounded-chip bg-surface px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-muted shadow-sm">
            {TYPE_LABELS[c.type]}
          </span>
        </div>
        <div class="flex flex-1 flex-col p-4">
          <h2 class="font-display text-lg font-semibold leading-snug text-ink group-hover:text-brand">{c.guide.title}</h2>
          <p class="mt-auto pt-3 text-xs text-faint">
            On the {c.hostLabel} page · updated {new Date(c.guide.updatedAt || c.guide.publishedAt).toLocaleDateString("en-US", { month: "short", year: "numeric" })}
          </p>
        </div>
      </a>
    ))}
  </div>
  <p data-guide-empty class="mt-6 hidden text-sm text-muted">No guides match those filters.</p>

  <aside class="mt-12 max-w-prose rounded-card border border-line bg-surface p-5">
    <h2 class="font-display text-lg font-semibold text-ink">About these guides</h2>
    <p class="mt-2 text-sm leading-relaxed text-muted">
      Written by the {SITE_NAME} editorial team, drafted with AI assistance and human-reviewed
      before publishing. Every regulatory or cost claim carries a citation to a primary source —
      when we can't source a number, we don't print one.
      <a href="/editorial-policy" class="font-medium text-brand underline underline-offset-2">Editorial policy</a>
    </p>
  </aside>

  <script is:inline data-astro-rerun>
    (function () {
      var wrap = document.querySelector("[data-guide-filters]");
      if (!wrap || wrap.dataset.wired) return;
      wrap.dataset.wired = "1";
      var active = { type: null, state: null };
      function apply() {
        var any = false;
        document.querySelectorAll("[data-guide-card]").forEach(function (card) {
          var show =
            (!active.type || card.getAttribute("data-type") === active.type) &&
            (!active.state || card.getAttribute("data-state") === active.state);
          card.classList.toggle("hidden", !show);
          if (show) any = true;
        });
        document.querySelector("[data-guide-empty]").classList.toggle("hidden", any);
      }
      wrap.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-gf-type],[data-gf-state]");
        if (!btn) return;
        var kind = btn.hasAttribute("data-gf-type") ? "type" : "state";
        var val = btn.getAttribute("data-gf-" + kind);
        active[kind] = active[kind] === val ? null : val;
        wrap.querySelectorAll("[data-gf-" + kind + "]").forEach(function (b) {
          b.setAttribute("aria-pressed", String(b.getAttribute("data-gf-" + kind) === active[kind]));
        });
        apply();
      });
    })();
  </script>
</article>
