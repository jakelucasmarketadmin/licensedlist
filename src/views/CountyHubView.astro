---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import CategoriesEmptyState from "@/components/site/CategoriesEmptyState.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import Pic from "@/components/site/Pic.astro";
import MiniMap from "@/components/site/MiniMap.tsx";
import {
  getTownsByCounty,
  getNearbyCounties,
  type StateSeed,
  type CountySeed,
} from "@/lib/geo";
import { getGuide } from "@/lib/guides";
import GuideSection from "@/components/site/GuideSection.astro";
import { getCategories } from "@/lib/taxonomy";
import { fetchBusinesses, isPublished, categoriesOf, servesTown, type DirectoryBusiness } from "@/lib/businesses";
import ResultCard from "@/components/site/ResultCard.astro";
import { getCategory } from "@/lib/taxonomy";
import { heroPhotoFor } from "@/lib/town-photos";
import { countRegistered, listRegistered } from "@/lib/registry";
import RegistryTable from "@/components/site/RegistryTable.astro";
import NewsletterSignup from "@/components/site/NewsletterSignup.astro";
import { eventsForCounty, eventDateLabel, isDemoEvent } from "@/lib/events";

interface Props {
  state: StateSeed;
  county: CountySeed;
}
const { state, county } = Astro.props;
const towns = getTownsByCounty(state.slug, county.slug);
const nearby = getNearbyCounties(county);
const costGuide = getGuide("county", county.pathKey, "cost-context-");
const heroPhoto = heroPhotoFor(state.slug, county.slug);

// Categories meeting the 3-listing rule in this county (home county OR service area).
const townSlugs = new Set(towns.map((t) => t.slug));
const counts = new Map<string, number>();
try {
  for (const b of (await fetchBusinesses()).filter(isPublished)) {
    if (b.stateSlug !== state.slug) continue;
    const inCounty =
      b.countySlug === county.slug ||
      (b.serviceTownSlugs ?? "").split(",").some((t) => townSlugs.has(t.trim()));
    if (!inCounty) continue;
    for (const slug of categoriesOf(b)) counts.set(slug, (counts.get(slug) ?? 0) + 1);
  }
} catch { /* fail soft */ }
const qualified = getCategories()
  .map((c) => ({ category: c, count: counts.get(c.slug) ?? 0 }))
  .filter((e) => e.count >= 3)
  .sort((a, b) => b.count - a.count);

// Every published business in (or serving) the county, for the hub section.
let countyBusinesses: DirectoryBusiness[] = [];
try {
  countyBusinesses = (await fetchBusinesses()).filter((b) => {
    if (!isPublished(b) || b.stateSlug !== state.slug) return false;
    return (
      b.countySlug === county.slug ||
      (b.serviceTownSlugs ?? "").split(",").some((t) => townSlugs.has(t.trim()))
    );
  });
} catch { /* fail soft */ }
const bizByCategory = new Map<string, DirectoryBusiness[]>();
for (const b of countyBusinesses) {
  const key = b.primaryCategorySlug ?? "other";
  bizByCategory.set(key, [...(bizByCategory.get(key) ?? []), b]);
}
const bizGroups = [...bizByCategory.entries()]
  .map(([slug, items]) => ({ category: getCategory(slug), items }))
  .sort((a, b) => b.items.length - a.items.length);

const registeredCount = await countRegistered({ stateSlug: state.slug, countySlug: county.slug });
// The roster table renders on the hub when the county has registry rows but
// no qualifying list page to host it (NYC counties pre-launch).
const registeredRows = registeredCount > 0 ? await listRegistered({ stateSlug: state.slug, countySlug: county.slug }, 100) : [];
const preview = Astro.url.searchParams.get("preview") === "demo";
const countyEvents = (await eventsForCounty(state.slug, county.slug, preview)).slice(0, 5);

const mapPoints = [
  ...towns.map((t) => ({
    label: t.name,
    lat: Number(t.lat),
    lng: Number(t.lng),
    href: `/${t.pathKey}`,
  })),
  ...countyBusinesses
    .filter((b) => Number.isFinite(Number(b.lat)) && Number.isFinite(Number(b.lng)))
    .map((b) => ({ label: b.name ?? "", lat: Number(b.lat), lng: Number(b.lng), primary: true })),
];
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo
    trail={[
      { name: "Home", path: "/" },
      { name: state.name, path: `/${state.slug}` },
      { name: county.name, path: `/${county.pathKey}` },
    ]}
  />

  <header class="mt-4">
    {heroPhoto && (
      <figure class="reveal overflow-hidden rounded-card border border-line">
        <div class="relative">
          <Pic src={heroPhoto.url} alt={heroPhoto.alt} aspect={21 / 9} sizes="(min-width: 1280px) 1152px, 100vw" priority class="max-h-[340px]" />
          <figcaption class="absolute bottom-0 right-0 rounded-tl-card bg-[#0f1a16]/70 px-3 py-1 text-[11px] text-white/90">
            {heroPhoto.caption} · <a href="/credits" class="underline">credit</a>
          </figcaption>
        </div>
      </figure>
    )}
    <div class="mt-6 max-w-prose">
      <h1 class="font-display text-4xl font-bold text-ink sm:text-5xl">{county.name} local services</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">{county.intro}</p>
    </div>
    <dl class="ledger mt-5 flex max-w-xl flex-wrap gap-x-8 gap-y-1 rounded-card border border-line bg-surface px-4 py-2">
      {county.population ? (
        <div class="flex gap-2"><dt class="ledger-key !flex-none">Population</dt><dd class="ledger-val">{Number(county.population).toLocaleString("en-US")}</dd></div>
      ) : null}
      <div class="flex gap-2"><dt class="ledger-key !flex-none">State</dt><dd class="ledger-val">{state.name}</dd></div>
      <div class="flex gap-2"><dt class="ledger-key !flex-none">Towns listed</dt><dd class="ledger-val">{towns.length}</dd></div>
      {registeredCount > 0 && (
        <div class="flex gap-2"><dt class="ledger-key !flex-none">On file</dt><dd class="ledger-val">{registeredCount.toLocaleString("en-US")} licensed · {countyBusinesses.length} verified &amp; claimed</dd></div>
      )}
    </dl>
  </header>

  <section class="mt-10" aria-labelledby="towns-heading">
    <h2 id="towns-heading" class="font-display text-2xl font-semibold text-ink">
      Browse by area
    </h2>
    <div class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
      <ul class="flex flex-wrap content-start gap-2">
        {towns.map((town) => (
          <li>
            <a
              href={`/${town.pathKey}`}
              class="inline-flex min-h-[40px] items-center rounded-chip border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-brand hover:bg-brand-wash"
            >
              {town.name}
            </a>
          </li>
        ))}
      </ul>
      <MiniMap client:visible points={mapPoints} className="h-72" />
    </div>
  </section>

  <section class="mt-12" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="font-display text-2xl font-semibold text-ink">
      Find a service in {county.name}
    </h2>
    {qualified.length > 0 ? (
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {qualified.map(({ category, count }) => (
          <li class="relative">
            <CategoryTile slug={category.slug} />
            <a href={`/${county.pathKey}/${category.slug}`} class="absolute inset-0" aria-label={`${category.name} in ${county.name} — ${count} listings`}></a>
            <span class="pointer-events-none absolute bottom-3 right-3 rounded-chip bg-surface px-2 py-0.5 text-xs font-semibold text-muted shadow-sm">{count}</span>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-5">
        <CategoriesEmptyState scopeName={county.name} />
      </div>
    )}
  </section>

  {countyBusinesses.length > 0 && (
    <section class="mt-12" aria-labelledby="verified-heading">
      <h2 id="verified-heading" class="font-display text-2xl font-semibold text-ink">
        Verified in {county.name}
      </h2>
      <p class="mt-1 text-sm text-muted">
        {countyBusinesses.length} published {countyBusinesses.length === 1 ? "listing" : "listings"} based in or serving the county.
      </p>
      <div class="mt-5 space-y-8">
        {bizGroups.map(({ category, items }, gi) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">
              {category?.name ?? "Other"} · {items.length}
            </h3>
            <div class="mt-3 grid gap-4">
              {items.map((b, i) => {
                const globalIndex = bizGroups.slice(0, gi).reduce((n, g) => n + g.items.length, 0) + i;
                return (
                  <div class:list={[globalIndex >= 12 && "hidden", globalIndex >= 12 && "hub-extra-biz"]}>
                    <ResultCard business={b} layout="horizontal" />
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
      {countyBusinesses.length > 12 && (
        <button
          type="button"
          id="hub-see-all"
          class="mt-4 rounded-chip border border-line-strong px-5 py-2 text-sm font-semibold text-ink hover:bg-inset"
        >
          See all {countyBusinesses.length}
        </button>
      )}
      <script is:inline data-astro-rerun>
        (function () {
          var btn = document.getElementById("hub-see-all");
          if (!btn) return;
          btn.addEventListener("click", function () {
            document.querySelectorAll(".hub-extra-biz").forEach(function (el) { el.classList.remove("hidden"); });
            btn.remove();
          });
        })();
      </script>
    </section>
  )}

  {countyEvents.length > 0 && (
    <section class="mt-12" aria-labelledby="events-heading">
      <h2 id="events-heading" class="font-display text-2xl font-semibold text-ink">
        Coming up in {county.name}
      </h2>
      <ul class="mt-4 space-y-2">
        {countyEvents.map((e) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-card border border-line bg-surface px-4 py-3">
            <span class="font-mono text-xs text-brand">{eventDateLabel(e)}</span>
            <span class="font-semibold text-ink">{e.title}</span>
            {isDemoEvent(e) && <span class="rounded-chip bg-warn-wash px-2 py-0.5 text-[11px] font-semibold uppercase text-warn">Sample</span>}
            <span class="text-sm text-faint">{e.venue}</span>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-sm">
        <a href="/events" class="font-medium text-brand underline underline-offset-2">All events</a>
      </p>
    </section>
  )}

  {registeredRows.length > 0 && (
    <RegistryTable
      heading={`Also licensed in ${county.name}: ${registeredCount.toLocaleString("en-US")} businesses on file`}
      rows={registeredRows}
      totalCount={registeredCount}
      tableId="hub-licensed"
      searchScope={{ stateSlug: state.slug, countySlug: county.slug }}
    />
  )}

  <section class="mt-12 max-w-prose" aria-labelledby="permits-heading">
    <h2 id="permits-heading" class="font-display text-2xl font-semibold text-ink">
      Permits &amp; licensing in {county.name}
    </h2>
    <p class="mt-3 leading-relaxed text-muted">{county.permitNotes}</p>
    <p class="mt-3 text-sm text-faint">
      Statewide rules are on the
      <a href={`/${state.slug}`} class="font-medium text-brand underline underline-offset-2">{state.name} hub</a>
      · every listing here passes
      <a href="/how-we-verify" class="font-medium text-brand underline underline-offset-2">our four verification checks</a>.
    </p>
  </section>

  {costGuide && (
    <div class="mt-12">
      <GuideSection guide={costGuide} />
    </div>
  )}

  <p class="mt-12 text-sm text-muted">
    Around {county.name}:
    <a href="/events" class="font-medium text-brand underline underline-offset-2">events</a> ·
    <a href="/deals" class="font-medium text-brand underline underline-offset-2">deals</a> ·
    <a href="/guides" class="font-medium text-brand underline underline-offset-2">guides</a> ·
    <a href="/awards" class="font-medium text-brand underline underline-offset-2">awards</a>
  </p>

  <div class="mt-6 max-w-md">
    <NewsletterSignup source={`county-${state.slug}-${county.slug}`} />
  </div>

  {nearby.length > 0 && (
    <section class="mt-12" aria-labelledby="nearby-heading">
      <h2 id="nearby-heading" class="font-display text-xl font-semibold text-ink">
        Nearby counties
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {nearby.map((c) => (
          <li>
            <a
              href={`/${c.pathKey}`}
              class="inline-flex min-h-[40px] items-center rounded-chip border border-line bg-surface px-4 py-2 text-sm font-medium text-muted transition-colors hover:border-brand hover:text-ink"
            >
              {c.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</article>
