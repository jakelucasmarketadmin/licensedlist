---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import MethodologyStrip from "@/components/site/MethodologyStrip.astro";
import CategoriesEmptyState from "@/components/site/CategoriesEmptyState.astro";
import ResultCard from "@/components/site/ResultCard.astro";
import PhIcon from "@/components/site/PhIcon.astro";
import { categoryArt } from "@/data/category-art";
import { blendedRating } from "@/lib/businesses";
import { getStates, getCountiesByState, getTownsByCounty } from "@/lib/geo";
import type { CategorySeed } from "@/lib/taxonomy";
import { fetchBusinesses, isPublished, categoriesOf, servesTown } from "@/lib/businesses";
import { getGuide } from "@/lib/guides";
import GuideSection from "@/components/site/GuideSection.astro";

interface Props {
  category: CategorySeed;
}
const { category } = Astro.props;
const states = getStates();
const sources = Object.entries(category.licenseSourcesByState);
const hiringGuide = getGuide("category", category.slug, "hiring-");
const costGuide = getGuide("category", category.slug, "cost-context-");

// A county chip links to its county×category page only when that page meets
// the 3-listing publishing rule — otherwise it links to the county hub, which
// always exists. Never link to a page that would 404.
const businesses = (await fetchBusinesses()).filter(
  (b) => isPublished(b) && categoriesOf(b).has(category.slug),
);
const art = categoryArt(category.slug);
const topRated = [...businesses]
  .sort((a, b) => (blendedRating(b) ?? 0) - (blendedRating(a) ?? 0))
  .slice(0, 6);
function countyCount(stateSlug: string, countySlug: string): number {
  if (businesses.length === 0) return 0;
  const townSlugs = new Set(getTownsByCounty(stateSlug, countySlug).map((t) => t.slug));
  return businesses.filter(
    (b) =>
      b.stateSlug === stateSlug &&
      (b.countySlug === countySlug ||
      (b.serviceTownSlugs ?? "")
        .split(",")
        .some((t) => townSlugs.has(t.trim()))),
  ).length;
}

/**
 * §1.7: link only to counties where this category actually has a listing.
 * /roofers previously linked all 25 counties while roofers existed in 3 —
 * 22 links spending crawl budget on hubs with nothing of the kind on them,
 * and a dead end for the reader. Counties with none are named in plain text
 * so the coverage is still honest, without the link.
 */
const countiesByState = states.map((state) => {
  const all = getCountiesByState(state.slug).map((county) => ({
    county,
    count: countyCount(state.slug, county.slug),
  }));
  return {
    state,
    covered: all.filter((c) => c.count > 0).sort((a, b) => b.count - a.count),
    uncovered: all.filter((c) => c.count === 0).map((c) => c.county),
  };
}).filter((g) => g.covered.length > 0 || g.uncovered.length > 0);
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo
    trail={[
      { name: "Home", path: "/" },
      { name: "Categories", path: "/categories" },
      { name: category.name, path: `/${category.slug}` },
    ]}
  />

  <header
    class="reveal mt-4 overflow-hidden rounded-card border border-line p-8"
    style={`background: linear-gradient(120deg, var(--tint-${art.tint}), color-mix(in srgb, var(--tint-${art.tint}) 40%, var(--surface)));`}
  >
    <div class="flex flex-wrap items-center gap-5">
      <PhIcon icon={art.icon} size={56} color="var(--ink)" />
      <div class="max-w-prose">
        <h1 class="font-display text-4xl font-bold text-ink sm:text-5xl">{category.name} in NJ, NY &amp; PA</h1>
        <p class="mt-3 text-lg leading-relaxed text-muted">
          {category.licenseRequired
            ? `A licensed trade in the tri-state area — every verified listing names the official registry we checked it against, and the date we checked.`
            : `No practitioner license applies to this category, so reputation matters more: we verify identity, read reviews across platforms, and confirm responsiveness before listing anyone.`}
        </p>
      </div>
    </div>
  </header>

  {topRated.length > 0 && (
    <section class="mt-10" aria-labelledby="toprated-heading">
      <h2 id="toprated-heading" class="font-display text-2xl font-semibold text-ink">
        Top rated across the tri-state
      </h2>
      <div class="mt-4 flex snap-x gap-4 overflow-x-auto pb-2">
        {topRated.map((b) => (
          <div class="w-[320px] flex-none snap-start sm:w-[360px]">
            <ResultCard business={b} showCategory />
          </div>
        ))}
      </div>
    </section>
  )}

  {sources.length > 0 && (
    <section class="mt-10 max-w-prose" aria-labelledby="lookup-heading">
      <h2 id="lookup-heading" class="font-display text-2xl font-semibold text-ink">
        Check a license yourself
      </h2>
      <p class="mt-2 text-sm text-muted">
        The registries we verify {category.name.toLowerCase()} against, by state:
      </p>
      <dl class="mt-4 space-y-3">
        {sources.map(([abbr, source]) => (
          <div class="grid gap-1 rounded-card border border-line bg-surface p-4 sm:grid-cols-[6rem_1fr] sm:gap-4">
            <dt class="font-mono text-sm font-medium text-ink">{abbr}</dt>
            <dd class="font-mono text-sm text-muted">{source}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <section class="mt-12" aria-labelledby="find-heading">
    <h2 id="find-heading" class="font-display text-2xl font-semibold text-ink">
      Find {category.name.toLowerCase()} near you
    </h2>
    <p class="mt-1 max-w-prose text-muted">
      Browse by county — town pages publish as soon as three verified businesses are behind them.
    </p>
    <div class="mt-5 grid gap-6 lg:grid-cols-3">
      {countiesByState.map(({ state, covered, uncovered }) => (
        <div>
          <h3 class="font-display text-lg font-semibold text-ink">
            <a href={`/${state.slug}`} class="hover:text-brand">{state.name}</a>
          </h3>
          {covered.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {covered.map(({ county, count }) => (
                <li>
                  <a
                    href={count >= 3 ? `/${county.pathKey}/${category.slug}` : `/${county.pathKey}`}
                    class="inline-block rounded-chip bg-inset px-2.5 py-1 text-xs font-medium text-muted transition-colors hover:bg-brand-wash hover:text-brand"
                  >
                    {county.name.replace(/ County$/, "")}
                    <span class="ml-1 text-[10px] text-faint">{count}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {uncovered.length > 0 && (
            <p class="mt-3 text-xs leading-relaxed text-faint">
              Not yet covered: {uncovered.map((c) => c.name.replace(/ County$/, "")).join(", ")}.
            </p>
          )}
        </div>
      ))}
    </div>
  </section>

  {hiringGuide && (
    <div class="mt-12">
      <GuideSection guide={hiringGuide} />
    </div>
  )}
  {costGuide && (
    <div class="mt-12">
      <GuideSection guide={costGuide} />
    </div>
  )}

  <div class="mt-12 max-w-prose">
    <CategoriesEmptyState scopeName={`this category`} />
  </div>

  <div class="mt-8">
    <MethodologyStrip />
  </div>
</article>
