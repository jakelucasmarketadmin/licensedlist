---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import TrustBadge from "@/components/site/TrustBadge.astro";
import QuoteRequestForm from "@/components/site/QuoteRequestForm.tsx";
import PhotoMosaic from "@/components/site/PhotoMosaic.astro";
import ReviewsSection from "@/components/site/ReviewsSection.astro";
import PhIcon from "@/components/site/PhIcon.astro";
import { SITE_NAME, SITE_URL, BUSINESS_CONTACT_EMAIL } from "@/lib/site";
import { jotformUpdateUrl } from "@/lib/jotform";
import MiniMap from "@/components/site/MiniMap.tsx";
import { getTown, getTownBySlug as getTownAnyCounty, getCounty, getState } from "@/lib/geo";
import { getCategory } from "@/lib/taxonomy";
import {
  type DirectoryBusiness,
  blendedRating,
  totalReviewCount,
  ratingSourcesLabel,
  isSponsoredPlacement,
  isDemo,
  isUnclaimed,
  licenseStatusLabel,
  publicSources,
  ratingReportedVia,
  listForTownCategory,
  listForCountyCategory,
  parseHours,
  additionalLicenses,
  photosOf,
  projectsOf,
  teamOf,
  faqOf,
} from "@/lib/businesses";
import {
  type SiteReview,
  type ServicePrice,
  siteAverage,
  highlightsOf,
  popularServices,
} from "@/lib/reviews";
import { quoteRequestsThisMonth } from "@/lib/leads";
import { offersForBusiness, offerExpiryLabel, isDemoOffer } from "@/lib/offers";
import { eventsForBusiness, eventDateLabel } from "@/lib/events";
import { awardsForBusiness, awardLabel, isDemoAward } from "@/lib/awards";
import { reviewSummaryFor } from "@/lib/summaries";
import { postsForBusiness } from "@/lib/posts";
import { imageAt, srcsetFor, lqipStyle } from "@/lib/images";

interface Props {
  business: DirectoryBusiness;
  trail: { name: string; path: string }[];
  reviews?: SiteReview[];
  servicePrices?: ServicePrice[];
}
const { business: b, trail, reviews = [], servicePrices = [] } = Astro.props;

const category = b.primaryCategorySlug ? getCategory(b.primaryCategorySlug) : undefined;
const town =
  b.stateSlug && b.countySlug && b.townSlug
    ? getTown(b.stateSlug, b.countySlug, b.townSlug)
    : undefined;
const county = b.stateSlug && b.countySlug ? getCounty(b.stateSlug, b.countySlug) : undefined;
const state = b.stateSlug ? getState(b.stateSlug) : undefined;

const externalRating = blendedRating(b);
const externalCount = totalReviewCount(b);
const sourcesLabel = ratingSourcesLabel(b);
const onSiteAvg = siteAverage(reviews);
const sponsored = isSponsoredPlacement(b);
const isClient = b.isClient === true || b.isClient === "true";
const claimFormUrl = jotformUpdateUrl(b.name, `${SITE_URL}/business/${b.slug}`);
const unclaimed = isUnclaimed(b);
// CMS TEXT fields return "" when unset — only a real positive number renders.
const responseHours = Number(b.responseTimeHours) > 0 ? Number(b.responseTimeHours) : null;
const sourcesLine = publicSources(b);
const quoteCount = await quoteRequestsThisMonth(b.slug ?? "");
const isPreviewReq = Astro.url.searchParams.get("preview") === "demo";
const [bizOffers, bizEvents, bizAwards, reviewSummary, bizPosts] = await Promise.all([
  offersForBusiness(b.slug ?? "", isPreviewReq),
  eventsForBusiness(b.slug ?? "", isPreviewReq),
  awardsForBusiness(b.slug ?? "", isPreviewReq),
  reviewSummaryFor(b.slug ?? "", reviews),
  postsForBusiness(b.slug ?? ""),
]);

const photos = photosOf(b);
const projects = projectsOf(b);
const team = teamOf(b);
const faq = faqOf(b);
const highlights = highlightsOf(b);
const popular = popularServices(b, reviews, 5).filter((c) => c.mentions > 0);

const DAY_LABELS: [string, string][] = [
  ["mon", "Monday"], ["tue", "Tuesday"], ["wed", "Wednesday"], ["thu", "Thursday"],
  ["fri", "Friday"], ["sat", "Saturday"], ["sun", "Sunday"],
];
const parsedHours = parseHours(b);
const hours: [string, string][] = parsedHours
  ? DAY_LABELS.filter(([k]) => parsedHours[k]).map(([k, label]) => [label, String(parsedHours[k])])
  : [];
const extraLicenses = additionalLicenses(b);
const serviceTowns = (b.serviceTownSlugs ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const serviceTownObjs = serviceTowns
  .map((slug) => (b.stateSlug && b.countySlug ? getTown(b.stateSlug, b.countySlug, slug) : undefined) ?? getTownAnyCounty(slug, b.stateSlug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
const serviceTownNames = serviceTownObjs.map((t) => t.name);
const visibleServiceTowns = serviceTownNames.slice(0, 6);
const hiddenServiceTowns = serviceTownNames.slice(6);
const profileMapPoints = [
  ...(Number.isFinite(Number(b.lat)) && Number.isFinite(Number(b.lng))
    ? [{ label: b.name ?? "", lat: Number(b.lat), lng: Number(b.lng), primary: true }]
    : []),
  ...serviceTownObjs.map((t) => ({ label: t.name, lat: Number(t.lat), lng: Number(t.lng) })),
];
const services = (b.services ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const priceBy = new Map(servicePrices.map((p) => [p.service?.toLowerCase(), p]));
const verifiedDate = b.licenseVerifiedAt
  ? new Date(b.licenseVerifiedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;
const lastVerified = b.lastVerifiedAt
  ? new Date(b.lastVerifiedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;

const townListOk =
  town && category
    ? (await listForTownCategory(town.stateSlug, town.slug, category.slug)).organic.length >= 3
    : false;
const countyListOk =
  county && state && category
    ? (await listForCountyCategory(state.slug, county.slug, category.slug)).organic.length >= 3
    : false;

// Tab bar renders only the sections this profile actually has.
const tabs = [
  { id: "overview", label: "Overview", show: true },
  { id: "services", label: "Services", show: services.length > 0 },
  { id: "photos-projects", label: "Photos & projects", show: projects.length > 0 || photos.length > 1 },
  { id: "verification", label: "Verification", show: true },
  { id: "reviews", label: "Reviews", show: true },
  { id: "hours-location", label: "Hours & location", show: true },
  { id: "team", label: "Team", show: team.length > 0 },
  { id: "faq", label: "FAQ", show: faq.length > 0 },
].filter((t) => t.show);
---

<article class="mx-auto max-w-6xl px-4 pb-24 pt-8 sm:px-6 md:pb-10 lg:pt-10" data-profile data-biz-slug={b.slug}>
  <BreadcrumbGeo trail={trail} />

  {isDemo(b) && (
    <p class="mt-4 rounded-card border border-warn bg-warn-wash px-4 py-3 text-sm font-medium text-warn">
      Sample listing — this is placeholder content used to preview the directory design, not a
      real business.
    </p>
  )}

  {unclaimed && (
    <div class="mt-4 flex flex-wrap items-center gap-3 rounded-card border border-line bg-inset px-4 py-3">
      <p class="min-w-0 flex-1 text-sm leading-relaxed text-muted">
        This listing was compiled from public records and the business's own website.
        {SITE_NAME} is not affiliated with this business. Is this your business?
      </p>
      <a href={claimFormUrl} target="_blank" rel="ugc nofollow noopener" class="shrink-0 rounded-chip bg-accent px-4 py-2 text-sm font-semibold text-accent-ink hover:bg-accent-hover">
        Claim it free
      </a>
    </div>
  )}

  <div class="mt-4">
    <PhotoMosaic photos={photos} name={b.name ?? "Business"} categorySlug={b.primaryCategorySlug} transitionName={`biz-photo-${b.slug}`} />
  </div>

  <header class="mt-6">
    <div class="flex flex-wrap items-center gap-3">
      {b.logoUrl && (
        <img src={b.logoUrl} alt="" width="56" height="56" loading="lazy" class="h-14 w-14 rounded-[10px] border border-line bg-surface object-contain" />
      )}
      <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">{b.name}</h1>
      {unclaimed && (
        <span class="rounded-chip border border-line bg-inset px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-faint" title="Compiled from public records and the business's own website — not yet claimed by the business.">
          Unclaimed
        </span>
      )}
      <TrustBadge
        licenseStatus={b.licenseStatus}
        licenseSource={b.licenseSource}
        licenseVerifiedAt={b.licenseVerifiedAt}
      />
      {bizAwards.map((a) => (
        <span class="rounded-chip bg-brand-deep px-2.5 py-1 text-xs font-semibold text-white" title="Data-driven annual award — computed from verified licenses and verified-hire reviews, never sold. Methodology at /awards.">
          🏆 {awardLabel(a)}{isDemoAward(a) ? " (sample)" : ""}
        </span>
      ))}
      {isClient ? (
        <span class="rounded-chip bg-inset px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-faint" title="This business is a client of the agency that operates this directory. Disclosed placements receive no ranking benefit.">
          Sponsored · client of the agency
        </span>
      ) : sponsored ? (
        <span class="rounded-chip bg-inset px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-faint">Sponsored</span>
      ) : null}
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      {onSiteAvg !== null && (
        <a href="#reviews" class="font-semibold text-ink hover:text-brand">
          {onSiteAvg}★ <span class="font-normal text-muted">({reviews.length} on-site {reviews.length === 1 ? "review" : "reviews"})</span>
        </a>
      )}
      {externalRating !== null && (
        <span>{externalRating}★ · {externalCount} reviews on {sourcesLabel}{unclaimed && `, as reported by ${ratingReportedVia(b)}`}</span>
      )}
      <span>
        {category?.name}
        {town && ` · ${town.name}, ${state?.abbr}`}
        {b.yearsInBusiness ? ` · ${b.yearsInBusiness} yrs in business` : ""}
      </span>
    </div>
    {serviceTownNames.length > 1 && (
      <p class="mt-1 text-sm text-muted">
        Serves {visibleServiceTowns.join(", ")}
        {hiddenServiceTowns.length > 0 && (
          <>
            <span id="serves-rest" hidden>, {hiddenServiceTowns.join(", ")}</span>
            <button type="button" id="serves-toggle" aria-expanded="false" aria-controls="serves-rest" class="ml-1 font-medium text-brand underline underline-offset-2">+{hiddenServiceTowns.length} more</button>
          </>
        )}
      </p>
    )}
  </header>

  <nav
    class="sticky top-16 z-30 -mx-4 mt-6 overflow-x-auto border-b border-line bg-paper px-4 sm:-mx-6 sm:px-6"
    style="scrollbar-width:none"
    aria-label="Profile sections"
    data-profile-tabs
  >
    <ul class="flex gap-1 whitespace-nowrap">
      {tabs.map((t, i) => (
        <li>
          <a
            href={`#${t.id}`}
            data-tab={t.id}
            class:list={[
              "inline-block border-b-2 px-3 py-3 text-sm font-medium transition-colors",
              i === 0 ? "border-brand text-brand" : "border-transparent text-muted hover:text-ink",
            ]}
          >
            {t.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="min-w-0 space-y-12">
      <section id="overview" class="scroll-mt-32" aria-labelledby="overview-h">
        <h2 id="overview-h" class="font-display text-2xl font-semibold text-ink">Overview</h2>
        {highlights.length > 0 && (
          <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {highlights.map((h) => (
              <li class="flex items-center gap-2.5 rounded-card border border-line bg-surface px-3 py-2.5">
                <PhIcon icon={h.icon} size={22} class="shrink-0 text-brand" />
                <span class="text-sm font-medium text-ink">{h.label}</span>
              </li>
            ))}
          </ul>
        )}
        <p class="mt-4 max-w-prose leading-relaxed text-muted">{b.description}</p>
        {b.whyWePicked && (
          <p class="mt-3 max-w-prose rounded-card border border-line bg-surface p-4 text-sm leading-relaxed text-muted">
            <span class="font-semibold text-ink">Why we picked them:</span> {b.whyWePicked}
          </p>
        )}
        {popular.length > 0 && (
          <p class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-faint">Popular</span>
            {popular.map((c) => (
              <span class="rounded-chip bg-brand-wash px-3 py-1 text-xs font-medium text-brand">{c.label}</span>
            ))}
            <span class="text-[11px] text-faint">— most mentioned in reviews</span>
          </p>
        )}
        {bizPosts.length > 0 && (
          <div class="mt-4 space-y-2">
            {bizPosts.map((p) => (
              <div class="rounded-card border border-line bg-surface px-4 py-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-faint">
                  What's new · {new Date(p._createdDate ?? Date.now()).toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-muted">{p.text}</p>
              </div>
            ))}
          </div>
        )}
        {bizOffers.length > 0 && (
          <div class="mt-4 space-y-2">
            {bizOffers.map((o) => (
              <div class="rounded-card border border-line-strong bg-warn-wash px-4 py-3">
                <p class="flex flex-wrap items-center gap-2 text-sm font-semibold text-ink">
                  <span class="rounded-chip bg-accent px-2 py-0.5 text-[11px] font-bold uppercase text-accent-ink">Deal</span>
                  {o.title}
                  {isDemoOffer(o) && <span class="rounded-chip bg-warn-wash px-2 py-0.5 text-[11px] font-semibold uppercase text-warn">Sample</span>}
                  {o.expiresAt && <span class="font-normal text-faint">{offerExpiryLabel(o)}</span>}
                </p>
                {o.details && <p class="mt-1 text-sm text-muted">{o.details}</p>}
                {o.terms && <p class="mt-1 text-[11px] text-faint">{o.terms}</p>}
              </div>
            ))}
          </div>
        )}
        {bizEvents.length > 0 && (
          <ul class="mt-4 space-y-2">
            {bizEvents.map((e) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-card border border-line bg-surface px-4 py-2.5 text-sm">
                <span class="font-mono text-xs text-brand">{eventDateLabel(e)}</span>
                <span class="font-semibold text-ink">{e.title}</span>
                <span class="text-faint">{e.venue}</span>
              </li>
            ))}
          </ul>
        )}
      </section>

      {services.length > 0 && (
        <section id="services" class="scroll-mt-32" aria-labelledby="services-h">
          <h2 id="services-h" class="font-display text-2xl font-semibold text-ink">Services</h2>
          {servicePrices.length > 0 ? (
            <div class="mt-4 overflow-hidden rounded-card border border-line">
              <table class="w-full text-sm">
                <caption class="sr-only">Services and typical prices</caption>
                <tbody>
                  {services.map((s) => {
                    const price = priceBy.get(s.toLowerCase());
                    return (
                      <tr class="border-b border-line bg-surface last:border-0">
                        <td class="px-4 py-2.5 font-medium text-ink">{s}</td>
                        <td class="px-4 py-2.5 text-right text-muted">
                          {price?.priceLabel ?? ""}
                          {price?.unit && <span class="text-faint"> / {price.unit}</span>}
                          {price?.note && <span class="block text-[11px] text-faint">{price.note}</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <p class="border-t border-line bg-inset px-4 py-2 text-[11px] text-faint">
                Prices are owner-provided typical ranges, not quotes — final cost depends on the job.
              </p>
            </div>
          ) : (
            <ul class="mt-4 flex flex-wrap gap-2">
              {services.map((s) => (
                <li class="rounded-chip bg-inset px-3 py-1 text-sm text-muted">{s}</li>
              ))}
            </ul>
          )}
        </section>
      )}

      {(projects.length > 0 || photos.length > 1) && (
        <section id="photos-projects" class="scroll-mt-32" aria-labelledby="projects-h">
          <h2 id="projects-h" class="font-display text-2xl font-semibold text-ink">Photos &amp; projects</h2>
          {projects.length > 0 && (
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {projects.map((p) => (
                <article class="flex flex-col overflow-hidden rounded-card border border-line bg-surface">
                  {p.beforePhoto && p.afterPhoto ? (
                    <div class="grid grid-cols-2 gap-0.5">
                      <figure class="relative">
                        <img src={imageAt(p.beforePhoto, 500)} srcset={srcsetFor(p.beforePhoto)} sizes="(min-width:640px) 25vw, 50vw" alt={`${p.title} — before`} loading="lazy" decoding="async" class="aspect-[8/9] w-full object-cover" />
                        <figcaption class="absolute left-2 top-2 rounded-chip bg-brand-deep/80 px-2 py-0.5 text-[11px] font-semibold text-white">Before</figcaption>
                      </figure>
                      <figure class="relative">
                        <img src={imageAt(p.afterPhoto, 500)} srcset={srcsetFor(p.afterPhoto)} sizes="(min-width:640px) 25vw, 50vw" alt={`${p.title} — after`} loading="lazy" decoding="async" class="aspect-[8/9] w-full object-cover" />
                        <figcaption class="absolute left-2 top-2 rounded-chip bg-[#177245] px-2 py-0.5 text-[11px] font-semibold text-white">After</figcaption>
                      </figure>
                    </div>
                  ) : (p.photos ?? []).length > 0 ? (
                    <img src={imageAt((p.photos ?? [])[0], 960, 540)} srcset={srcsetFor((p.photos ?? [])[0], 16 / 9)} sizes="(min-width:640px) 50vw, 100vw" alt={`${p.title} — photo`} loading="lazy" decoding="async" class="aspect-video w-full object-cover" style={lqipStyle((p.photos ?? [])[0])} />
                  ) : null}
                  <div class="p-4">
                    <h3 class="font-display text-lg font-semibold text-ink">{p.title}</h3>
                    <p class="mt-0.5 text-xs text-faint">
                      {[p.town, p.date].filter(Boolean).join(" · ")}
                    </p>
                    {p.description && <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>}
                  </div>
                </article>
              ))}
            </div>
          )}
          {projects.length === 0 && photos.length > 1 && (
            <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
              {photos.slice(0, 9).map((p, i) => (
                <img src={imageAt(p, 500)} srcset={srcsetFor(p)} sizes="(min-width:640px) 25vw, 50vw" alt={`${b.name} — photo ${i + 1}`} loading="lazy" decoding="async" class="aspect-[4/3] w-full cursor-zoom-in rounded-[10px] object-cover" data-mosaic-open={String(i)} />
              ))}
            </div>
          )}
        </section>
      )}

      <section id="verification" class="scroll-mt-32" aria-labelledby="verification-h">
        <h2 id="verification-h" class="font-display text-2xl font-semibold text-ink">Verification record</h2>
        <div class="mt-4 rounded-card border border-line-strong bg-surface p-5">
          <div class="ledger rounded-[10px] bg-inset px-3 py-1.5">
            <div class="ledger-row">
              <span class="ledger-key">Status</span>
              <span class="ledger-val">{licenseStatusLabel(b.licenseStatus)}</span>
            </div>
            {b.licenseNumber && (
              <div class="ledger-row">
                <span class="ledger-key">License</span>
                <span class="ledger-val">{b.licenseNumber}</span>
              </div>
            )}
            {b.licenseSource && (
              <div class="ledger-row">
                <span class="ledger-key">Source</span>
                <span class="ledger-val">{b.licenseSource}</span>
              </div>
            )}
            {verifiedDate && (
              <div class="ledger-row">
                <span class="ledger-key">Checked</span>
                <span class="ledger-val">{verifiedDate}</span>
              </div>
            )}
            {extraLicenses.map((l) => (
              <div class="ledger-row">
                <span class="ledger-key">{l.label ?? "License"}</span>
                <span class="ledger-val">
                  {l.number}
                  {l.source ? ` · ${l.source}` : ""}
                  {l.verifiedAt ? ` · checked ${new Date(l.verifiedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })}` : ""}
                </span>
              </div>
            ))}
            {lastVerified && (
              <div class="ledger-row">
                <span class="ledger-key">Reviewed</span>
                <span class="ledger-val">{lastVerified}</span>
              </div>
            )}
          </div>
          {b.licenseHolder && <p class="mt-3 text-xs leading-relaxed text-muted">{b.licenseHolder}</p>}
          {/* The HICPA caveat belongs to PA Attorney General contractor
              registrations only — not to every PA listing (a PALS cosmetology
              license is a different regime entirely). */}
          {/HICPA|Attorney General/i.test(b.licenseSource ?? "") && (
            <p class="mt-3 text-xs leading-relaxed text-muted">
              Pennsylvania note: HICPA registration with the PA Attorney General confirms identity
              and insurance on file — it is a registration, not a competency license.
            </p>
          )}
          {isClient && (
            <p class="mt-3 border-t border-line pt-3 text-xs leading-relaxed text-muted">
              Disclosure: this business is a client of the agency that operates {SITE_NAME}.
              Client listings are always labeled and receive no ranking benefit.
            </p>
          )}
          <p class="mt-3 text-xs leading-relaxed text-faint">
            Licenses can lapse after our check — every badge names its registry so you can repeat
            the lookup. <a href="/how-we-verify" class="underline">How we verify</a>
          </p>
        </div>

        {unclaimed && (
          <div class="mt-4 rounded-card border border-line bg-surface p-5">
            <h3 class="font-display text-lg font-semibold text-ink">Where this came from</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {sourcesLine ?? "Compiled from the business's own website and public records."}
              {" "}Nobody at this business has reviewed or approved this listing yet — details
              can be out of date until it's claimed.
            </p>
            <p class="mt-2 text-xs text-faint">
              Own this business? <a href={claimFormUrl} target="_blank" rel="ugc nofollow noopener" class="underline">Claim it free</a> to
              correct anything — or <a href={`/remove-listing?biz=${b.slug}`} rel="nofollow" class="underline">ask us to remove it</a>.
            </p>
          </div>
        )}
      </section>

      <section id="reviews" class="scroll-mt-32">
        <ReviewsSection business={b} reviews={reviews} summary={reviewSummary} />
      </section>

      <section id="hours-location" class="scroll-mt-32" aria-labelledby="hours-h">
        <h2 id="hours-h" class="font-display text-2xl font-semibold text-ink">Hours &amp; location</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="rounded-card border border-line bg-surface p-5">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-lg font-semibold text-ink">Hours</h3>
              {hours.length > 0 && (
                <span data-open-now data-hours={JSON.stringify(parsedHours)} class="hidden rounded-chip px-2 py-0.5 text-[11px] font-semibold"></span>
              )}
            </div>
            {hours.length > 0 ? (
              <dl class="mt-3 space-y-1 text-sm">
                {hours.map(([day, value]) => (
                  <div class="flex justify-between gap-3">
                    <dt class="text-faint">{day}</dt>
                    <dd class="text-muted">{String(value).toLowerCase() === "closed" ? "Closed" : value}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="mt-3 text-sm text-faint">Hours not provided</p>
            )}
          </div>
          <div class="rounded-card border border-line bg-surface p-5">
            <h3 class="font-display text-lg font-semibold text-ink">Location &amp; service area</h3>
            {b.address1 && (
              <p class="mt-2 text-sm text-muted">{b.address1}{b.address2 ? `, ${b.address2}` : ""}, {b.city}, {b.state} {b.zip}</p>
            )}
            {profileMapPoints.length > 0 && (
              <div class="mt-3">
                <MiniMap client:visible points={profileMapPoints} className="h-48" />
              </div>
            )}
            {serviceTownNames.length > 0 && (
              <p class="mt-2 text-xs text-faint">Serves {serviceTownNames.length} {serviceTownNames.length === 1 ? "town" : "towns"} · accent dot = home base</p>
            )}
          </div>
        </div>
      </section>

      {team.length > 0 && (
        <section id="team" class="scroll-mt-32" aria-labelledby="team-h">
          <h2 id="team-h" class="font-display text-2xl font-semibold text-ink">Team</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {team.map((m) => (
              <li class="flex gap-4 rounded-card border border-line bg-surface p-4">
                {m.photo && (
                  <img src={imageAt(m.photo, 250)} alt={`${m.name}${m.role ? `, ${m.role}` : ""}`} loading="lazy" decoding="async" class="h-16 w-16 shrink-0 rounded-full border border-line object-cover" />
                )}
                <div>
                  <p class="font-semibold text-ink">{m.name}</p>
                  {m.role && <p class="text-xs text-faint">{m.role}</p>}
                  {m.bio && <p class="mt-1.5 text-sm leading-relaxed text-muted">{m.bio}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {faq.length > 0 && (
        <section id="faq" class="scroll-mt-32" aria-labelledby="faq-h">
          <h2 id="faq-h" class="font-display text-2xl font-semibold text-ink">FAQ</h2>
          <div class="mt-4 space-y-2">
            {faq.map((f) => (
              <details class="group rounded-card border border-line bg-surface px-4 py-3">
                <summary class="cursor-pointer list-none text-sm font-semibold text-ink marker:content-none">
                  <span class="mr-2 inline-block text-faint transition-transform group-open:rotate-90">›</span>{f.q}
                </summary>
                <p class="mt-2 pl-5 text-sm leading-relaxed text-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {town && category && (townListOk || countyListOk) && (
        <p class="text-sm text-muted">
          More
          {townListOk ? (
            <a href={`/${town.pathKey}/${category.slug}`} class="font-medium text-brand underline underline-offset-2">
              {category.name.toLowerCase()} in {town.name}
            </a>
          ) : (
            <a href={`/${town.pathKey}`} class="font-medium text-brand underline underline-offset-2">
              local businesses in {town.name}
            </a>
          )}
          {county && countyListOk && (
            <>
              {" "}or across
              <a href={`/${county.pathKey}/${category.slug}`} class="font-medium text-brand underline underline-offset-2">{county.name}</a>
            </>
          )}.
        </p>
      )}
    </div>

    <aside class="space-y-4">
      <div class="lg:sticky lg:top-32">
        <div id="quote" class="scroll-mt-32 rounded-card border border-line-strong bg-surface p-5 shadow-sm">
          <div class="flex flex-wrap gap-2">
            {b.phone && (
              <a href={`tel:${b.phone.replace(/[^+\d]/g, "")}`} class="flex-1 rounded-chip bg-accent px-4 py-2.5 text-center text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover">
                Call {b.phone}
              </a>
            )}
            {b.email && (
              <a href={`mailto:${b.email}`} data-email-biz class="rounded-chip border border-line-strong px-4 py-2.5 text-sm font-semibold text-ink hover:bg-inset">
                Email
              </a>
            )}
            {b.website && (
              <a href={b.website} rel={sponsored ? "sponsored nofollow" : "nofollow"} /* paid placement only */ target="_blank" class="rounded-chip border border-line-strong px-4 py-2.5 text-sm font-semibold text-ink hover:bg-inset">
                Website
              </a>
            )}
          </div>
          {(b.phone || b.email) && (
            <p class="mt-2 text-xs leading-relaxed text-faint">
              Contact {b.name} directly — {SITE_NAME} doesn't sit in the middle of the
              conversation.
            </p>
          )}
          <div class="mt-2 flex gap-2">
            <button type="button" data-save-biz aria-pressed="false" class="flex-1 rounded-chip border border-line px-3 py-2 text-sm font-medium text-muted transition-colors hover:border-brand hover:text-ink aria-pressed:border-brand aria-pressed:bg-brand-wash aria-pressed:text-brand">
              ♡ Save
            </button>
            <button type="button" data-share-biz class="flex-1 rounded-chip border border-line px-3 py-2 text-sm font-medium text-muted transition-colors hover:border-brand hover:text-ink">
              Share
            </button>
          </div>
          {(responseHours != null || (quoteCount ?? 0) > 0) && (
            <p class="mt-3 text-xs leading-relaxed text-muted">
              {responseHours != null && `Typically responds in ~${responseHours} ${responseHours === 1 ? "hr" : "hrs"}.`}
              {(quoteCount ?? 0) > 0 && ` ${quoteCount} ${quoteCount === 1 ? "person" : "people"} requested a quote this month.`}
            </p>
          )}
          {unclaimed ? (
            <div class="mt-4 border-t border-line pt-4">
              <h3 class="font-display text-lg font-semibold text-ink">Quote requests are off</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                This business hasn't claimed its listing, so we can't promise anyone will answer
                a quote request — call directly instead.
              </p>
              <p class="mt-3 rounded-[10px] bg-brand-wash px-3 py-2.5 text-sm leading-relaxed text-ink">
                <span class="font-semibold">Own this business?</span> Claim the listing free to
                receive quote requests from {SITE_NAME} visitors.
              </p>
              <a href={claimFormUrl} target="_blank" rel="ugc nofollow noopener" class="mt-3 inline-block rounded-chip bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink hover:bg-accent-hover">
                Claim this listing
              </a>
            </div>
          ) : (
            <div class="mt-4 border-t border-line pt-4">
              <QuoteRequestForm
                client:load
                businessSlug={b.slug}
                businessName={b.name}
                categorySlug={b.primaryCategorySlug}
                townSlug={b.townSlug}
                responseTimeHours={responseHours}
              />
            </div>
          )}
        </div>

        <div class="mt-4 rounded-card bg-brand-deep p-5 text-white">
          <h2 class="font-display text-lg font-semibold">Is this your business?</h2>
          <p class="mt-2 text-sm leading-relaxed text-white/80">
            Claim your listing free to correct details and respond to reviews.
          </p>
          <a href={claimFormUrl} target="_blank" rel="ugc nofollow noopener" class="mt-3 inline-block rounded-chip bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink hover:bg-accent-hover">
            Claim this listing
          </a>
          <p class="mt-2 text-xs text-white/60">
            Or email <a href={`mailto:${BUSINESS_CONTACT_EMAIL}`} class="underline">{BUSINESS_CONTACT_EMAIL}</a>
          </p>
          {unclaimed && (
            <p class="mt-3 border-t border-white/20 pt-3 text-xs text-white/60">
              Not interested? <a href={`/remove-listing?biz=${b.slug}`} rel="nofollow" class="underline">Remove this listing</a> —
              honored within 2 business days, no questions.
            </p>
          )}
        </div>
      </div>
    </aside>
  </div>

  <div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:hidden" data-mobile-bar>
    {b.phone && (
      <a href={`tel:${b.phone.replace(/[^+\d]/g, "")}`} class="flex-1 rounded-chip bg-accent px-4 py-2.5 text-center text-sm font-semibold text-accent-ink">
        Call now
      </a>
    )}
    {b.email && (
      <a href={`mailto:${b.email}`} data-email-biz class="flex-1 rounded-chip border border-line-strong px-4 py-2.5 text-center text-sm font-semibold text-ink">
        Email
      </a>
    )}
    {unclaimed ? (
      <a href={claimFormUrl} target="_blank" rel="ugc nofollow noopener" class="flex-1 rounded-chip border border-line-strong px-4 py-2.5 text-center text-sm font-semibold text-ink">
        Claim listing
      </a>
    ) : (
      <a href="#quote" class="flex-1 rounded-chip border border-line-strong px-4 py-2.5 text-center text-sm font-semibold text-ink">
        Get a quote
      </a>
    )}
  </div>

  <script is:inline data-astro-rerun>
    (function () {
      var root = document.querySelector("[data-profile]");
      if (!root || root.dataset.wired) return;
      root.dataset.wired = "1";
      var slug = root.getAttribute("data-biz-slug") || "";

      // First-party metrics (Batch E) — day-bucketed counters, no PII.
      function track(type) {
        try {
          fetch("/api/track", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ type: type, businessSlug: slug }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      }
      track("profile_view");
      root.querySelectorAll('a[href^="tel:"]').forEach(function (a) {
        a.addEventListener("click", function () { track("call_click"); });
      });
      root.querySelectorAll('a[target="_blank"][href^="http"]').forEach(function (a) {
        if (/jotform/.test(a.href)) return;
        a.addEventListener("click", function () { track("website_click"); });
      });

      // Serves-towns expand
      var toggle = document.getElementById("serves-toggle");
      var rest = document.getElementById("serves-rest");
      if (toggle && rest)
        toggle.addEventListener("click", function () {
          var expanded = toggle.getAttribute("aria-expanded") === "true";
          rest.hidden = expanded;
          toggle.textContent = expanded ? "+" + rest.textContent.split(",").filter(Boolean).length + " more" : "show fewer";
          toggle.setAttribute("aria-expanded", String(!expanded));
        });

      // Tab scrollspy
      var links = Array.prototype.slice.call(root.querySelectorAll("[data-tab]"));
      var sections = links
        .map(function (l) { return document.getElementById(l.getAttribute("data-tab")); })
        .filter(Boolean);
      function setActive(id) {
        links.forEach(function (l) {
          var on = l.getAttribute("data-tab") === id;
          l.classList.toggle("border-brand", on);
          l.classList.toggle("text-brand", on);
          l.classList.toggle("border-transparent", !on);
          l.classList.toggle("text-muted", !on);
        });
      }
      if ("IntersectionObserver" in window && sections.length) {
        var current = sections[0].id;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) current = e.target.id; });
            setActive(current);
          },
          { rootMargin: "-15% 0px -70% 0px" }
        );
        sections.forEach(function (s) { io.observe(s); });
      }

      // Save (localStorage) + Share
      var saveBtn = root.querySelector("[data-save-biz]");
      if (saveBtn) {
        var KEY = "tv-saved";
        var read = function () {
          try { return JSON.parse(localStorage.getItem(KEY) || "[]"); } catch (e) { return []; }
        };
        var render = function () {
          var saved = read().indexOf(slug) !== -1;
          saveBtn.setAttribute("aria-pressed", String(saved));
          saveBtn.textContent = saved ? "♥ Saved" : "♡ Save";
        };
        saveBtn.addEventListener("click", function () {
          var cur = read();
          var i = cur.indexOf(slug);
          if (i === -1) { cur.push(slug); track("save"); } else cur.splice(i, 1);
          try { localStorage.setItem(KEY, JSON.stringify(cur)); } catch (e) {}
          render();
        });
        render();
      }
      var shareBtn = root.querySelector("[data-share-biz]");
      if (shareBtn)
        shareBtn.addEventListener("click", function () {
          track("share");
          var url = location.origin + location.pathname;
          if (navigator.share) {
            navigator.share({ title: document.title, url: url }).catch(function () {});
          } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () {
              shareBtn.textContent = "Link copied";
              setTimeout(function () { shareBtn.textContent = "Share"; }, 2000);
            });
          }
        });

      // Open now (America/New_York)
      var openEl = root.querySelector("[data-open-now]");
      if (openEl) {
        try {
          var hoursMap = JSON.parse(openEl.getAttribute("data-hours"));
          var now = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
          var day = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"][now.getDay()];
          var span = (hoursMap[day] || "").toLowerCase();
          var open = false;
          var m = span.match(/^(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})$/);
          if (m) {
            var mins = now.getHours() * 60 + now.getMinutes();
            open = mins >= Number(m[1]) * 60 + Number(m[2]) && mins < Number(m[3]) * 60 + Number(m[4]);
          }
          openEl.classList.remove("hidden");
          openEl.classList.add(open ? "bg-[#177245]" : "bg-inset");
          openEl.classList.add(open ? "text-white" : "text-muted");
          openEl.textContent = open ? "Open now" : "Closed now";
        } catch (e) { /* leave hidden */ }
      }
    })();
  </script>
</article>
