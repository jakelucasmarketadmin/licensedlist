---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import TrustBadge from "@/components/site/TrustBadge.astro";
import QuoteRequestForm from "@/components/site/QuoteRequestForm.tsx";
import { SITE_NAME, BUSINESS_CONTACT_EMAIL } from "@/lib/site";
import { getTown, getCounty, getState } from "@/lib/geo";
import { getCategory } from "@/lib/taxonomy";
import {
  type DirectoryBusiness,
  blendedRating,
  ratingSourcesLabel,
  isSponsoredPlacement,
  isDemo,
  listForTownCategory,
  listForCountyCategory,
} from "@/lib/businesses";

interface Props {
  business: DirectoryBusiness;
  trail: { name: string; path: string }[];
}
const { business: b, trail } = Astro.props;

const category = b.primaryCategorySlug ? getCategory(b.primaryCategorySlug) : undefined;
const town =
  b.stateSlug && b.countySlug && b.townSlug
    ? getTown(b.stateSlug, b.countySlug, b.townSlug)
    : undefined;
const county = b.stateSlug && b.countySlug ? getCounty(b.stateSlug, b.countySlug) : undefined;
const state = b.stateSlug ? getState(b.stateSlug) : undefined;

const rating = blendedRating(b);
const sourcesLabel = ratingSourcesLabel(b);
const sponsored = isSponsoredPlacement(b);
const isClient = b.isClient === true || b.isClient === "true";

const DAY_LABELS: [string, string][] = [
  ["mon", "Monday"], ["tue", "Tuesday"], ["wed", "Wednesday"], ["thu", "Thursday"],
  ["fri", "Friday"], ["sat", "Saturday"], ["sun", "Sunday"],
];
let hours: [string, string][] = [];
try {
  const parsed = b.hoursJson ? JSON.parse(b.hoursJson) : null;
  if (parsed && typeof parsed === "object") {
    hours = DAY_LABELS.filter(([k]) => parsed[k]).map(([k, label]) => [label, String(parsed[k])]);
  }
} catch { /* malformed hoursJson renders nothing */ }
const serviceTowns = (b.serviceTownSlugs ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const services = (b.services ?? "").split(",").map((s) => s.trim()).filter(Boolean);
const verifiedDate = b.licenseVerifiedAt
  ? new Date(b.licenseVerifiedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;
const lastVerified = b.lastVerifiedAt
  ? new Date(b.lastVerifiedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;

// Cross-links only when the target list page meets the publishing rule.
const townListOk =
  town && category
    ? (await listForTownCategory(town.slug, category.slug)).organic.length >= 3
    : false;
const countyListOk =
  county && state && category
    ? (await listForCountyCategory(state.slug, county.slug, category.slug)).organic.length >= 3
    : false;
---

<article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={trail} />

  {isDemo(b) && (
    <p class="mt-4 rounded-card border border-warn bg-warn-wash px-4 py-3 text-sm font-medium text-warn">
      Sample listing — this is placeholder content used to preview the directory design, not a
      real business.
    </p>
  )}

  {isClient && (
    <p class="mt-4 rounded-card border border-line bg-inset px-4 py-3 text-sm text-muted">
      Disclosure: this business is a client of the agency that operates {SITE_NAME}. Client
      listings are always labeled and receive no ranking benefit.
    </p>
  )}

  <header class="mt-4">
    <div class="flex flex-wrap items-center gap-3">
      {b.logoUrl && (
        <img src={b.logoUrl} alt="" width="56" height="56" loading="lazy" class="h-14 w-14 rounded-[10px] border border-line object-contain bg-surface" />
      )}
      <h1 class="font-display text-4xl font-bold text-ink">{b.name}</h1>
      {isClient ? (
        <span class="rounded-chip bg-inset px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-faint">
          Sponsored · client of the agency
        </span>
      ) : sponsored ? (
        <span class="rounded-chip bg-inset px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-faint">
          Sponsored
        </span>
      ) : null}
    </div>
    <p class="mt-2 text-muted">
      {category?.name}
      {town && ` · ${town.name}, ${state?.abbr}`}
      {serviceTowns.length > 1 && ` · serves ${serviceTowns.length} towns`}
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <TrustBadge
        licenseStatus={b.licenseStatus}
        licenseSource={b.licenseSource}
        licenseVerifiedAt={b.licenseVerifiedAt}
      />
      {rating !== null && (
        <span class="text-sm text-ink">
          <span class="font-semibold">{rating}★</span>
          <span class="text-muted"> across {sourcesLabel}</span>
        </span>
      )}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      {b.phone && (
        <a
          href={`tel:${b.phone.replace(/[^+\d]/g, "")}`}
          class="rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
        >
          Call {b.phone}
        </a>
      )}
      {b.website && (
        <a
          href={b.website}
          rel={sponsored ? "sponsored nofollow" : "nofollow"}
          target="_blank"
          class="rounded-chip border border-line-strong px-6 py-3 text-base font-semibold text-ink hover:bg-inset"
        >
          Visit website
        </a>
      )}
    </div>
  </header>

  <section class="mt-10 grid gap-6 md:grid-cols-[1fr_320px]">
    <div class="space-y-8">
      <div class="max-w-prose">
        <h2 class="font-display text-2xl font-semibold text-ink">About</h2>
        <p class="mt-3 leading-relaxed text-muted">{b.description}</p>
        {b.whyWePicked && (
          <p class="mt-3 rounded-card border border-line bg-surface p-4 text-sm leading-relaxed text-muted">
            <span class="font-semibold text-ink">Why we picked them:</span> {b.whyWePicked}
          </p>
        )}
      </div>

      {services.length > 0 && (
        <div>
          <h2 class="font-display text-xl font-semibold text-ink">Services</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {services.map((s) => (
              <li class="rounded-chip bg-inset px-3 py-1 text-sm text-muted">{s}</li>
            ))}
          </ul>
        </div>
      )}

      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Reviews</h2>
        {rating !== null ? (
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {[
              b.ratingGoogle && b.ratingGoogleCount
                ? `${b.ratingGoogle}★ across ${b.ratingGoogleCount} Google reviews`
                : null,
              b.ratingYelp && b.ratingYelpCount
                ? `${b.ratingYelp}★ across ${b.ratingYelpCount} Yelp reviews`
                : null,
              b.ratingFacebook && b.ratingFacebookCount
                ? `${b.ratingFacebook}★ across ${b.ratingFacebookCount} Facebook reviews`
                : null,
            ].filter(Boolean).join(", ").replace(/, ([^,]*)$/, " and $1")}
            — we read reviews across platforms for patterns and never edit, filter, or reorder
            them.
          </p>
        ) : (
          <p class="mt-3 text-sm text-faint">Not enough review data yet.</p>
        )}
        <p class="mt-2 text-sm text-faint">
          Verified-hire reviews collected through {SITE_NAME} are coming soon — invitations go to
          every customer, never only the happy ones.
        </p>
      </div>
    </div>

    <aside class="space-y-4">
      <div class="rounded-card border border-line-strong bg-surface p-5">
        <QuoteRequestForm
          client:load
          businessSlug={b.slug}
          businessName={b.name}
          categorySlug={b.primaryCategorySlug}
          townSlug={b.townSlug}
          responseTimeHours={b.responseTimeHours}
        />
      </div>

      <div class="rounded-card border border-line-strong bg-surface p-5">
        <h2 class="font-display text-lg font-semibold text-ink">Verification record</h2>
        <div class="ledger mt-3 rounded-[10px] bg-inset px-3 py-1.5">
          <div class="ledger-row">
            <span class="ledger-key">Status</span>
            <span class="ledger-val">{b.licenseStatus ?? "unknown"}</span>
          </div>
          {b.licenseNumber && (
            <div class="ledger-row">
              <span class="ledger-key">License</span>
              <span class="ledger-val">{b.licenseNumber}</span>
            </div>
          )}
          {b.licenseSource && (
            <div class="ledger-row">
              <span class="ledger-key">Source</span>
              <span class="ledger-val">{b.licenseSource}</span>
            </div>
          )}
          {verifiedDate && (
            <div class="ledger-row">
              <span class="ledger-key">Checked</span>
              <span class="ledger-val">{verifiedDate}</span>
            </div>
          )}
          {lastVerified && (
            <div class="ledger-row">
              <span class="ledger-key">Reviewed</span>
              <span class="ledger-val">{lastVerified}</span>
            </div>
          )}
        </div>
        <p class="mt-3 text-xs leading-relaxed text-faint">
          Licenses can lapse after our check — every badge names its registry so you can repeat
          the lookup. <a href="/how-we-verify" class="underline">How we verify</a>
        </p>
      </div>

      {hours.length > 0 && (
        <div class="rounded-card border border-line bg-surface p-5">
          <h2 class="font-display text-lg font-semibold text-ink">Hours</h2>
          <dl class="mt-3 space-y-1 text-sm">
            {hours.map(([day, value]) => (
              <div class="flex justify-between gap-3">
                <dt class="text-faint">{day}</dt>
                <dd class="text-muted">{value === "closed" ? "Closed" : value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      <div class="rounded-card border border-line bg-surface p-5">
        <h2 class="font-display text-lg font-semibold text-ink">Details</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {b.address1 && (
            <div class="flex gap-2">
              <dt class="shrink-0 text-faint">Address</dt>
              <dd class="text-muted">{b.address1}{b.address2 ? `, ${b.address2}` : ""}, {b.city}, {b.state} {b.zip}</dd>
            </div>
          )}
          {b.responseTimeHours != null && (
            <div class="flex gap-2">
              <dt class="shrink-0 text-faint">Responds</dt>
              <dd class="text-muted">in about {b.responseTimeHours} {b.responseTimeHours === 1 ? "hour" : "hours"}</dd>
            </div>
          )}
          {b.yearsInBusiness && (
            <div class="flex gap-2">
              <dt class="shrink-0 text-faint">In business</dt>
              <dd class="text-muted">{b.yearsInBusiness} years{b.foundedYear ? ` (since ${b.foundedYear})` : ""}</dd>
            </div>
          )}
        </dl>
      </div>

      <div class="rounded-card bg-brand-deep p-5 text-white">
        <h2 class="font-display text-lg font-semibold">Is this your business?</h2>
        <p class="mt-2 text-sm leading-relaxed text-white/80">
          Claim your listing free to correct details and respond to reviews.
        </p>
        <a
          href={`/claim/${b.slug}`}
          class="mt-3 inline-block rounded-chip bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink hover:bg-accent-hover"
        >
          Claim this listing
        </a>
        <p class="mt-2 text-xs text-white/60">
          Or email <a href={`mailto:${BUSINESS_CONTACT_EMAIL}`} class="underline">{BUSINESS_CONTACT_EMAIL}</a>
        </p>
      </div>
    </aside>
  </section>

  {town && category && (townListOk || countyListOk) && (
    <p class="mt-10 text-sm text-muted">
      More
      {townListOk ? (
        <a href={`/${town.pathKey}/${category.slug}`} class="font-medium text-brand underline underline-offset-2">
          {category.name.toLowerCase()} in {town.name}
        </a>
      ) : (
        <a href={`/${town.pathKey}`} class="font-medium text-brand underline underline-offset-2">
          local businesses in {town.name}
        </a>
      )}
      {county && countyListOk && (
        <>
          {" "}or across
          <a href={`/${county.pathKey}/${category.slug}`} class="font-medium text-brand underline underline-offset-2">
            {county.name}
          </a>
        </>
      )}.
    </p>
  )}
</article>
