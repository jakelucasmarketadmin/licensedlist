---
import HeroSearch from "@/components/site/HeroSearch.astro";
import ShowcaseListing from "@/components/site/ShowcaseListing.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import ResultCard from "@/components/site/ResultCard.astro";
import Pic from "@/components/site/Pic.astro";
import { getStates, getCountiesByState, getAllTowns } from "@/lib/geo";
import { fetchBusinesses, isPublished, blendedRating } from "@/lib/businesses";
import { latestGuides } from "@/lib/guides";
import { homeHeroPhotos } from "@/lib/town-photos";
import { categoryArt } from "@/data/category-art";

const states = getStates();

// Live meta line — real counts, never invented.
let published: Awaited<ReturnType<typeof fetchBusinesses>> = [];
try {
  published = (await fetchBusinesses()).filter(isPublished);
} catch { /* counts fall back to zero-safe copy */ }
const verifiedCount = published.filter((b) => b.licenseStatus === "verified").length;
const townCount = getAllTowns().length;
const registryCount = new Set(
  published.filter((b) => b.licenseStatus === "verified").map((b) => b.licenseSource).filter(Boolean),
).size;

// Rotate the hero photo by time of day (server hour; page caches ~60s).
const heroPool = homeHeroPhotos(5);
const heroPhoto = heroPool.length
  ? heroPool[new Date().getHours() % heroPool.length]
  : undefined;

// County chips with published counts.
const countyCounts = new Map<string, number>();
for (const b of published) {
  if (b.stateSlug && b.countySlug) {
    const k = `${b.stateSlug}/${b.countySlug}`;
    countyCounts.set(k, (countyCounts.get(k) ?? 0) + 1);
  }
}

// "Popular near you": top-rated published businesses region-wide.
const popular = [...published]
  .filter((b) => blendedRating(b) !== null)
  .sort((a, b) => (blendedRating(b) ?? 0) - (blendedRating(a) ?? 0))
  .slice(0, 8);

const guides = latestGuides(3);

const POPULAR_TILE_SLUGS = [
  "roofers", "plumbers", "electricians", "hvac-contractors",
  "landscapers", "house-cleaners", "dentists", "attorneys",
];

const STEPS = [
  { title: "Identify", body: "We confirm the business is real — a working phone, a real address or service area, and an owner we can name." },
  { title: "Verify the license", body: "Where a trade requires one, we look the business up in the official state or county registry and record the source and date." },
  { title: "Check reviews", body: "We read reviews across platforms and flag patterns, not just averages. Ratings are never edited or filtered by sentiment." },
  { title: "Confirm they're taking work", body: "A listing only helps if someone answers. We confirm the business is active and responsive before it earns a badge." },
];
---

<!-- Photographic hero -->
<section class="relative border-b border-line">
  {heroPhoto ? (
    <>
      <div class="absolute inset-0 overflow-hidden">
        <Pic src={heroPhoto.url} alt="" aspect={21 / 9} sizes="100vw" priority class="!h-full" />
        <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(11,27,43,0.92) 0%, rgba(11,27,43,0.72) 45%, rgba(11,27,43,0.42) 100%);"></div>
      </div>
      <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-white/80">
          Local business directory · NJ · NY · PA
        </p>
        <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold text-white sm:text-5xl">
          Find trusted local pros in New Jersey, New&nbsp;York &amp; Pennsylvania
        </h1>
        <p class="mt-4 max-w-prose text-lg text-white/90">
          Verified licenses. Real reviews. Fast responses.
        </p>
        <div class="glass mt-8 max-w-3xl rounded-card border border-white/20 p-3">
          <HeroSearch />
        </div>
        <p class="mt-4 font-mono text-xs text-white/80">
          {verifiedCount} verified {verifiedCount === 1 ? "business" : "businesses"} · {townCount} towns
          {registryCount > 0 && ` · licenses checked against ${registryCount} ${registryCount === 1 ? "registry" : "registries"}`}
        </p>
        <p class="absolute bottom-2 right-4 text-[11px] text-white/60">
          {heroPhoto.caption} · <a href="/credits" class="underline">credit</a>
        </p>
      </div>
    </>
  ) : (
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
        Local business directory · NJ · NY · PA
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold text-ink sm:text-5xl">
        Find trusted local pros in New Jersey, New&nbsp;York &amp; Pennsylvania
      </h1>
      <p class="mt-4 max-w-prose text-lg text-muted">Verified licenses. Real reviews. Fast responses.</p>
      <div class="mt-8 max-w-3xl"><HeroSearch /></div>
      <p class="mt-4 font-mono text-xs text-muted">
        {verifiedCount} verified businesses · {townCount} towns
      </p>
    </div>
  )}
</section>

<!-- Bento explore -->
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="explore-heading">
  <h2 id="explore-heading" class="font-display text-3xl font-semibold text-ink">Explore the directory</h2>
  <div class="mt-6 grid gap-4 lg:grid-cols-3">
    <!-- Large tile: the real showcase listing (2 rows tall) -->
    <div class="reveal lg:row-span-2">
      <ShowcaseListing />
    </div>

    <!-- Browse by category -->
    <div class="reveal rounded-card border border-line bg-surface p-5 lg:col-span-2">
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="font-display text-lg font-semibold text-ink">Browse by category</h3>
        <a href="/categories" class="text-sm font-medium text-brand hover:underline">All categories →</a>
      </div>
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {POPULAR_TILE_SLUGS.map((slug) => (
          <li><CategoryTile slug={slug} /></li>
        ))}
      </ul>
    </div>

    <!-- Static map tile -->
    <a href="/nj" class="card-hover reveal group relative block overflow-hidden rounded-card border border-line">
      <picture>
        <source srcset="/assets/tri-state-map.webp" type="image/webp" />
        <img
          src="/assets/tri-state-map.png"
          alt={`Map of the tri-state area with ${verifiedCount} verified businesses marked`}
          width="900"
          height="560"
          loading="lazy"
          decoding="async"
          class="h-full min-h-[220px] w-full object-cover"
        />
      </picture>
      <span class="absolute bottom-3 left-3 rounded-chip bg-brand-deep/85 px-3 py-1.5 text-xs font-semibold text-white">
        {verifiedCount} verified {verifiedCount === 1 ? "business" : "businesses"} across NJ · NY · PA
      </span>
    </a>

    <!-- Where we're launching -->
    <div class="reveal rounded-card border border-line bg-surface p-5">
      <h3 class="font-display text-lg font-semibold text-ink">Where we're launching</h3>
      <div class="mt-3 space-y-3">
        {states.map((state) => (
          <div>
            <a href={`/${state.slug}`} class="text-sm font-semibold text-ink hover:text-brand">{state.name}</a>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {getCountiesByState(state.slug).map((county) => {
                const n = countyCounts.get(`${state.slug}/${county.slug}`) ?? 0;
                return (
                  <li>
                    <a
                      href={`/${county.pathKey}`}
                      class="inline-block rounded-chip bg-inset px-2.5 py-1 text-xs font-medium text-muted transition-colors hover:bg-brand-wash hover:text-brand"
                    >
                      {county.name.replace(/ County$/, "")}{n > 0 && <span class="text-faint"> · {n}</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Popular near you -->
{popular.length > 0 && (
  <section class="border-y border-line bg-surface" aria-labelledby="popular-heading">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex items-baseline justify-between gap-3">
        <h2 id="popular-heading" class="font-display text-3xl font-semibold text-ink">Popular near you</h2>
        <p class="text-sm text-muted">Top rated across NJ, NY &amp; PA</p>
      </div>
      <div class="mt-6 flex snap-x gap-4 overflow-x-auto pb-2">
        {popular.map((b) => (
          <div class="w-[320px] flex-none snap-start sm:w-[360px]">
            <ResultCard business={b} showCategory />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- How we verify -->
<section class="bg-brand-deep text-white" aria-labelledby="verify-heading">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="verify-heading" class="font-display text-2xl font-semibold">How we verify</h2>
        <p class="mt-1 max-w-prose text-white/80">
          Four checks, in order, before any business earns a badge.
        </p>
      </div>
      <a
        href="/how-we-verify"
        class="rounded-chip border border-white/40 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-white/10"
      >
        Read the full methodology
      </a>
    </div>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {STEPS.map((step, i) => (
        <li class="reveal rounded-card border border-white/15 p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-white/60">Step {i + 1}</p>
          <h3 class="mt-2 font-display text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/80">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Guides & cost context -->
{guides.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="guides-heading">
    <h2 id="guides-heading" class="font-display text-3xl font-semibold text-ink">Guides &amp; cost context</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {guides.map((g) => {
        const art = g.scope === "category" ? categoryArt(g.scopeKey) : null;
        const tint = art ? `var(--tint-${art.tint})` : "var(--brand-wash)";
        return (
          <a
            href={g.scope === "state" ? `/${g.scopeKey}#guides` : `/${g.scopeKey}`}
            class="card-hover reveal overflow-hidden rounded-card border border-line bg-surface"
          >
            <div class="h-24" style={`background: linear-gradient(120deg, ${tint}, color-mix(in srgb, ${tint} 40%, var(--surface)));`} aria-hidden="true"></div>
            <div class="p-5">
              <h3 class="font-display text-base font-semibold text-ink">{g.title}</h3>
              <p class="mt-2 text-xs text-faint">
                By {g.author} · updated {new Date(g.updatedAt || g.publishedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<!-- Business CTA band -->
<section class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-12 sm:px-6">
    <div class="max-w-prose">
      <h2 class="font-display text-2xl font-semibold text-ink">Own a local business?</h2>
      <p class="mt-2 text-muted">
        Listing is free. Verification is what sets you apart — and paid placement is always
        labeled and never changes rankings or reviews.
      </p>
    </div>
    <a
      href="/for-businesses/get-listed"
      class="rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
    >
      List your business
    </a>
  </div>
</section>
