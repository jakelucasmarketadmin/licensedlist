---
import HeroSearch from "@/components/site/HeroSearch.astro";
import ShowcaseListing from "@/components/site/ShowcaseListing.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import ResultCard from "@/components/site/ResultCard.astro";
import Pic from "@/components/site/Pic.astro";
import { getStates, getCountiesByState, getAllTowns } from "@/lib/geo";
import { fetchBusinesses, isPublished, blendedRating } from "@/lib/businesses";
import { registryTotals } from "@/lib/registry";
import { computeIndexability } from "@/lib/indexability";
import { upcomingEvents, thisWeekend, eventDateLabel } from "@/lib/events";
import NlIntake from "@/components/site/NlIntake.tsx";
import { latestGuides } from "@/lib/guides";
import { homeHeroPhotos } from "@/lib/town-photos";
import { categoryArt } from "@/data/category-art";

const states = getStates();

// Live meta line — real counts, never invented.
let published: Awaited<ReturnType<typeof fetchBusinesses>> = [];
try {
  published = (await fetchBusinesses()).filter(isPublished);
} catch { /* counts fall back to zero-safe copy */ }
// 11 published; 7 license-verified, 4 in not-required categories — so the
// headline counts every vetted listing and license-verified stays precise.
const publishedCount = published.length;
const verifiedCount = published.filter((b) => b.licenseStatus === "verified").length;
// "Towns" used to count the seeded geography (162) while only a fraction had
// a live page — a visitor could see the gap in one click on /directory. Count
// what is actually reachable instead.
const townCount = getAllTowns().length;
const liveTownCount = computeIndexability(published).towns.size;
const registryCount = new Set(
  published.filter((b) => b.licenseStatus === "verified").map((b) => b.licenseSource).filter(Boolean),
).size;
// C0: licensed-on-file counter (registered, unclaimed roster rows).
let registeredTotal = 0;
try {
  registeredTotal = (await registryTotals()).registered;
} catch { /* line degrades */ }

// Rotate the hero photo by time of day (server hour; page caches ~60s).
/**
 * "Recently added" (Gate B §3.3) — the newest verified listings, newest first.
 * This is the highest-value indexing element on the site: it puts every new
 * URL one hop from the most-crawled page and gives the freshness scheduler a
 * standing reason to recrawl the homepage.
 */
const recentlyAdded = [...published]
  .filter((b) => b.licenseStatus === "verified" || b.licenseStatus === "credential-only")
  .sort((a, b) => {
    const at = new Date((a as any)._createdDate ?? a.licenseVerifiedAt ?? 0).getTime();
    const bt = new Date((b as any)._createdDate ?? b.licenseVerifiedAt ?? 0).getTime();
    return bt - at;
  })
  .slice(0, 24);

const heroPool = homeHeroPhotos(5);
const heroPhoto = heroPool.length
  ? heroPool[new Date().getHours() % heroPool.length]
  : undefined;

// County chips with published counts.
const countyCounts = new Map<string, number>();
for (const b of published) {
  if (b.stateSlug && b.countySlug) {
    const k = `${b.stateSlug}/${b.countySlug}`;
    countyCounts.set(k, (countyCounts.get(k) ?? 0) + 1);
  }
}

// "Popular near you": top-rated published businesses region-wide.
const popular = [...published]
  .filter((b) => blendedRating(b) !== null)
  .sort((a, b) => (blendedRating(b) ?? 0) - (blendedRating(a) ?? 0))
  .slice(0, 8);

const guides = latestGuides(3);
// "This weekend" module (C3): events + newest verified listings.
const homePreview = Astro.url.searchParams.get("preview") === "demo";
const weekendEvents = thisWeekend(await upcomingEvents(homePreview)).slice(0, 3);
const newestVerified = [...published]
  .filter((b) => b.licenseStatus === "verified")
  .sort((a, b) => new Date(b.lastVerifiedAt ?? 0).getTime() - new Date(a.lastVerifiedAt ?? 0).getTime())
  .slice(0, 3);

const POPULAR_TILE_SLUGS = [
  "roofers", "plumbers", "electricians", "hvac-contractors",
  "landscapers", "house-cleaners", "dentists", "attorneys",
];

const STEPS = [
  { title: "Identify", body: "We confirm the business is real — a working phone, a real address or service area, and an owner we can name." },
  { title: "Verify the license", body: "Where a trade requires one, we look the business up in the official state or county registry and record the source and date." },
  { title: "Check reviews", body: "We read reviews across platforms and flag patterns, not just averages. Ratings are never edited or filtered by sentiment." },
  { title: "Confirm they're taking work", body: "A listing only helps if someone answers. We confirm the business is active and responsive before it earns a badge." },
];
---

<!-- Hero — the dark "club" band. The photo is optional; without it the band's
     own gradient carries the section. -->
<section class="on-dark club-band relative overflow-hidden">
  {heroPhoto && (
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <Pic src={heroPhoto.url} alt="" aspect={21 / 9} sizes="100vw" priority class="!h-full" />
      <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(7,11,9,0.96) 0%, rgba(7,11,9,0.84) 45%, rgba(7,11,9,0.55) 100%);"></div>
      <div class="absolute inset-x-0 bottom-0 h-40" style="background: linear-gradient(to top, rgba(7,11,9,0.9), transparent);"></div>
    </div>
  )}
  <div class="relative mx-auto max-w-6xl px-4 pb-14 pt-20 sm:px-6 lg:pb-20 lg:pt-28">
    <p class="eyebrow text-gold">The tri-state short list · NJ · NY · PA</p>
    <h1 class="mt-6 max-w-4xl font-display text-4xl leading-[1.05] text-ink sm:text-5xl lg:text-6xl">
      The short list of <span class="text-gold">license-verified</span> local pros in New&nbsp;Jersey, New&nbsp;York &amp; Pennsylvania
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      Every business is identity-checked, and every licensed trade is looked up in the official
      state registry before it earns a place here. Paid placement is always labeled and never
      changes rankings.
    </p>

    <div class="glass mt-10 max-w-3xl rounded-card border border-gold-soft p-3">
      <div class="flex gap-1 px-1 pb-2" role="tablist" aria-label="Search mode" data-hero-tabs data-active="bg-accent text-accent-ink" data-inactive="text-muted">
        <button type="button" role="tab" aria-selected="true" data-hero-tab="search" class="rounded-chip px-3 py-1.5 text-xs font-semibold bg-accent text-accent-ink">Search</button>
        <button type="button" role="tab" aria-selected="false" data-hero-tab="describe" class="rounded-chip px-3 py-1.5 text-xs font-semibold text-muted">Describe the problem</button>
      </div>
      <div data-hero-pane="search"><HeroSearch /></div>
      <div data-hero-pane="describe" hidden><NlIntake client:visible preview={homePreview} compact /></div>
    </div>

    <dl class="mt-14 grid max-w-4xl grid-cols-2 gap-y-8 border-t border-line pt-8 sm:grid-cols-4">
      <div class="pr-4">
        <dt class="eyebrow text-faint">On the list</dt>
        <dd class="mt-2 font-display text-3xl text-gold sm:text-4xl">{publishedCount}</dd>
      </div>
      <div class="pr-4 sm:border-l sm:border-line sm:pl-6">
        <dt class="eyebrow text-faint">License-verified</dt>
        <dd class="mt-2 font-display text-3xl text-gold sm:text-4xl">{verifiedCount}</dd>
      </div>
      {registeredTotal > 0 && (
        <div class="pr-4 sm:border-l sm:border-line sm:pl-6">
          <dt class="eyebrow text-faint">Licenses on file</dt>
          <dd class="mt-2 font-display text-3xl text-gold sm:text-4xl">{registeredTotal.toLocaleString("en-US")}</dd>
        </div>
      )}
      <div class="pr-4 sm:border-l sm:border-line sm:pl-6">
        <dt class="eyebrow text-faint">Towns live</dt>
        <dd class="mt-2 font-display text-3xl text-gold sm:text-4xl">{liveTownCount}</dd>
      </div>
    </dl>

    {heroPhoto && (
      <p class="absolute bottom-2 right-4 text-[11px] text-faint">
        {heroPhoto.caption} · <a href="/credits" class="underline">credit</a>
      </p>
    )}
  </div>
</section>
<hr class="gold-rule" />

<script is:inline data-astro-rerun>
  (function () {
    var tabs = document.querySelector("[data-hero-tabs]");
    if (!tabs || tabs.dataset.wired) return;
    tabs.dataset.wired = "1";
    var active = (tabs.getAttribute("data-active") || "").split(" ").filter(Boolean);
    var inactive = (tabs.getAttribute("data-inactive") || "").split(" ").filter(Boolean);
    tabs.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-hero-tab]");
      if (!btn) return;
      var mode = btn.getAttribute("data-hero-tab");
      tabs.querySelectorAll("[data-hero-tab]").forEach(function (b) {
        var on = b === btn;
        b.setAttribute("aria-selected", String(on));
        (on ? inactive : active).forEach(function (c) { b.classList.remove(c); });
        (on ? active : inactive).forEach(function (c) { b.classList.add(c); });
      });
      document.querySelectorAll("[data-hero-pane]").forEach(function (pane) {
        pane.hidden = pane.getAttribute("data-hero-pane") !== mode;
      });
    });
  })();
</script>

<!-- Bento explore -->
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="explore-heading">
  <p class="eyebrow text-brand">The directory</p>
  <h2 id="explore-heading" class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Browse the list</h2>
  <div class="mt-10 grid gap-5 lg:grid-cols-3">
    <!-- Large tile: the real showcase listing (2 rows tall) -->
    <div class="reveal lg:row-span-2">
      <ShowcaseListing />
    </div>

    <!-- Browse by category -->
    <div class="reveal rounded-card border border-line bg-surface p-5 lg:col-span-2">
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="font-display text-lg font-semibold text-ink">Browse by category</h3>
        <a href="/categories" class="text-sm font-medium text-brand hover:underline">All categories →</a>
      </div>
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {POPULAR_TILE_SLUGS.map((slug) => (
          <li><CategoryTile slug={slug} /></li>
        ))}
      </ul>
    </div>

    <!-- Static map tile -->
    <a href="/nj" class="card-hover reveal group relative block overflow-hidden rounded-card border border-line">
      <picture>
        <source srcset="/assets/tri-state-map.webp" type="image/webp" />
        <img
          src="/assets/tri-state-map.png"
          alt={`Map of the tri-state area with ${verifiedCount} verified businesses marked`}
          width="900"
          height="560"
          loading="lazy"
          decoding="async"
          class="h-full min-h-[220px] w-full object-cover"
        />
      </picture>
      <span class="absolute bottom-3 left-3 rounded-chip bg-brand-deep px-3 py-1.5 text-xs font-semibold text-white">
        {verifiedCount} verified {verifiedCount === 1 ? "business" : "businesses"} across NJ · NY · PA
      </span>
    </a>

    <!-- Where we're launching -->
    <div class="reveal rounded-card border border-line bg-surface p-5">
      <h3 class="font-display text-lg font-semibold text-ink">Where we're launching</h3>
      <div class="mt-3 space-y-3">
        {states.map((state) => (
          <div>
            <a href={`/${state.slug}`} class="text-sm font-semibold text-ink hover:text-brand">{state.name}</a>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {getCountiesByState(state.slug).map((county) => {
                const n = countyCounts.get(`${state.slug}/${county.slug}`) ?? 0;
                return (
                  <li>
                    <a
                      href={`/${county.pathKey}`}
                      class="inline-block rounded-chip bg-inset px-2.5 py-1 text-xs font-medium text-muted transition-colors hover:bg-brand-wash hover:text-brand"
                    >
                      {county.name.replace(/ County$/, "")}{n > 0 && <span class="text-faint"> · {n}</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- This weekend: events + latest guide + newest verified (C3) -->
{(weekendEvents.length > 0 || newestVerified.length > 0) && (
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="weekend-heading">
    <h2 id="weekend-heading" class="font-display text-3xl font-semibold text-ink">This weekend</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-card border border-line bg-surface p-5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">Events nearby</h3>
        {weekendEvents.length > 0 && (
          <ul class="mt-3 space-y-2.5">
            {weekendEvents.map((e) => (
              <li>
                <p class="font-mono text-xs text-brand">{eventDateLabel(e)}</p>
                <p class="text-sm font-semibold text-ink">{e.title}</p>
              </li>
            ))}
          </ul>
        )}
        <a href="/events" class="mt-3 inline-block text-sm font-medium text-brand underline underline-offset-2">All events</a>
      </div>
      {guides[0] && (
        <div class="rounded-card border border-line bg-surface p-5">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">Latest guide</h3>
          <p class="mt-3 font-display text-lg font-semibold leading-snug text-ink">{guides[0].title}</p>
          <p class="mt-1 text-xs text-faint">By {guides[0].author}</p>
          <a href="/guides" class="mt-3 inline-block text-sm font-medium text-brand underline underline-offset-2">All guides</a>
        </div>
      )}
      <div class="rounded-card border border-line bg-surface p-5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">New &amp; verified</h3>
        <ul class="mt-3 space-y-2.5">
          {newestVerified.map((b) => (
            <li>
              <a href={`/business/${b.slug}`} class="text-sm font-semibold text-ink hover:text-brand">{b.name}</a>
              <p class="text-xs text-faint">{b.city}, {b.state}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<!-- Popular near you -->
{popular.length > 0 && (
  <section class="border-y border-line bg-surface" aria-labelledby="popular-heading">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow text-brand">Top rated across NJ, NY &amp; PA</p>
          <h2 id="popular-heading" class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Popular near you</h2>
        </div>
        <a href="/directory" class="text-sm font-medium text-brand underline-offset-4 hover:underline">See the full list →</a>
      </div>
      <div class="mt-10 flex snap-x gap-5 overflow-x-auto pb-2">
        {popular.map((b) => (
          <div class="w-[320px] flex-none snap-start sm:w-[360px]">
            <ResultCard business={b} showCategory />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- How we verify -->
<section class="on-dark club-band" aria-labelledby="verify-heading">
  <hr class="gold-rule" />
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow text-gold">How a business gets on the list</p>
        <h2 id="verify-heading" class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Four checks. In order. No exceptions.</h2>
        <p class="mt-3 max-w-prose text-muted">
          Every business clears the same four checks before it earns a badge, and the result is
          published on its profile.
        </p>
      </div>
      <a
        href="/how-we-verify"
        class="rounded-chip border border-gold-soft px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-gold hover:text-gold"
      >
        Read the full methodology
      </a>
    </div>
    <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {STEPS.map((step, i) => (
        <li class="reveal border-t border-gold-soft pt-6">
          <p class="font-display text-4xl text-gold">{String(i + 1).padStart(2, "0")}</p>
          <h3 class="mt-4 font-display text-xl font-semibold text-ink">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
  <hr class="gold-rule" />
</section>

<!-- Guides & cost context -->
{guides.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6" aria-labelledby="guides-heading">
    <h2 id="guides-heading" class="font-display text-3xl font-semibold text-ink">Guides &amp; cost context</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {guides.map((g) => {
        const art = g.scope === "category" ? categoryArt(g.scopeKey) : null;
        const tint = art ? `var(--tint-${art.tint})` : "var(--brand-wash)";
        return (
          <a
            href={g.scope === "state" ? `/${g.scopeKey}#guides` : `/${g.scopeKey}`}
            class="card-hover reveal overflow-hidden rounded-card border border-line bg-surface"
          >
            <div class="h-24" style={`background: linear-gradient(120deg, ${tint}, color-mix(in srgb, ${tint} 40%, var(--surface)));`} aria-hidden="true"></div>
            <div class="p-5">
              <h3 class="font-display text-base font-semibold text-ink">{g.title}</h3>
              <p class="mt-2 text-xs text-faint">
                By {g.author} · updated {new Date(g.updatedAt || g.publishedAt).toLocaleDateString("en-US", { month: "long", year: "numeric" })}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<!-- Recently added — kept low on the page on purpose (see below) -->
{recentlyAdded.length > 0 && (
  <section class="border-t border-line bg-paper" aria-labelledby="recent-heading" data-recently-added>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="recent-heading" class="font-display text-xl font-semibold text-ink">
          Recently added
        </h2>
        <a href="/directory" class="text-sm font-medium text-brand underline underline-offset-2">
          Browse the full directory
        </a>
      </div>
      <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted">
        The newest listings to clear a license check — each one verified against the registry
        named on its profile.
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {recentlyAdded.map((b) => (
          <li>
            <a
              href={`/business/${b.slug}`}
              class="inline-flex min-h-[36px] items-center gap-2 rounded-chip border border-line bg-surface px-3 py-1.5 text-sm text-muted transition-colors hover:border-brand hover:text-ink"
            >
              <span class="font-medium text-ink">{b.name}</span>
              {b.city && <span class="text-xs text-faint">{b.city}{b.state ? `, ${b.state}` : ""}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- Business CTA band -->
<section class="border-t border-line bg-surface" aria-labelledby="owners-heading">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="eyebrow text-brand">For business owners</p>
      <h2 id="owners-heading" class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Earn your place on the list.</h2>
      <p class="mt-4 text-muted">
        Listing is free, but not automatic: a business has to clear our checks first. The ones
        that do get a profile customers trust on sight. Paid placement is always labeled and
        never changes rankings or reviews.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/for-businesses/get-listed"
          class="rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
        >
          Apply to be listed
        </a>
        <a
          href="/pricing"
          class="rounded-chip border border-line-strong px-6 py-3 text-base font-semibold text-ink transition-colors hover:border-ink"
        >
          See plans
        </a>
      </div>
    </div>
    <ul class="grid gap-8 sm:grid-cols-3 lg:col-span-3 lg:pt-10">
      <li class="border-t border-line-strong pt-5">
        <p class="font-display text-3xl text-brand">01</p>
        <h3 class="mt-3 font-display text-lg font-semibold text-ink">A verified badge</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">Your license number, the registry it was checked against, and the date — shown on your profile and ready for your own website.</p>
      </li>
      <li class="border-t border-line-strong pt-5">
        <p class="font-display text-3xl text-brand">02</p>
        <h3 class="mt-3 font-display text-lg font-semibold text-ink">A profile built to be found</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">Photos, services, hours, FAQs and your service towns on a page made for local search.</p>
      </li>
      <li class="border-t border-line-strong pt-5">
        <p class="font-display text-3xl text-brand">03</p>
        <h3 class="mt-3 font-display text-lg font-semibold text-ink">Customers who are ready</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">Quote requests and reviews from people who came looking for a licensed pro.</p>
      </li>
    </ul>
  </div>
</section>
