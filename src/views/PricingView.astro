---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import { SITE_NAME } from "@/lib/site";
import { OWNER_FAQ } from "@/data/owner-faq";
import FeaturedRequestForm from "@/components/site/FeaturedRequestForm.tsx";
import { getStates, getCountiesByState } from "@/lib/geo";
import { getCategories } from "@/lib/taxonomy";

const frStates = getStates().map((s) => ({
  slug: s.slug,
  name: s.name,
  counties: getCountiesByState(s.slug).map((c) => ({ slug: c.slug, name: c.name })),
}));
const frCategories = getCategories().map((c) => ({ slug: c.slug, name: c.name }));

const TIERS = [
  {
    name: "Free",
    price: "$0",
    period: "forever",
    blurb: "Claim your listing. No credit card, no expiration.",
    features: [
      "Full business profile",
      "Correct your details, add photos & hours",
      "Respond to reviews",
      "Appear in organic results",
    ],
    cta: { label: "Get listed free", href: "/for-businesses/get-listed" },
    highlighted: false,
  },
  {
    name: "Verified",
    price: "$29",
    period: "/month · $290/yr",
    blurb: "We verify your license against the official registry and badge your listing with the receipt.",
    features: [
      "Everything in Free",
      "License verified badge naming source & date",
      "Scheduled re-verification",
      "Appears under the Verified filter",
    ],
    cta: { label: "Start verification", href: "/for-businesses/get-listed" },
    highlighted: true,
  },
  {
    name: "Featured",
    price: "$99",
    period: "/month · $990/yr",
    blurb: "A labeled featured slot on your category's list pages.",
    features: [
      "Everything in Verified",
      "Featured placement — always labeled",
      "Capped at 3 per category per county",
      "Never changes organic rankings",
    ],
    cta: { label: "Check slot availability", href: "#featured-request" },
    highlighted: false,
  },
  {
    name: "Category sponsor",
    price: "Contact us",
    period: "",
    blurb: "Exclusive sponsorship of a category across a county or state.",
    features: ["Everything in Featured", "Category-level sponsorship", "Custom reporting"],
    cta: { label: "Talk to us", href: "/for-businesses/get-listed" },
    highlighted: false,
  },
];
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo
    trail={[
      { name: "Home", path: "/" },
      { name: "For businesses", path: "/for-businesses" },
      { name: "Pricing", path: "/pricing" },
    ]}
  />

  <header class="mt-4 max-w-prose">
    <h1 class="font-display text-4xl font-bold text-ink">Plans &amp; pricing</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted">
      Paid placement is always labeled and never changes rankings or reviews. That rule is
      permanent — it's what makes a {SITE_NAME} badge worth having.
    </p>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {TIERS.map((tier) => (
      <div
        class:list={[
          "flex flex-col rounded-card border bg-surface p-5",
          tier.highlighted ? "border-brand shadow-sm" : "border-line",
        ]}
      >
        {tier.highlighted && (
          <span class="mb-3 w-fit rounded-chip bg-brand-wash px-2.5 py-0.5 text-xs font-semibold text-brand">
            Most popular
          </span>
        )}
        <h2 class="font-display text-lg font-semibold text-ink">{tier.name}</h2>
        <p class="mt-1">
          <span class="font-display text-3xl font-bold text-ink">{tier.price}</span>
          {tier.period && <span class="text-sm text-faint"> {tier.period}</span>}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-muted">{tier.blurb}</p>
        <ul class="mt-4 flex-1 space-y-2 border-t border-line pt-4 text-sm text-muted">
          {tier.features.map((f) => (
            <li class="flex gap-2">
              <span class="text-ok" aria-hidden="true">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={tier.cta.href}
          class:list={[
            "mt-4 rounded-chip px-4 py-2.5 text-center text-sm font-semibold transition-colors",
            tier.highlighted
              ? "bg-accent text-accent-ink hover:bg-accent-hover"
              : "border border-line-strong text-ink hover:bg-inset",
          ]}
        >
          {tier.cta.label}
        </a>
      </div>
    ))}
  </div>

  <section class="mt-12 max-w-prose" aria-labelledby="pricing-rules-heading">
    <h2 id="pricing-rules-heading" class="font-display text-2xl font-semibold text-ink">
      What money can and can't buy here
    </h2>
    <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
      <li class="rounded-card border border-line bg-surface p-4">
        <strong class="text-ink">Can:</strong> verification work on a schedule, and clearly
        labeled placement in the featured block (max 3 per category per county).
      </li>
      <li class="rounded-card border border-line bg-surface p-4">
        <strong class="text-ink">Can't:</strong> a better organic position, edited or reordered
        reviews, a badge without a passing license check, or removal of truthful information.
      </li>
      <li class="rounded-card border border-line bg-surface p-4">
        Businesses that are clients of our agency are disclosed as sponsored wherever they
        appear and receive no ranking benefit — see the
        <a href="/editorial-policy" class="font-medium text-brand underline underline-offset-2">editorial policy</a>.
      </li>
    </ul>
  </section>

  <section id="featured-request" class="mt-12 max-w-3xl rounded-card border border-line bg-surface p-6" aria-label="Featured slot request">
    <FeaturedRequestForm client:load states={frStates} categories={frCategories} />
  </section>

  <section class="mt-12 max-w-prose" aria-labelledby="pricing-faq-heading">
    <h2 id="pricing-faq-heading" class="font-display text-2xl font-semibold text-ink">
      Owner FAQ
    </h2>
    <dl class="mt-4 space-y-4">
      {OWNER_FAQ.map((item) => (
        <div class="rounded-card border border-line bg-surface p-5">
          <dt class="text-base font-semibold text-ink">{item.q}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted">{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>
</article>
