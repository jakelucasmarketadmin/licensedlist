---
/**
 * /directory — the browsable HTML sitemap (Gate B §3.3).
 *
 * Purpose is crawl paths, not decoration: every indexable hub and money page
 * reachable as a real <a href>, grouped state → county → town → category, so
 * nothing sits more than three clicks from the homepage. Only pages that pass
 * the §3.1 indexability test are linked — a link to a noindexed thin hub would
 * spend crawl budget on a page we've asked Google to ignore.
 */
import { SITE_NAME } from "@/lib/site";
import { getStates, getCountiesByState, getTownsByCounty } from "@/lib/geo";
import { getCategory } from "@/lib/taxonomy";
import type { HubIndexability } from "@/lib/indexability";

interface Props { idx: HubIndexability; listingCount: number }
const { idx, listingCount } = Astro.props;

const catName = (slug: string) => getCategory(slug)?.name ?? slug;
// Money pages keyed by the hub they belong under.
const moneyByHub = new Map<string, string[]>();
for (const path of idx.money) {
  const parts = path.replace(/^\//, "").split("/");
  const cat = parts.pop()!;
  const hub = parts.join("/");
  moneyByHub.set(hub, [...(moneyByHub.get(hub) ?? []), cat]);
}
const states = getStates();
const totalLinks =
  idx.money.size + idx.towns.size + idx.categories.size +
  states.reduce((n, st) => n + getCountiesByState(st.slug).length, 0) + states.length;
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <h1 class="font-display text-4xl font-bold text-ink">Directory index</h1>
  <p class="mt-3 max-w-prose leading-relaxed text-muted">
    Everything on {SITE_NAME}, in one place: {states.length} states,
    {idx.stats.townsIndexable} town pages, {idx.money.size} town- and county-level category
    pages, {idx.categories.size} categories and {listingCount} business listings. Pages appear
    here once they carry at least three listings or real local data — we don't publish empty
    ones.
  </p>

  <nav class="mt-10 space-y-12" aria-label="Directory index">
    {states.map((state) => (
      <section aria-labelledby={`dir-${state.slug}`}>
        <h2 id={`dir-${state.slug}`} class="font-display text-2xl font-semibold text-ink">
          <a href={`/${state.slug}`} class="hover:text-brand">{state.name}</a>
        </h2>
        <div class="mt-4 space-y-6">
          {getCountiesByState(state.slug).map((county) => {
            const countyCats = moneyByHub.get(county.pathKey) ?? [];
            const towns = getTownsByCounty(state.slug, county.slug)
              .filter((t) => idx.towns.has(t.pathKey));
            if (!countyCats.length && !towns.length) return null;
            return (
              <div class="rounded-card border border-line bg-surface p-5">
                <h3 class="font-display text-lg font-semibold text-ink">
                  <a href={`/${county.pathKey}`} class="hover:text-brand">{county.name}</a>
                </h3>
                {countyCats.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {countyCats.sort().map((cat) => (
                      <li>
                        <a href={`/${county.pathKey}/${cat}`} class="inline-flex min-h-[36px] items-center rounded-chip border border-line-strong px-3 py-1.5 text-sm font-medium text-ink hover:bg-inset">
                          {catName(cat)} in {county.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {towns.length > 0 && (
                  <dl class="mt-4 space-y-2">
                    {towns.map((town) => {
                      const cats = (moneyByHub.get(town.pathKey) ?? []).sort();
                      return (
                        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                          <dt class="text-sm font-medium text-ink">
                            <a href={`/${town.pathKey}`} class="hover:text-brand">{town.name}</a>
                          </dt>
                          <dd class="flex flex-wrap gap-x-2 gap-y-1 text-sm text-muted">
                            {cats.length
                              ? cats.map((cat) => (
                                  <a href={`/${town.pathKey}/${cat}`} class="underline underline-offset-2 hover:text-ink">
                                    {catName(cat)}
                                  </a>
                                ))
                              : <span class="text-faint">local guide</span>}
                          </dd>
                        </div>
                      );
                    })}
                  </dl>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <section aria-labelledby="dir-categories">
      <h2 id="dir-categories" class="font-display text-2xl font-semibold text-ink">
        All categories
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {[...idx.categories].sort().map((slug) => (
          <li>
            <a href={`/${slug}`} class="inline-flex min-h-[36px] items-center rounded-chip border border-line px-3 py-1.5 text-sm text-muted hover:border-brand hover:text-ink">
              {catName(slug)}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </nav>

  <p class="mt-10 text-sm text-faint">
    {totalLinks} links on this page. Machine-readable version:
    <a href="/sitemap-index" class="underline underline-offset-2">sitemap index</a>.
  </p>
</article>
