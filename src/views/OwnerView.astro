---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import OwnerPortal from "@/components/site/OwnerPortal.tsx";
import { jotformUpdateUrl } from "@/lib/jotform";
---

<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo
    trail={[
      { name: "Home", path: "/" },
      { name: "For businesses", path: "/for-businesses" },
      { name: "Owner dashboard", path: "/owner" },
    ]}
  />
  <h1 class="mt-4 font-display text-4xl font-bold text-ink">Owner dashboard</h1>
  <p class="mt-3 max-w-prose text-muted">
    Manage your listing: description, hours, photos, services, and contact details.
  </p>
  <p class="mt-3 max-w-prose text-sm text-muted">
    Fastest way to send changes:
    <a href={jotformUpdateUrl()} target="_blank" rel="nofollow noopener" class="font-medium text-brand underline underline-offset-2">Update my listing</a>
    — no sign-in needed; we apply edits after review.
  </p>
  <div class="mt-8">
    <OwnerPortal client:only="react" />
  </div>
</article>
