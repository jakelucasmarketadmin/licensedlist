<section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">404</p>
  <h1 class="mt-3 font-display text-4xl font-bold text-ink">This page doesn't exist</h1>
  <p class="mx-auto mt-4 max-w-prose text-muted">
    The address may be mistyped, or the page may not be published yet — we only publish
    directory pages once they have verified listings behind them.
  </p>
  <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
    <a
      href="/"
      class="rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
    >
      Go to the home page
    </a>
    <a
      href="/search"
      class="rounded-chip border border-line-strong px-6 py-3 text-base font-semibold text-ink transition-colors hover:bg-inset"
    >
      Search the directory
    </a>
  </div>
</section>
