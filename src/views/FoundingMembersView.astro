---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import ShowcaseListing from "@/components/site/ShowcaseListing.astro";
import { SITE_NAME } from "@/lib/site";
import { JOTFORM_FORM_URL } from "@/lib/jotform";
import { registryTotals, foundingCounts, FOUNDING_CAP_PER_COUNTY } from "@/lib/registry";
import { getState, getCounty, getAllCounties } from "@/lib/geo";

/**
 * /founding-members — claim pitch for registry-seeded businesses (C0).
 * Counters are live: registered-on-file per county and founding spots left
 * (cap enforced manually at claim approval — RUNBOOK §9).
 */
const totals = await registryTotals();
const founding = await foundingCounts();

const counters = [...totals.byCounty.entries()]
  .map(([key, onFile]) => {
    const [stateSlug, countySlug] = key.split("|");
    const county = getCounty(stateSlug, countySlug);
    const state = getState(stateSlug);
    const claimed = founding.get(key) ?? 0;
    return county && state
      ? { name: `${county.name}, ${state.abbr}`, onFile, claimed, left: Math.max(0, FOUNDING_CAP_PER_COUNTY - claimed) }
      : null;
  })
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .sort((a, b) => b.onFile - a.onFile);

// Launch counties whose registry import hasn't landed yet (NJ needs an OPRA
// grant, PA needs the manual PALS download, remaining NY sources pending) —
// shown as pending rather than omitted.
const seededKeys = new Set(totals.byCounty.keys());
const pendingCounties = getAllCounties()
  .filter((c) => !seededKeys.has(`${c.stateSlug}|${c.slug}`))
  .map((c) => ({ name: `${c.name}, ${getState(c.stateSlug)?.abbr ?? c.stateSlug.toUpperCase()}` }));

const STEPS = [
  {
    title: "Find your license",
    body: "Your business is already on the official state or city license roster we imported — that's why you're here. Search any county page's \"Also licensed\" table for your name.",
  },
  {
    title: "Claim it in 3 minutes",
    body: "The claim form asks for your business name, license number, and contact info. We match it against the registry record — no documents to upload when the details line up.",
  },
  {
    title: "Go live, verified",
    body: "Once approved, your full profile goes live with the green license-verified badge, photos, services, reviews, and quote requests — and founding members keep Verified free for life.",
  },
];
---

<article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo
    trail={[
      { name: "Home", path: "/" },
      { name: "For businesses", path: "/for-businesses" },
      { name: "Founding members", path: "/founding-members" },
    ]}
  />

  <header class="mt-6 max-w-prose">
    <p class="font-mono text-xs uppercase tracking-widest text-muted">Founding member offer</p>
    <h1 class="mt-3 font-display text-4xl font-bold text-ink sm:text-5xl">
      Your license is already on file. Claim your free listing.
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      {SITE_NAME} imports official license rosters, so your business may already appear in your
      county's licensed-on-file table. Claim it now and get <span class="font-semibold text-ink">Verified
      free for life</span> — while founding spots in your county last.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={JOTFORM_FORM_URL} target="_blank" rel="nofollow noopener" class="rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover">
        Claim your listing
      </a>
      <a href="/how-we-verify" class="rounded-chip border border-line-strong px-6 py-3 text-base font-semibold text-ink hover:bg-inset">
        How verification works
      </a>
    </div>
  </header>

  {counters.length > 0 && (
    <section class="mt-12" aria-labelledby="spots-heading">
      <h2 id="spots-heading" class="font-display text-2xl font-semibold text-ink">Founding spots by county</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {counters.map((c) => (
          <li class="rounded-card border border-line bg-surface p-4">
            <p class="font-semibold text-ink">{c.name}</p>
            <p class="mt-1 text-sm text-muted">
              {c.onFile.toLocaleString("en-US")} licensed businesses on file
              · {c.claimed === 0 ? "none claimed so far" : `${c.claimed} claimed so far`}
            </p>
            <p class="mt-2 inline-block rounded-chip bg-brand-wash px-2.5 py-1 text-xs font-semibold text-brand">
              {c.claimed === 0
                ? `${FOUNDING_CAP_PER_COUNTY} founding spots`
                : `${c.claimed} claimed · ${c.left} founding spots left`}
            </p>
          </li>
        ))}
      </ul>
      {pendingCounties.length > 0 && (
        <div class="mt-6">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">Registry import pending</h3>
          <p class="mt-1 max-w-prose text-xs leading-relaxed text-faint">
            These launch counties are next: New Jersey rosters need a public-records (OPRA)
            grant, Pennsylvania's PALS data is a manual download, and more New York sources
            are queued. The founding offer applies the moment a county's roster lands.
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {pendingCounties.map((c) => (
              <li class="rounded-chip border border-line bg-surface px-3 py-1.5 text-xs text-muted">{c.name}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  <section class="mt-12" aria-labelledby="steps-heading">
    <h2 id="steps-heading" class="font-display text-2xl font-semibold text-ink">Three steps to a verified listing</h2>
    <ol class="mt-4 grid gap-4 md:grid-cols-3">
      {STEPS.map((s, i) => (
        <li class="rounded-card border border-line bg-surface p-5">
          <p class="font-mono text-xs text-faint">Step {i + 1}</p>
          <h3 class="mt-1 font-display text-lg font-semibold text-ink">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-12" aria-labelledby="example-heading">
    <h2 id="example-heading" class="font-display text-2xl font-semibold text-ink">What a claimed listing looks like</h2>
    <p class="mt-1 max-w-prose text-sm text-muted">
      A real verified member — license checked against the state registry, with the receipt shown.
    </p>
    <div class="mt-4 max-w-2xl">
      <ShowcaseListing />
    </div>
  </section>

  <section class="mt-12 rounded-card bg-brand-deep p-6 text-white sm:p-8">
    <h2 class="font-display text-2xl font-semibold">The founding-member deal</h2>
    <ul class="mt-3 max-w-prose list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-white/85">
      <li>Free listing forever — that's true for everyone, founding member or not.</li>
      <li>Founding members get the <span class="font-semibold text-white">Verified plan free for life</span> ({FOUNDING_CAP_PER_COUNTY} per county, first come).</li>
      <li>Rankings are never for sale — verification affects the badge, not your position.</li>
    </ul>
    <a href={JOTFORM_FORM_URL} target="_blank" rel="nofollow noopener" class="mt-5 inline-block rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink hover:bg-accent-hover">
      Claim your founding spot
    </a>
  </section>
</article>
