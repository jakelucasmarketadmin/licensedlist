---
import { SITE_NAME, BUSINESS_CONTACT_EMAIL } from "@/lib/site";

const TIERS = [
  {
    name: "Free",
    price: "$0",
    period: "forever",
    blurb: "Claim your listing, correct your details, respond to reviews.",
    features: ["Full business profile", "Respond to reviews", "Appear in organic results"],
    highlighted: false,
  },
  {
    name: "Verified",
    price: "$29",
    period: "/month",
    blurb: "We verify your license against the state registry and badge your listing.",
    features: [
      "Everything in Free",
      "License verified badge with source & date",
      "Scheduled re-verification",
      "Verified filter placement",
    ],
    highlighted: true,
  },
  {
    name: "Featured",
    price: "$99",
    period: "/month",
    blurb: "A labeled featured slot on your category's list pages — max 3 per category per county.",
    features: [
      "Everything in Verified",
      "Featured placement, always labeled",
      "Capped at 3 per category per county",
    ],
    highlighted: false,
  },
  {
    name: "Category sponsor",
    price: "Contact us",
    period: "",
    blurb: "Exclusive sponsorship of a category across a county or state.",
    features: ["Everything in Featured", "Category-level sponsorship", "Custom reporting"],
    highlighted: false,
  },
];

const FAQ = [
  {
    q: "Does paying improve my ranking or my reviews?",
    a: "No. Paid placement is always labeled and never changes rankings or reviews. The organic list is ordered by a public score: license verification, review count, rating, and freshness. That rule is permanent — it's what makes the badge worth having.",
  },
  {
    q: "What do I need to get the verified badge?",
    a: "Your license or registration number and the state it's issued in. We look it up in the official registry ourselves, record the source and date on your listing, and re-check it on a schedule.",
  },
  {
    q: "My trade doesn't require a license. Can I still be verified?",
    a: "Yes — your listing shows “license not required” for your category, and we still verify your identity, reviews, and responsiveness.",
  },
  {
    q: "Is claiming my listing really free?",
    a: "Free forever. No credit card. Claiming lets you fix your details, add photos and hours, and respond to reviews.",
  },
  {
    q: "What happens if my license lapses?",
    a: "The badge comes down until the registry shows you in good standing again. We'd rather have fewer badges than badges that mean nothing.",
  },
];
---

<article>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6 lg:py-16">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">For businesses</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-ink">
        Be the business neighbors can actually trust
      </h1>
      <p class="mx-auto mt-4 max-w-prose text-lg leading-relaxed text-muted">
        {SITE_NAME} is built for homeowners who check credentials before they hire. A verified
        listing shows them — with a registry source and date — that you're exactly who you say
        you are.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${BUSINESS_CONTACT_EMAIL}?subject=List%20my%20business%20on%20${SITE_NAME}`}
          class="rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
        >
          Get listed — it's free
        </a>
        <a
          href="/how-we-verify"
          class="rounded-chip border border-line-strong px-6 py-3 text-base font-semibold text-ink transition-colors hover:bg-inset"
        >
          See how verification works
        </a>
      </div>
      <p class="mt-4 text-sm text-faint">
        Online claiming launches soon — for now, email us and we'll set your listing up with you.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-labelledby="pricing-heading" id="pricing">
    <h2 id="pricing-heading" class="font-display text-2xl font-semibold text-ink">
      Plans &amp; pricing
    </h2>
    <p class="mt-1 max-w-prose text-muted">
      Paid placement is always labeled and never changes rankings or reviews.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {TIERS.map((tier) => (
        <div
          class:list={[
            "flex flex-col rounded-card border bg-surface p-5",
            tier.highlighted ? "border-brand shadow-sm" : "border-line",
          ]}
        >
          {tier.highlighted && (
            <span class="mb-3 w-fit rounded-chip bg-brand-wash px-2.5 py-0.5 text-xs font-semibold text-brand">
              Most popular
            </span>
          )}
          <h3 class="font-display text-lg font-semibold text-ink">{tier.name}</h3>
          <p class="mt-1">
            <span class="font-display text-3xl font-bold text-ink">{tier.price}</span>
            {tier.period && <span class="text-sm text-faint"> {tier.period}</span>}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-muted">{tier.blurb}</p>
          <ul class="mt-4 space-y-2 border-t border-line pt-4 text-sm text-muted">
            {tier.features.map((f) => (
              <li class="flex gap-2">
                <span class="text-ok" aria-hidden="true">✓</span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-display text-2xl font-semibold text-ink">Owner FAQ</h2>
      <dl class="mt-6 space-y-6">
        {FAQ.map((item) => (
          <div class="rounded-card border border-line bg-paper p-5">
            <dt class="text-base font-semibold text-ink">{item.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{item.a}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-10 rounded-card bg-brand-deep p-6 text-white sm:p-8">
        <h2 class="font-display text-xl font-semibold">Ready to get listed?</h2>
        <p class="mt-2 max-w-prose text-sm leading-relaxed text-white/80">
          Email us your business name, town, and license number if your trade has one. We'll
          build your listing, run verification, and send it to you for review.
        </p>
        <a
          href={`mailto:${BUSINESS_CONTACT_EMAIL}?subject=List%20my%20business%20on%20${SITE_NAME}`}
          class="mt-4 inline-block rounded-chip bg-accent px-6 py-3 text-base font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
        >
          Email {BUSINESS_CONTACT_EMAIL}
        </a>
      </div>
    </div>
  </section>
</article>
