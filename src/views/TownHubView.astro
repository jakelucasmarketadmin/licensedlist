---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import MethodologyStrip from "@/components/site/MethodologyStrip.astro";
import CategoriesEmptyState from "@/components/site/CategoriesEmptyState.astro";
import CategoryTile from "@/components/site/CategoryTile.astro";
import Pic from "@/components/site/Pic.astro";
import MiniMap from "@/components/site/MiniMap.tsx";
import { getNearbyTowns, type StateSeed, type CountySeed, type TownSeed } from "@/lib/geo";
import { qualifiedCategoriesForTown, fetchBusinesses, isPublished, servesTown, type DirectoryBusiness } from "@/lib/businesses";
import ResultCard from "@/components/site/ResultCard.astro";
import { getCategory } from "@/lib/taxonomy";
import { heroPhotoFor } from "@/lib/town-photos";

interface Props {
  state: StateSeed;
  county: CountySeed;
  town: TownSeed;
}
const { state, county, town } = Astro.props;
const nearby = getNearbyTowns(town);
const heroPhoto = heroPhotoFor(town.stateSlug, town.countySlug, town.slug);
const zips = (town.zips ?? []).filter(Boolean);
// Every published business based in or serving this town — the 3-listing rule
// applies to category list pages, never to hub content.
let townBusinesses: DirectoryBusiness[] = [];
try {
  townBusinesses = (await fetchBusinesses()).filter(
    (b) => isPublished(b) && b.stateSlug === town.stateSlug && servesTown(b, town.slug),
  );
} catch { /* fail soft */ }
const bizByCategory = new Map<string, DirectoryBusiness[]>();
for (const b of townBusinesses) {
  const key = b.primaryCategorySlug ?? "other";
  bizByCategory.set(key, [...(bizByCategory.get(key) ?? []), b]);
}
const bizGroups = [...bizByCategory.entries()]
  .map(([slug, items]) => ({ category: getCategory(slug), items }))
  .sort((a, b) => b.items.length - a.items.length);

const mapPoints = [
  { label: town.name, lat: Number(town.lat), lng: Number(town.lng), primary: true },
  ...townBusinesses
    .filter((b) => Number.isFinite(Number(b.lat)) && Number.isFinite(Number(b.lng)))
    .map((b) => ({ label: b.name ?? "", lat: Number(b.lat), lng: Number(b.lng), href: `/business/${b.slug}` })),
  ...nearby.map((n) => ({ label: n.name, lat: Number(n.lat), lng: Number(n.lng), href: `/${n.pathKey}` })),
];

// Only categories that meet the 3-listing publishing rule get links.
const qualified = [...(await qualifiedCategoriesForTown(town.stateSlug, town.slug)).entries()]
  .map(([slug, count]) => ({ category: getCategory(slug), count }))
  .filter((entry) => entry.category)
  .sort((a, b) => b.count - a.count);
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo
    trail={[
      { name: "Home", path: "/" },
      { name: state.name, path: `/${state.slug}` },
      { name: county.name, path: `/${county.pathKey}` },
      { name: town.name, path: `/${town.pathKey}` },
    ]}
  />

  <header class="mt-4">
    {heroPhoto && (
      <figure class="reveal overflow-hidden rounded-card border border-line">
        <div class="relative">
          <Pic src={heroPhoto.url} alt={heroPhoto.alt} aspect={21 / 9} sizes="(min-width: 1280px) 1152px, 100vw" priority class="max-h-[340px]" />
          <figcaption class="absolute bottom-0 right-0 rounded-tl-card bg-brand-deep/70 px-3 py-1 text-[11px] text-white/90">
            {heroPhoto.caption} · <a href="/credits" class="underline">credit</a>
          </figcaption>
        </div>
      </figure>
    )}
    <div class="mt-6 max-w-prose">
      <h1 class="font-display text-4xl font-bold text-ink">
        Local businesses in {town.name}, {state.abbr}
      </h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">{town.intro}</p>
    </div>
    <dl class="ledger mt-5 flex max-w-xl flex-wrap gap-x-8 gap-y-1 rounded-card border border-line bg-surface px-4 py-2">
      {town.population ? (
        <div class="flex gap-2"><dt class="ledger-key !flex-none">Population</dt><dd class="ledger-val">{Number(town.population).toLocaleString("en-US")}</dd></div>
      ) : null}
      <div class="flex gap-2"><dt class="ledger-key !flex-none">County</dt><dd class="ledger-val">{county.name}</dd></div>
      {zips.length > 0 && (
        <div class="flex gap-2"><dt class="ledger-key !flex-none">ZIP</dt><dd class="ledger-val">{zips.join(", ")}</dd></div>
      )}
    </dl>
  </header>

  <section class="mt-10" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="font-display text-2xl font-semibold text-ink">
      Find a service in {town.name}
    </h2>
    {qualified.length > 0 ? (
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {qualified.map(({ category, count }) => (
          <li class="relative">
            <CategoryTile slug={category!.slug} />
            <a href={`/${town.pathKey}/${category!.slug}`} class="absolute inset-0" aria-label={`${category!.name} in ${town.name} — ${count} listings`}></a>
            <span class="pointer-events-none absolute bottom-3 right-3 rounded-chip bg-surface px-2 py-0.5 text-xs font-semibold text-muted shadow-sm">{count}</span>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-5">
        <CategoriesEmptyState scopeName={town.name} />
      </div>
    )}
  </section>

  {townBusinesses.length > 0 && (
    <section class="mt-12" aria-labelledby="verified-heading">
      <h2 id="verified-heading" class="font-display text-2xl font-semibold text-ink">
        Verified businesses in {town.name}
      </h2>
      <p class="mt-1 text-sm text-muted">
        {townBusinesses.length} published {townBusinesses.length === 1 ? "listing" : "listings"} based in or serving {town.name} — every one passed the four verification checks.
      </p>
      <div class="mt-5 space-y-8">
        {bizGroups.map(({ category, items }, gi) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-faint">
              {category?.name ?? "Other"} · {items.length}
            </h3>
            <div class="mt-3 grid gap-4">
              {items.map((b, i) => {
                const globalIndex = bizGroups.slice(0, gi).reduce((n, g) => n + g.items.length, 0) + i;
                return (
                  <div class:list={[globalIndex >= 12 && "hidden", globalIndex >= 12 && "hub-extra-biz"]}>
                    <ResultCard business={b} layout="horizontal" townName={town.name} />
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
      {townBusinesses.length > 12 && (
        <button
          type="button"
          id="hub-see-all"
          class="mt-4 rounded-chip border border-line-strong px-5 py-2 text-sm font-semibold text-ink hover:bg-inset"
        >
          See all {townBusinesses.length}
        </button>
      )}
      <script is:inline data-astro-rerun>
        (function () {
          var btn = document.getElementById("hub-see-all");
          if (!btn) return;
          btn.addEventListener("click", function () {
            document.querySelectorAll(".hub-extra-biz").forEach(function (el) { el.classList.remove("hidden"); });
            btn.remove();
          });
        })();
      </script>
    </section>
  )}

  {town.localFacts.length > 0 && (
    <section class="mt-12 max-w-prose" aria-labelledby="facts-heading">
      <h2 id="facts-heading" class="font-display text-2xl font-semibold text-ink">
        Good to know in {town.name}
      </h2>
      <ul class="mt-4 space-y-3">
        {town.localFacts.map((fact) => (
          <li class="flex gap-3 rounded-card border border-line bg-surface p-4 text-sm leading-relaxed text-muted">
            <span class="mt-0.5 text-brand" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            {fact}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-12 max-w-prose" aria-labelledby="permits-heading">
    <h2 id="permits-heading" class="font-display text-xl font-semibold text-ink">
      Permits &amp; licensing
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{county.permitNotes}</p>
    <p class="mt-2 text-sm text-faint">
      More on the
      <a href={`/${county.pathKey}`} class="font-medium text-brand underline underline-offset-2">{county.name} hub</a>
      and the
      <a href={`/${state.slug}`} class="font-medium text-brand underline underline-offset-2">{state.name} hub</a>.
    </p>
  </section>

  <div class="mt-12">
    <MethodologyStrip />
  </div>

  {nearby.length > 0 && (
    <section class="mt-12" aria-labelledby="nearby-heading">
      <h2 id="nearby-heading" class="font-display text-xl font-semibold text-ink">
        Nearby towns
      </h2>
      <div class="mt-4">
        <MiniMap client:visible points={mapPoints} className="h-64" />
      </div>
      <ul class="mt-4 flex flex-wrap gap-2">
        {nearby.map((n) => (
          <li>
            <a
              href={`/${n.pathKey}`}
              class="inline-flex min-h-[40px] items-center rounded-chip border border-line bg-surface px-4 py-2 text-sm font-medium text-muted transition-colors hover:border-brand hover:text-ink"
            >
              {n.name}, {n.stateSlug.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</article>
