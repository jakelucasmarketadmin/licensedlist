---
import GetListedForm from "@/components/site/GetListedForm.tsx";
import { SITE_NAME, BUSINESS_CONTACT_EMAIL } from "@/lib/site";
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
  <nav aria-label="Breadcrumb" class="text-sm text-faint">
    <a href="/for-businesses" class="hover:text-ink">For businesses</a>
    <span aria-hidden="true"> / </span>
    <span class="text-muted">Get listed</span>
  </nav>
  <h1 class="mt-3 font-display text-4xl font-bold text-ink">Get listed on {SITE_NAME}</h1>
  <p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">
    Free forever — no credit card. Tell us about your business and we'll build your listing,
    run license verification against the official registry, and send it to you for review
    before anything goes live.
  </p>

  <div class="mt-8 rounded-card border border-line bg-surface p-6">
    <GetListedForm client:load />
  </div>

  <p class="mt-4 text-sm text-faint">
    Prefer email? Send your business name, town, and license number to
    <a href={`mailto:${BUSINESS_CONTACT_EMAIL}`} class="font-medium text-brand underline underline-offset-2">{BUSINESS_CONTACT_EMAIL}</a>.
  </p>
</article>
