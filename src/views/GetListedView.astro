---
import { SITE_NAME, BUSINESS_CONTACT_EMAIL } from "@/lib/site";
import { JOTFORM_FORM_ID, JOTFORM_FORM_URL } from "@/lib/jotform";
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
  <nav aria-label="Breadcrumb" class="text-sm text-faint">
    <a href="/for-businesses" class="hover:text-ink">For businesses</a>
    <span aria-hidden="true"> / </span>
    <span class="text-muted">Get listed</span>
  </nav>
  <h1 class="mt-3 font-display text-4xl font-bold text-ink">Get listed on {SITE_NAME}</h1>
  <p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">
    Free forever — no credit card. Tell us about your business and we'll build your listing,
    run license verification against the official registry, and send it to you for review
    before anything goes live.
  </p>

  <!--
    Do NOT clip this container. The iframe is sized by Jotform's resize
    messages; if a message is ever missed or arrives late the form is taller
    than the frame, and `overflow:hidden` would swallow the rest of it with no
    scrollbar and no way to reach the submit button. Letting the iframe scroll
    itself is the fallback that keeps the form usable no matter what.
  -->
  <div class="mt-8 rounded-card border border-line bg-surface">
    <iframe
      id={`JotFormIFrame-${JOTFORM_FORM_ID}`}
      src={JOTFORM_FORM_URL}
      style="width:100%;height:4200px;border:none;display:block;"
      scrolling="yes"
      title="Add or update your listing"
      allow="geolocation; microphone; camera; fullscreen; payment"
    ></iframe>
  </div>
  <script is:inline data-astro-rerun src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
  <script is:inline data-astro-rerun define:vars={{ formId: JOTFORM_FORM_ID }}>
    // The handler script is a separate request, so a bare
    // `typeof window.jotformEmbedHandler === "function"` check races it: when
    // it loses, auto-resize never initialises and the form is cut off at
    // whatever the fallback height happens to be. Poll briefly instead, and
    // re-attach after client-side navigation (ClientRouter reuses the document).
    (function () {
      var selector = "iframe[id='JotFormIFrame-" + formId + "']";
      var attempts = 0;
      function attach() {
        if (typeof window.jotformEmbedHandler === "function") {
          window.jotformEmbedHandler(selector, "https://form.jotform.com/");
          return true;
        }
        return false;
      }
      function poll() {
        if (attach() || attempts++ > 40) return; // ~10s, then give up gracefully
        setTimeout(poll, 250);
      }
      poll();
      // A viewport change re-flows the form (mobile especially), which makes
      // the previously negotiated height wrong until the next message.
      window.addEventListener("resize", function () { attach(); });
      document.addEventListener("astro:page-load", poll, { once: true });
    })();
  </script>

  <p class="mt-4 text-sm text-faint">
    Form not loading?
    <a href={JOTFORM_FORM_URL} target="_blank" rel="noopener" class="font-medium text-brand underline underline-offset-2">Open it in a new tab</a>
    — or email your business name, town, and license number to
    <a href={`mailto:${BUSINESS_CONTACT_EMAIL}`} class="font-medium text-brand underline underline-offset-2">{BUSINESS_CONTACT_EMAIL}</a>.
  </p>
</article>
