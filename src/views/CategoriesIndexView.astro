---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import { getCategoryGroups, getCategoriesByGroup } from "@/lib/taxonomy";
import { fetchBusinesses, isPublished, categoriesOf } from "@/lib/businesses";

const groups = getCategoryGroups();

// Published-listing counts per category; a CMS hiccup renders all-zero counts
// rather than failing the page.
const counts = new Map<string, number>();
try {
  for (const b of (await fetchBusinesses()).filter(isPublished)) {
    for (const slug of categoriesOf(b)) counts.set(slug, (counts.get(slug) ?? 0) + 1);
  }
} catch { /* counts stay empty */ }
const countOf = (slug: string) => counts.get(slug) ?? 0;
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={[{ name: "Home", path: "/" }, { name: "Categories", path: "/categories" }]} />

  <header class="mt-4 flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-prose">
      <h1 class="font-display text-4xl font-bold text-ink">All categories</h1>
      <p class="mt-3 text-lg text-muted">
        Every service we cover across New Jersey, New York &amp; Pennsylvania.
      </p>
    </div>
    <button
      type="button"
      id="toggle-empty"
      aria-pressed="false"
      class="rounded-chip border border-line-strong px-4 py-2 text-sm font-medium text-muted transition-colors hover:bg-inset hover:text-ink"
    >
      Show all categories
    </button>
  </header>

  <div class="mt-10 space-y-10" id="category-groups">
    {groups.map((group) => (
      <section aria-labelledby={`group-${group.slug}`}>
        <h2 id={`group-${group.slug}`} class="font-display text-2xl font-semibold text-ink">
          {group.name}
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {getCategoriesByGroup(group.slug).map((category) => {
            const n = countOf(category.slug);
            return (
              <li class:list={[n === 0 && "zero-count hidden"]}>
                <a
                  href={`/${category.slug}`}
                  class="inline-flex min-h-[40px] items-center gap-2 rounded-chip border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-brand hover:bg-brand-wash"
                >
                  {category.name}
                  {n > 0 ? (
                    <span class="rounded-chip bg-inset px-1.5 py-0.5 text-[11px] font-semibold text-muted">{n}</span>
                  ) : (
                    <span class="text-[11px] text-faint">coming soon</span>
                  )}
                  {category.licenseRequired && (
                    <span class="text-[11px] font-normal text-faint" title="Listings in this category are checked against the official state registry">· licensed trade</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>

  <script is:inline data-astro-rerun>
    (function () {
      var btn = document.getElementById("toggle-empty");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var showing = btn.getAttribute("aria-pressed") === "true";
        document.querySelectorAll("#category-groups .zero-count").forEach(function (li) {
          li.classList.toggle("hidden", showing);
        });
        btn.setAttribute("aria-pressed", String(!showing));
        btn.textContent = showing ? "Show all categories" : "Show only categories with listings";
      });
    })();
  </script>
</article>
