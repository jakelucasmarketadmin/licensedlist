---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import { getCategoryGroups, getCategoriesByGroup } from "@/lib/taxonomy";

const groups = getCategoryGroups();
---

<article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={[{ name: "Home", path: "/" }, { name: "Categories", path: "/categories" }]} />

  <header class="mt-4 max-w-prose">
    <h1 class="font-display text-4xl font-bold text-ink">All categories</h1>
    <p class="mt-3 text-lg text-muted">
      Every service we cover across New Jersey, New York &amp; Pennsylvania.
    </p>
  </header>

  <div class="mt-10 space-y-10">
    {groups.map((group) => (
      <section aria-labelledby={`group-${group.slug}`}>
        <h2 id={`group-${group.slug}`} class="font-display text-2xl font-semibold text-ink">
          {group.name}
        </h2>
        <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
          {getCategoriesByGroup(group.slug).map((category) => (
            <li>
              <a
                href={`/${category.slug}`}
                class="block rounded-card border border-line bg-surface px-4 py-3 text-sm font-medium text-ink transition-colors hover:border-brand hover:bg-brand-wash"
              >
                {category.name}
                {category.licenseRequired && (
                  <span class="mt-0.5 block text-[11px] font-normal text-faint">Licensed trade</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</article>
