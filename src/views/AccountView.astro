---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import AccountPortal from "@/components/site/AccountPortal.tsx";
---

<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={[{ name: "Home", path: "/" }, { name: "My projects", path: "/account" }]} />
  <h1 class="mt-4 font-display text-4xl font-bold text-ink">My projects</h1>
  <p class="mt-3 max-w-prose text-muted">
    Every quote request becomes a project — the pros you contacted and where each one stands.
    Saved businesses live on <a href="/saved" class="font-medium text-brand underline underline-offset-2">your saved list</a>.
  </p>
  <div class="mt-8">
    <AccountPortal client:only="react" />
  </div>
</article>
