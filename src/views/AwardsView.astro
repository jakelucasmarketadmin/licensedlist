---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import { allAwards, awardLabel, isDemoAward } from "@/lib/awards";
import { getBusinessBySlug } from "@/lib/businesses";
import ResultCard from "@/components/site/ResultCard.astro";
import { SITE_NAME } from "@/lib/site";

/**
 * /awards (C4) — "TriVetted Best of {County} {Year}": public methodology +
 * published winners. Data-driven, never pay-to-play; DEMO winners render only
 * behind ?preview=demo until real review data qualifies anyone.
 */
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
const awards = await allAwards(preview);
const withBiz = (
  await Promise.all(
    awards.map(async (a) => ({ award: a, biz: await getBusinessBySlug(a.businessSlug ?? "", preview) })),
  )
).filter((x) => x.biz);

const CRITERIA = [
  { label: "License verified", detail: "against the official state or city registry, with the receipt shown on the profile." },
  { label: "≥5 verified-hire reviews", detail: "on-site reviews from customers whose hire went through a TriVetted quote request — invitations go to every customer, never only happy ones." },
  { label: "≥4.7 aspect average", detail: "across Quality, Communication, Value, and Timeliness on those verified reviews." },
  { label: "Responds in under 24 hours", detail: "measured typical response time to quote requests." },
  { label: "No unresolved complaints", detail: "every flagged review re-checked and resolved before the award is considered." },
];
---

<article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={[{ name: "Home", path: "/" }, { name: "Awards", path: "/awards" }]} />

  {preview && (
    <p class="mt-4 rounded-card border border-warn bg-warn-wash px-4 py-3 text-sm font-medium text-warn">
      Preview mode — showing clearly-labeled sample winners. This view is not indexed and not
      visible to visitors.
    </p>
  )}

  <header class="mt-4 grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_220px]">
    <div class="max-w-prose">
      <h1 class="font-display text-4xl font-bold text-ink">{SITE_NAME} Best of {"{County}"} awards</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">
        A data-driven annual award — computed from verified licenses and verified-hire reviews,
        reviewed by our editorial team, and <span class="font-semibold text-ink">never for sale</span>.
        There is no entry fee, no sponsorship tier, and no way to buy a spot.
      </p>
    </div>
    <img src="/assets/awards/best-of-bergen-county-2026-demo.svg" alt="Sample Best of Bergen County 2026 badge" width="220" height="257" class="mx-auto" loading="lazy" />
  </header>

  <section class="mt-10" aria-labelledby="criteria-heading">
    <h2 id="criteria-heading" class="font-display text-2xl font-semibold text-ink">The methodology, in full</h2>
    <p class="mt-1 max-w-prose text-sm text-muted">
      Every criterion is required. Winners are recomputed each year from the same data shown
      publicly on their profiles.
    </p>
    <ol class="mt-4 grid gap-3 sm:grid-cols-2">
      {CRITERIA.map((c, i) => (
        <li class="rounded-card border border-line bg-surface p-4">
          <p class="font-mono text-xs text-faint">{i + 1}</p>
          <h3 class="mt-0.5 font-display text-base font-semibold text-ink">{c.label}</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">{c.detail}</p>
        </li>
      ))}
    </ol>
    <p class="mt-3 max-w-prose text-xs leading-relaxed text-faint">
      Winners may display their badge on their own website with a plain link back — we provide
      the image, never embed code with hidden links. Businesses can't nominate themselves or
      anyone else; the data does the nominating.
    </p>
  </section>

  <section class="mt-12" aria-labelledby="winners-heading">
    <h2 id="winners-heading" class="font-display text-2xl font-semibold text-ink">Winners</h2>
    {withBiz.length === 0 ? (
      <div class="mt-4 max-w-prose rounded-card border border-line bg-surface p-6">
        <p class="text-sm leading-relaxed text-muted">
          The first awards publish once enough verified-hire review data exists to clear the bar
          — no winners get named before the data supports it. Verified businesses collecting
          reviews through {SITE_NAME} today are building their case for the first cohort.
        </p>
      </div>
    ) : (
      <div class="mt-4 space-y-6">
        {withBiz.map(({ award, biz }) => (
          <div>
            <p class="mb-2 flex items-center gap-2 text-sm font-semibold text-ink">
              {awardLabel(award)}
              {isDemoAward(award) && <span class="rounded-chip bg-warn-wash px-2 py-0.5 text-[11px] font-semibold uppercase text-warn">Sample</span>}
            </p>
            <ResultCard business={biz!} layout="horizontal" />
          </div>
        ))}
      </div>
    )}
  </section>
</article>
