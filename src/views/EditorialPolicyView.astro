---
import { SITE_NAME } from "@/lib/site";

const RULES = [
  {
    title: "Money never buys ranking",
    body: "Paid tiers buy verification work and labeled placement — nothing else. The organic order of every list is set by a public score (license verification, review count, rating, freshness) that no payment, claim, or agency relationship can influence.",
  },
  {
    title: "Paid placement is always labeled",
    body: "Featured and sponsored listings are visibly marked on the page and carry sponsored link attributes for search engines. Businesses that are clients of our agency are disclosed as sponsored wherever they appear.",
  },
  {
    title: "Reviews are never gated or filtered",
    body: "When we or a business invite reviews, the invitation goes to all customers — never only the happy ones. We do not edit, suppress, or reorder reviews based on sentiment or payment. Aggregate ratings shown to search engines come only from real user ratings, never from our own editorial scores.",
  },
  {
    title: "We don't invent facts",
    body: "Every factual claim on a listing — license status, years in business, ratings — has a recorded source. Where we don't have data, listings say so plainly. Demo or placeholder records used during development are labeled as samples and never presented as real businesses.",
  },
  {
    title: "AI assistance is disclosed",
    body: "Some descriptive copy is drafted with AI assistance and reviewed by a person before publishing. Pages carrying AI-assisted copy note it. Verification decisions are always made by a person against the official source.",
  },
  {
    title: "Corrections are fast and logged",
    body: "If a business, customer, or reader reports an error, we re-check the claim against its source and correct the page. Listings show the date of their last verification, and material corrections update that date.",
  },
];
---

<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Editorial policy</p>
  <h1 class="mt-3 font-display text-4xl font-bold text-ink">The rules we can't break</h1>
  <p class="mt-4 max-w-prose text-lg leading-relaxed text-muted">
    {SITE_NAME} makes money from businesses and serves consumers. That only works if the line
    between the two is bright and permanent. These are the rules, in plain English.
  </p>

  <ol class="mt-10 space-y-5">
    {RULES.map((rule) => (
      <li class="rounded-card border border-line bg-surface p-5">
        <h2 class="font-display text-lg font-semibold text-ink">{rule.title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">{rule.body}</p>
      </li>
    ))}
  </ol>

  <p class="mt-10 max-w-prose text-sm leading-relaxed text-faint">
    Related: <a href="/how-we-verify" class="font-medium text-brand underline underline-offset-2">how we verify</a> explains
    the checks behind each badge and where our license data comes from.
  </p>
</article>
