---
import BreadcrumbGeo from "@/components/site/BreadcrumbGeo.astro";
import SavedPortal from "@/components/site/SavedPortal.tsx";
---

<article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-14">
  <BreadcrumbGeo trail={[{ name: "Home", path: "/" }, { name: "Saved", path: "/saved" }]} />
  <h1 class="mt-4 font-display text-4xl font-bold text-ink">Saved businesses</h1>
  <p class="mt-3 max-w-prose text-muted">
    The pros you've hearted, plus their new reviews and current deals. My projects live under
    <a href="/account" class="font-medium text-brand underline underline-offset-2">your account</a>.
  </p>
  <div class="mt-8">
    <SavedPortal client:only="react" />
  </div>
</article>
