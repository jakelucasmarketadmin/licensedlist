---
/**
 * A published data study (§7.4) — original research with a stable URL,
 * Dataset schema, full methodology and a downloadable CSV.
 *
 * The point is to be citable: a regional newsroom has no capacity to analyse
 * public licence data itself (US local newsrooms average 7.8 journalist-
 * equivalents per 100,000 residents, down ~81% since 2002), but will run a
 * clean, local, pre-packaged finding. Everything a fact-checker needs —
 * sources, period, method, limitations, byline, retrieval dates — is on the
 * page, not in a press release.
 */
import type { Study } from "@/lib/studies";
interface Props { study: Study }
const { study } = Astro.props;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:py-14">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Data study · {study.period}</p>
  <h1 class="mt-3 font-display text-4xl font-bold text-ink">{study.title}</h1>
  <p class="mt-4 text-lg leading-relaxed text-muted">{study.summary}</p>
  <p class="mt-3 text-sm text-faint">
    By the {study.author} · Published {fmt(study.publishedAt)}
    {study.updatedAt !== study.publishedAt && <> · Updated {fmt(study.updatedAt)}</>}
    {study.aiAssisted && <> · AI tools assisted with analysis; a person checked every figure</>}
  </p>

  {study.csvPath && (
    <p class="mt-6">
      <a href={study.csvPath} download class="inline-flex items-center rounded-chip bg-accent px-5 py-2.5 text-sm font-semibold text-accent-ink hover:bg-accent-hover">
        Download the full dataset (CSV)
      </a>
    </p>
  )}

  {study.rows.length > 0 && (
    <section class="mt-10" aria-labelledby="data-heading">
      <h2 id="data-heading" class="font-display text-2xl font-semibold text-ink">The data</h2>
      <div class="mt-4 overflow-x-auto rounded-card border border-line">
        <table class="w-full border-collapse text-sm">
          <caption class="sr-only">{study.title}, {study.period}</caption>
          <thead>
            <tr class="bg-inset text-left">
              {study.columns.map((c) => (
                <th scope="col" class="px-4 py-3 font-semibold text-ink">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {study.rows.map((row) => (
              <tr class="border-t border-line">
                {study.columns.map((c, i) => (
                  i === 0
                    ? <th scope="row" class="px-4 py-2.5 text-left font-medium text-ink">{row[c]}</th>
                    : <td class="px-4 py-2.5 font-mono text-muted">{row[c]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="mt-10 max-w-prose" aria-labelledby="method-heading">
    <h2 id="method-heading" class="font-display text-2xl font-semibold text-ink">How we did this</h2>
    <p class="mt-3 leading-relaxed text-muted">{study.methodology}</p>
  </section>

  <section class="mt-8 max-w-prose" aria-labelledby="limits-heading">
    <h2 id="limits-heading" class="font-display text-2xl font-semibold text-ink">
      What this does not show
    </h2>
    <p class="mt-3 leading-relaxed text-muted">{study.limitations}</p>
  </section>

  {study.sources.length > 0 && (
    <section class="mt-8 max-w-prose" aria-labelledby="src-heading">
      <h2 id="src-heading" class="font-display text-2xl font-semibold text-ink">Sources</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
        {study.sources.map((s) => (
          <li>
            <a href={s.url} rel="nofollow noopener" target="_blank" class="underline underline-offset-2 hover:text-ink">{s.label}</a>
            {s.retrievedAt && <span class="text-faint"> · retrieved {s.retrievedAt}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="mt-10 rounded-card border border-line bg-surface p-5 text-sm leading-relaxed text-muted">
    <strong class="text-ink">Reusing this?</strong> The dataset is free to
    republish with attribution. If you are writing about it and want the
    underlying records, the per-town breakdown, or a comment, email
    <a href="mailto:admin@tier201.com" class="underline underline-offset-2">admin@tier201.com</a>.
  </p>
</article>
