---
import SiteLayout from "@/layouts/SiteLayout.astro";
import HomeView from "@/views/HomeView.astro";
import HowWeVerifyView from "@/views/HowWeVerifyView.astro";
import ForBusinessesView from "@/views/ForBusinessesView.astro";
import AboutView from "@/views/AboutView.astro";
import EditorialPolicyView from "@/views/EditorialPolicyView.astro";
import PrivacyView from "@/views/PrivacyView.astro";
import TermsView from "@/views/TermsView.astro";
import SearchView from "@/views/SearchView.astro";
import NotFoundView from "@/views/NotFoundView.astro";
import { SITE_NAME } from "@/lib/site";
import { organizationJsonLd, webSiteJsonLd, resolveOrigin, type PageSeo } from "@/lib/seo";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

// Normalize: treat trailing-slash variants as the canonical no-slash path.
const rawPath = new URL(Astro.request.url).pathname;
const pathname = rawPath === "/" ? "/" : rawPath.replace(/\/+$/, "");

// The route allow-list: unknown paths are a real 404 (status + noindex).
// Pages are fully server-rendered — no client-side router.
interface RouteEntry {
  view: (props: Record<string, unknown>) => unknown;
  seo: PageSeo;
}

const routes: Record<string, RouteEntry> = {
  "/": {
    view: HomeView,
    seo: {
      title: `${SITE_NAME} · Verified Local Pros in NJ, NY & PA`,
      description:
        "Find licensed, vetted local businesses across New Jersey, New York & Pennsylvania. Every verified badge names the official state registry it was checked against — and the date we checked.",
      path: "/",
    },
  },
  "/how-we-verify": {
    view: HowWeVerifyView,
    seo: {
      title: `How We Verify Local Businesses · ${SITE_NAME}`,
      description:
        "The exact checks behind every badge: identity, license verification against official state registries, cross-platform review analysis, and responsiveness — plus how listings are ordered.",
      path: "/how-we-verify",
    },
  },
  "/for-businesses": {
    view: ForBusinessesView,
    seo: {
      title: `List Your Business · ${SITE_NAME}`,
      description:
        "Claim your free listing and get your license verified against the official state registry. Paid placement is always labeled and never changes rankings or reviews.",
      path: "/for-businesses",
    },
  },
  "/about": {
    view: AboutView,
    seo: {
      title: `About · ${SITE_NAME}`,
      description:
        "Why we built a local directory that verifies licenses against official state registries — and the disclosures that keep it honest.",
      path: "/about",
    },
  },
  "/editorial-policy": {
    view: EditorialPolicyView,
    seo: {
      title: `Editorial Policy · ${SITE_NAME}`,
      description:
        "The rules we can't break: money never buys ranking, paid placement is always labeled, reviews are never gated, and every fact has a source.",
      path: "/editorial-policy",
    },
  },
  "/privacy": {
    view: PrivacyView,
    seo: {
      title: `Privacy Policy · ${SITE_NAME}`,
      description: `What ${SITE_NAME} collects, how quote requests are shared with local businesses, and the choices you have over your information.`,
      path: "/privacy",
    },
  },
  "/terms": {
    view: TermsView,
    seo: {
      title: `Terms of Use · ${SITE_NAME}`,
      description: `The terms for using ${SITE_NAME}: what verification means, review standards, and the rules for business listings.`,
      path: "/terms",
    },
  },
  "/search": {
    view: SearchView,
    seo: {
      title: `Search · ${SITE_NAME}`,
      description: `Search ${SITE_NAME} for verified local businesses in New Jersey, New York & Pennsylvania.`,
      path: "/search",
      robots: "noindex, follow",
    },
  },
};

const entry = routes[pathname];
const origin = resolveOrigin(Astro.url.origin);
const homeJsonLd = [webSiteJsonLd(origin), organizationJsonLd(origin)];

if (!entry) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const notFoundSeo: PageSeo = {
  title: `Page Not Found · ${SITE_NAME}`,
  description: "This page doesn't exist.",
  path: pathname,
  robots: "noindex, nofollow",
};

const searchProps =
  pathname === "/search"
    ? {
        what: Astro.url.searchParams.get("what")?.slice(0, 100) ?? "",
        where: Astro.url.searchParams.get("where")?.slice(0, 100) ?? "",
      }
    : {};

const View = entry?.view ?? NotFoundView;
---

<SiteLayout seo={entry?.seo ?? notFoundSeo} jsonLd={pathname === "/" && entry ? homeJsonLd : []}>
  <View {...searchProps} />
</SiteLayout>
