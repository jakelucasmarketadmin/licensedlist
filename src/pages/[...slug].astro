---
import SiteLayout from "@/layouts/SiteLayout.astro";
import HomeView from "@/views/HomeView.astro";
import HowWeVerifyView from "@/views/HowWeVerifyView.astro";
import ForBusinessesView from "@/views/ForBusinessesView.astro";
import GetListedView from "@/views/GetListedView.astro";
import AboutView from "@/views/AboutView.astro";
import EditorialPolicyView from "@/views/EditorialPolicyView.astro";
import PrivacyView from "@/views/PrivacyView.astro";
import TermsView from "@/views/TermsView.astro";
import SearchView from "@/views/SearchView.astro";
import NotFoundView from "@/views/NotFoundView.astro";
import { SITE_NAME } from "@/lib/site";
import { ROUTE_SEO } from "@/lib/routes";
import {
  organizationJsonLd,
  webSiteJsonLd,
  breadcrumbJsonLd,
  resolveOrigin,
  type PageSeo,
} from "@/lib/seo";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

// Normalize: treat trailing-slash variants as the canonical no-slash path.
const rawPath = new URL(Astro.request.url).pathname;
const pathname = rawPath === "/" ? "/" : rawPath.replace(/\/+$/, "");

// Path → view. SEO for each path lives in src/lib/routes.ts (shared with the
// sitemap endpoints). Unknown paths are a real 404 (status + noindex).
const VIEWS: Record<string, (props: Record<string, unknown>) => unknown> = {
  "/": HomeView,
  "/how-we-verify": HowWeVerifyView,
  "/for-businesses": ForBusinessesView,
  "/for-businesses/get-listed": GetListedView,
  "/about": AboutView,
  "/editorial-policy": EditorialPolicyView,
  "/privacy": PrivacyView,
  "/terms": TermsView,
  "/search": SearchView,
};

const seo = ROUTE_SEO[pathname];
const View = seo ? VIEWS[pathname] : undefined;
const origin = resolveOrigin();

// Temporary M2 probe (not in ROUTE_SEO → 404-path handled separately below):
// verifies that CMS reads work server-side before hub pages are built on them.
let probeResult: string | null = null;
if (pathname === "/__data-probe") {
  try {
    const integrations = await import("@/integrations");
    const result: any = await integrations.BaseCrudService.getAll("businesses");
    const count = Array.isArray(result) ? result.length : result?.items?.length;
    probeResult = `ok count=${String(count)}`;
  } catch (e: any) {
    probeResult = `error: ${e?.message ?? String(e)}`;
  }
}

// JSON-LD: WebSite + Organization on home; BreadcrumbList on every other page.
let jsonLd: object[] = [];
if (seo && View) {
  jsonLd =
    pathname === "/"
      ? [webSiteJsonLd(origin), organizationJsonLd(origin)]
      : [
          breadcrumbJsonLd(origin, [
            { name: "Home", path: "/" },
            ...(pathname === "/for-businesses/get-listed"
              ? [
                  { name: "For businesses", path: "/for-businesses" },
                  { name: seo.crumb ?? seo.title, path: seo.path },
                ]
              : [{ name: seo.crumb ?? seo.title, path: seo.path }]),
          ]),
        ];
}

if (!seo && probeResult === null) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const notFoundSeo: PageSeo = {
  title: `Page Not Found · ${SITE_NAME}`,
  description: "This page doesn't exist.",
  path: pathname,
  robots: "noindex, nofollow",
};

const searchProps =
  pathname === "/search"
    ? {
        what: (
          Astro.url.searchParams.get("what") ??
          Astro.url.searchParams.get("q") ??
          ""
        ).slice(0, 100),
        where: Astro.url.searchParams.get("where")?.slice(0, 100) ?? "",
      }
    : {};

const RenderView = View ?? NotFoundView;
---

{probeResult !== null ? (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="robots" content="noindex, nofollow" />
      <title>probe</title>
    </head>
    <body>
      <pre>{probeResult}</pre>
    </body>
  </html>
) : (
  <SiteLayout seo={seo ?? notFoundSeo} jsonLd={jsonLd}>
    <RenderView {...searchProps} />
  </SiteLayout>
)}
