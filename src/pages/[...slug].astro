---
import SiteLayout from "@/layouts/SiteLayout.astro";
import HomeView from "@/views/HomeView.astro";
import HowWeVerifyView from "@/views/HowWeVerifyView.astro";
import ForBusinessesView from "@/views/ForBusinessesView.astro";
import GetListedView from "@/views/GetListedView.astro";
import GetListedBasicView from "@/views/GetListedBasicView.astro";
import CreditsView from "@/views/CreditsView.astro";
import AboutView from "@/views/AboutView.astro";
import EditorialPolicyView from "@/views/EditorialPolicyView.astro";
import PrivacyView from "@/views/PrivacyView.astro";
import TermsView from "@/views/TermsView.astro";
import SearchView from "@/views/SearchView.astro";
import NotFoundView from "@/views/NotFoundView.astro";
import StateHubView from "@/views/StateHubView.astro";
import CountyHubView from "@/views/CountyHubView.astro";
import TownHubView from "@/views/TownHubView.astro";
import ListingsView from "@/views/ListingsView.astro";
import BusinessProfileView from "@/views/BusinessProfileView.astro";
import CategoryHubView from "@/views/CategoryHubView.astro";
import CategoriesIndexView from "@/views/CategoriesIndexView.astro";
import PricingView from "@/views/PricingView.astro";
import ClaimView from "@/views/ClaimView.astro";
import ClaimBusinessView from "@/views/ClaimBusinessView.astro";
import OwnerView from "@/views/OwnerView.astro";
import WriteReviewView from "@/views/WriteReviewView.astro";
import FoundingMembersView from "@/views/FoundingMembersView.astro";
import EventsView from "@/views/EventsView.astro";
import DealsView from "@/views/DealsView.astro";
import GuidesIndexView from "@/views/GuidesIndexView.astro";
import AwardsView from "@/views/AwardsView.astro";
import SavedView from "@/views/SavedView.astro";
import AccountView from "@/views/AccountView.astro";
import AiInfoView from "@/views/AiInfoView.astro";
import RemoveListingView from "@/views/RemoveListingView.astro";
import WhyVerifiedView from "@/views/WhyVerifiedView.astro";
import { SITE_NAME } from "@/lib/site";
import { ROUTE_SEO } from "@/lib/routes";
import { matchHubPath, getState, getCounty, getTown } from "@/lib/geo";
import { getCategory } from "@/lib/taxonomy";
import {
  listForTownCategory,
  listForCountyCategory,
  listForStateCategory,
  getBusinessBySlug,
  type ListingSet,
} from "@/lib/businesses";
import { fetchReviewsFor, fetchServicePricesFor, fetchQuestionsFor } from "@/lib/reviews";
import { photosOf } from "@/lib/businesses";
import { imageAt, srcsetFor } from "@/lib/images";
import {
  organizationJsonLd,
  webSiteJsonLd,
  breadcrumbJsonLd,
  itemListJsonLd,
  localBusinessJsonLd,
  resolveOrigin,
  type PageSeo,
} from "@/lib/seo";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

// Normalize: treat trailing-slash variants as the canonical no-slash path.
const rawPath = new URL(Astro.request.url).pathname;
const pathname = rawPath === "/" ? "/" : rawPath.replace(/\/+$/, "");
const segments = pathname.replace(/^\/+/, "").split("/").filter(Boolean);

const preview = Astro.url.searchParams.get("preview") === "demo";
const filter = Astro.url.searchParams.get("filter") ?? undefined;
const origin = resolveOrigin();
const truncate = (text: string, max = 155) =>
  text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text;

const VIEWS: Record<string, (props: Record<string, unknown>) => unknown> = {
  "/": HomeView,
  "/how-we-verify": HowWeVerifyView,
  "/for-businesses": ForBusinessesView,
  "/for-businesses/get-listed": GetListedView,
  "/for-businesses/get-listed-basic": GetListedBasicView,
  "/about": AboutView,
  "/editorial-policy": EditorialPolicyView,
  "/privacy": PrivacyView,
  "/terms": TermsView,
  "/search": SearchView,
  "/categories": CategoriesIndexView,
  "/pricing": PricingView,
  "/claim": ClaimView,
  "/owner": OwnerView,
  "/write-review": WriteReviewView,
  "/founding-members": FoundingMembersView,
  "/events": EventsView,
  "/deals": DealsView,
  "/guides": GuidesIndexView,
  "/awards": AwardsView,
  "/saved": SavedView,
  "/account": AccountView,
  "/ai-info": AiInfoView,
  "/remove-listing": RemoveListingView,
  "/credits": CreditsView,
  "/for-businesses/why-verified": WhyVerifiedView,
};

let seo: PageSeo | undefined = ROUTE_SEO[pathname];
let View: ((props: Record<string, unknown>) => unknown) | undefined = seo
  ? VIEWS[pathname]
  : undefined;
let viewProps: Record<string, unknown> = {};
let jsonLd: object[] = [];
let trail: { name: string; path: string }[] | null = null;
let preloadImage: { href: string; imagesrcset?: string; imagesizes?: string } | undefined;

// --- Business profile: /business/{slug} -------------------------------------
if (!View && segments.length === 2 && segments[0] === "business") {
  const business = await getBusinessBySlug(segments[1], preview);
  if (business) {
    const slug = business.slug ?? "";
    const [reviews, servicePrices, questions] = await Promise.all([
      fetchReviewsFor(slug),
      fetchServicePricesFor(slug),
      fetchQuestionsFor(slug),
    ]);
    const state = business.stateSlug ? getState(business.stateSlug) : undefined;
    const county =
      business.stateSlug && business.countySlug
        ? getCounty(business.stateSlug, business.countySlug)
        : undefined;
    const town =
      business.stateSlug && business.countySlug && business.townSlug
        ? getTown(business.stateSlug, business.countySlug, business.townSlug)
        : undefined;
    const category = business.primaryCategorySlug
      ? getCategory(business.primaryCategorySlug)
      : undefined;
    trail = [
      { name: "Home", path: "/" },
      ...(state ? [{ name: state.name, path: `/${state.slug}` }] : []),
      ...(county ? [{ name: county.name, path: `/${county.pathKey}` }] : []),
      ...(town ? [{ name: town.name, path: `/${town.pathKey}` }] : []),
      { name: business.name ?? "Business", path: pathname },
    ];
    View = BusinessProfileView;
    viewProps = { business, trail, reviews, servicePrices, questions };
    // Preload the mosaic's main image — the profile's LCP element.
    const mainPhoto = photosOf(business)[0];
    if (mainPhoto) {
      preloadImage = {
        href: imageAt(mainPhoto, 1280),
        imagesrcset: srcsetFor(mainPhoto),
        imagesizes: "(min-width: 768px) 60vw, 100vw",
      };
    }
    seo = {
      title: `${business.name} · ${category?.name ?? "Local Business"} in ${business.city}, ${business.state} · ${SITE_NAME}`,
      description: truncate(business.description ?? `${business.name} on ${SITE_NAME}.`),
      path: pathname,
      // DEMO drafts render only in preview and are never indexable.
      robots: business.status === "published" ? undefined : "noindex, nofollow",
    };
    jsonLd = [
      breadcrumbJsonLd(origin, trail),
      // aggregateRating only from real on-site published reviews, only at ≥3
      // (docs/REVIEWS.md) — never for DEMO records.
      localBusinessJsonLd(
        origin,
        { ...business, schemaType: category?.schemaType },
        business.status === "published"
          ? reviews.map((r) => ({
              rating: r.rating,
              reviewerName: r.reviewerName,
              body: r.body,
              createdAt: r._createdDate ? new Date(r._createdDate).toISOString() : undefined,
            }))
          : [],
      ),
    ];
  }
}

// --- Claim a specific listing: /claim/{slug} ---------------------------------
if (!View && segments.length === 2 && segments[0] === "claim") {
  const business = await getBusinessBySlug(segments[1], true);
  if (business) {
    View = ClaimBusinessView;
    viewProps = { business };
    seo = {
      title: `Claim ${business.name} · ${SITE_NAME}`,
      description: `Verify ownership of ${business.name} and take control of the listing — free forever.`,
      path: pathname,
      robots: "noindex, follow",
    };
  }
}

// --- Geography hubs ----------------------------------------------------------
if (!View) {
  const hub = matchHubPath(pathname);
  if (hub) {
    const { state, county, town } = hub;
    if (hub.kind === "state") {
      View = StateHubView;
      viewProps = { state };
      seo = {
        title: `Local Pros Across ${state.name} (${state.abbr}) · ${SITE_NAME}`,
        description: truncate(state.intro),
        path: `/${state.slug}`,
      };
      trail = [
        { name: "Home", path: "/" },
        { name: state.name, path: `/${state.slug}` },
      ];
    } else if (hub.kind === "county" && county) {
      View = CountyHubView;
      viewProps = { state, county };
      seo = {
        title: `${county.name}, ${state.abbr} Local Services · ${SITE_NAME}`,
        description: truncate(county.intro),
        path: `/${county.pathKey}`,
      };
      trail = [
        { name: "Home", path: "/" },
        { name: state.name, path: `/${state.slug}` },
        { name: county.name, path: `/${county.pathKey}` },
      ];
    } else if (hub.kind === "town" && county && town) {
      View = TownHubView;
      viewProps = { state, county, town };
      seo = {
        title: `Local Businesses in ${town.name}, ${state.abbr} · ${SITE_NAME}`,
        description: truncate(town.intro),
        path: `/${town.pathKey}`,
      };
      trail = [
        { name: "Home", path: "/" },
        { name: state.name, path: `/${state.slug}` },
        { name: county.name, path: `/${county.pathKey}` },
        { name: town.name, path: `/${town.pathKey}` },
      ];
    }
    if (trail) jsonLd = [breadcrumbJsonLd(origin, trail)];
  }
}

// --- Geo × category list pages ----------------------------------------------
// /{state}/{category}, /{state}/{county}/{category}, /{state}/{county}/{town}/{category}
if (!View && segments.length >= 2 && segments.length <= 4) {
  const category = getCategory(segments[segments.length - 1]);
  const state = category ? getState(segments[0]) : undefined;
  if (category && state) {
    const geoSegments = segments.slice(1, -1);
    const county = geoSegments.length >= 1 ? getCounty(state.slug, geoSegments[0]) : undefined;
    const town =
      geoSegments.length === 2 && county
        ? getTown(state.slug, county.slug, geoSegments[1])
        : undefined;
    const geoValid =
      geoSegments.length === 0 ||
      (geoSegments.length === 1 && county) ||
      (geoSegments.length === 2 && town);

    if (geoValid) {
      let listings: ListingSet;
      let scope: "town" | "county" | "state";
      if (town && county) {
        scope = "town";
        listings = await listForTownCategory(state.slug, town.slug, category.slug, preview);
      } else if (county) {
        scope = "county";
        listings = await listForCountyCategory(state.slug, county.slug, category.slug, preview);
      } else {
        scope = "state";
        listings = await listForStateCategory(state.slug, category.slug, preview);
      }

      // The publishing rule: a list page below 3 listings does not exist
      // (except in explicit preview mode, which is always noindex).
      if (listings.organic.length >= 3 || (preview && listings.organic.length > 0)) {
        const placeName = town ? `${town.name}, ${state.abbr}` : (county?.name ?? state.name);
        trail = [
          { name: "Home", path: "/" },
          { name: state.name, path: `/${state.slug}` },
          ...(county ? [{ name: county.name, path: `/${county.pathKey}` }] : []),
          ...(town ? [{ name: town.name, path: `/${town.pathKey}` }] : []),
          { name: category.name, path: pathname },
        ];
        View = ListingsView;
        viewProps = {
          scope,
          state,
          county,
          town,
          category,
          listings,
          filter,
          preview,
          trail,
          basePath: pathname,
        };
        const updatedLabel = new Date().toLocaleDateString("en-US", {
          month: "long",
          year: "numeric",
        });
        seo = {
          title: `${listings.organic.length} Best ${category.name} in ${placeName} (Updated ${updatedLabel}) · ${SITE_NAME}`,
          description: truncate(
            `The best ${category.name.toLowerCase()} in ${placeName}, ranked by verified licenses, real reviews, and responsiveness — never by payment. Updated ${updatedLabel}.`,
          ),
          path: pathname,
          robots: preview || filter ? "noindex, follow" : undefined,
        };
        jsonLd = [
          breadcrumbJsonLd(origin, trail),
          itemListJsonLd(
            origin,
            listings.organic
              .filter((b) => b.status === "published")
              .map((b) => ({
                name: b.name ?? "",
                slug: b.slug ?? "",
                schemaType: category.schemaType,
              })),
          ),
        ];
      }
    }
  }
}

// --- Category hub: /{category} ----------------------------------------------
if (!View && segments.length === 1) {
  const category = getCategory(segments[0]);
  if (category) {
    View = CategoryHubView;
    viewProps = { category };
    seo = {
      title: `${category.name} in NJ, NY & PA · ${SITE_NAME}`,
      description: truncate(
        `Find ${category.name.toLowerCase()} across New Jersey, New York & Pennsylvania${category.licenseRequired ? " — every verified listing names the official license registry we checked" : ", vetted for identity, reviews, and responsiveness"}.`,
      ),
      path: pathname,
    };
    jsonLd = [
      breadcrumbJsonLd(origin, [
        { name: "Home", path: "/" },
        { name: "Categories", path: "/categories" },
        { name: category.name, path: pathname },
      ]),
    ];
  }
}

// --- Static-page JSON-LD -----------------------------------------------------
if (View && ROUTE_SEO[pathname] && jsonLd.length === 0) {
  if (pathname === "/") {
    jsonLd = [webSiteJsonLd(origin), organizationJsonLd(origin)];
  } else {
    const routeSeo = ROUTE_SEO[pathname];
    jsonLd = [
      breadcrumbJsonLd(origin, [
        { name: "Home", path: "/" },
        ...(pathname === "/for-businesses/get-listed" || pathname === "/for-businesses/why-verified"
          ? [
              { name: "For businesses", path: "/for-businesses" },
              { name: routeSeo.crumb ?? routeSeo.title, path: routeSeo.path },
            ]
          : [{ name: routeSeo.crumb ?? routeSeo.title, path: routeSeo.path }]),
      ]),
    ];
  }
}

// Preview mode is never indexable, whatever route resolved.
if (preview && seo && !seo.robots) seo = { ...seo, robots: "noindex, follow" };

if (!View) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const notFoundSeo: PageSeo = {
  title: `Page Not Found · ${SITE_NAME}`,
  description: "This page doesn't exist.",
  path: pathname,
  robots: "noindex, nofollow",
};

const claimProps =
  pathname === "/claim"
    ? { query: (Astro.url.searchParams.get("q") ?? "").slice(0, 80), preview }
    : {};

const previewProps = ["/events", "/deals", "/awards"].includes(pathname) ? { preview } : {};

const removeProps =
  pathname === "/remove-listing"
    ? { biz: (Astro.url.searchParams.get("biz") ?? "").slice(0, 120) }
    : {};

const reviewProps =
  pathname === "/write-review"
    ? {
        biz: (Astro.url.searchParams.get("biz") ?? "").slice(0, 120),
        token: (Astro.url.searchParams.get("token") ?? "").slice(0, 40),
      }
    : {};

const searchProps =
  pathname === "/search"
    ? {
        what: (
          Astro.url.searchParams.get("what") ??
          Astro.url.searchParams.get("q") ??
          ""
        ).slice(0, 100),
        where: Astro.url.searchParams.get("where")?.slice(0, 100) ?? "",
      }
    : {};

const RenderView = View ?? NotFoundView;
---

<SiteLayout seo={seo ?? notFoundSeo} jsonLd={View ? jsonLd : []} preloadImage={preloadImage}>
  <RenderView {...viewProps} {...searchProps} {...claimProps} {...reviewProps} {...previewProps} {...removeProps} />
</SiteLayout>
